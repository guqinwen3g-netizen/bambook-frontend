# Bambook 桌面客户端（Electron + React）环境模板
# 复制为 .env.local 并替换占位值。禁止提交 .env.local。
# 仅 VITE_ 前缀变量会被注入客户端 bundle；密钥请确认打包分发范围可控。

# ─── 数据中心连接（必填）────────────────────────────────────────────
# Mac Mini 主数据 API 基址
VITE_CLOUD_ENDPOINT="https://ops.jiangsupanda.com/bambook/api"
# API Key（与服务端 BAMBOOK_SDK_KEY 对应；客户端请求头 X-Bambook-API-Key）
VITE_BAMBOOK_API_KEY="replace-with-the-same-long-random-token-as-server"
# 知识库 API 基址
VITE_KNOWLEDGE_API_ENDPOINT="https://ops.jiangsupanda.com/bambook/kb"

# ─── 可选覆盖 ───────────────────────────────────────────────────────
# Agent Runtime 直连基址（默认从 VITE_CLOUD_ENDPOINT 推导，一般无需配置）
# VITE_API_BASE_URL=""
# 本地 TTS 服务基址（默认走服务端 Melo 代理，一般无需配置）
# VITE_BAMBOOK_TTS_API_BASE=""
# UI 模式（desktop / mobile-pwa；默认 desktop，由构建脚本注入）
# VITE_UI_MODE=desktop
