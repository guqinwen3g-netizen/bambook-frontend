+import '@bambook/agent-theme';
+// This is the Bambook build: use one canvas and no second in-frame splash.
+document.documentElement.dataset.bambookHost = 'true';
+document.documentElement.dataset.bambookTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+document.getElementById('openbitfun-startup-overlay')?.remove();
+document.title = 'Bambook 助手';
+for (const [kind, type, href] of [
+  ['png', 'image/png', '/brand/bambook-v3-favicon-32.png?v=4'],
+  ['svg', 'image/svg+xml', '/brand/bambook-v3-favicon.svg?v=4'],
+]) {
+  let link = document.querySelector<HTMLLinkElement>(`link[data-bambook-icon="${kind}"]`);
+  if (!link) { link = document.createElement('link'); document.head.append(link); }
+  link.rel = 'icon'; link.type = type; link.href = href; link.dataset.bambookIcon = kind;
+  link.sizes.value = kind === 'png' ? '32x32' : 'any';
+  document.head.append(link); // SVG last: prefer the transparent, light/dark-aware vector.
+}
+document.querySelectorAll('link[rel="icon"]:not([data-bambook-icon])').forEach(link => link.remove());
