@@ -0,0 +1,35 @@
+/** Appearance-only host integration. Never imports account or runtime services. */
+const PARENT_ORIGINS = new Set([
+  'http://localhost:3000', 'http://127.0.0.1:3000',
+  'http://localhost:4173', 'http://127.0.0.1:4173',
+  'null', // Electron's file:// parent; still requires exact parent identity.
+]);
+
+export function installBambookAppearance(target: Window = window): () => void {
+  if (target.parent === target) return () => {};
+  const root = target.document.documentElement;
+  let hostTheme: 'light' | 'dark' | undefined;
+  const apply = () => {
+    if (!hostTheme) return;
+    if (root.dataset.bambookHost !== 'true') root.dataset.bambookHost = 'true';
+    if (root.dataset.bambookTheme !== hostTheme) root.dataset.bambookTheme = hostTheme;
+    if (root.dataset.openbitfunAppearanceMode !== hostTheme) root.dataset.openbitfunAppearanceMode = hostTheme;
+    root.style.colorScheme = hostTheme;
+  };
+  // Upstream appearance initialization can finish after the parent handshake.
+  // Observe only root mode flags, never subtree/content or account state.
+  const observer = new MutationObserver(apply);
+  observer.observe(root, { attributes: true, attributeFilter: ['data-bambook-theme', 'data-openbitfun-appearance-mode'] });
+  const receive = (event: MessageEvent) => {
+    if (event.source !== target.parent || !PARENT_ORIGINS.has(event.origin)) return;
+    const data = event.data;
+    if (!data || data.type !== 'bambook:appearance' || data.version !== 1
+        || (data.theme !== 'light' && data.theme !== 'dark')) return;
+    hostTheme = data.theme;
+    apply();
+  };
+  target.addEventListener('message', receive);
+  // This constant notification carries no application data or authority.
+  target.parent.postMessage({ type: 'bambook:appearance-ready', version: 1 }, '*');
+  return () => { target.removeEventListener('message', receive); observer.disconnect(); };
+}
