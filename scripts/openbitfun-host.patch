+import { describe, expect, it, vi } from 'vitest';
+import { WorkspaceKind, type WorkspaceInfo } from '@/shared/types/global-state';
+import { BAMBOOK_AGENT_MODE, loadBambookHistoryPage, resolveBambookWorkspace } from './bambookProduct';
+const local = (id: string, rootPath = `/projects/${id}`): WorkspaceInfo => ({ id, rootPath, name: id, workspaceKind: WorkspaceKind.Normal });
+describe('Bambook bounded history', () => {
+  const scopes = [{ workspaceId: 'default' }, { workspaceId: 'legacy' }];
+  it('loads only one 30-entry metadata page per action, not all workspace histories', async () => {
+    const load = vi.fn().mockResolvedValue({ hasMore: true, nextCursor: 'next' });
+    expect(await loadBambookHistoryPage(scopes, { scopeIndex: 0 }, load)).toEqual({ scopeIndex: 0, cursor: 'next' });
+    expect(load).toHaveBeenCalledExactlyOnceWith('default', 30, undefined);
+  });
+  it('visits legacy owners separately after finishing the default owner', async () => {
+    const load = vi.fn().mockResolvedValue({ hasMore: false });
+    const next = await loadBambookHistoryPage(scopes, { scopeIndex: 0, cursor: 'next' }, load);
+    expect(next).toEqual({ scopeIndex: 1 });
+    await loadBambookHistoryPage(scopes, next, load);
+    expect(load).toHaveBeenLastCalledWith('legacy', 30, undefined);
+  });
+  it('does not loop on a broken cursor or request after completion', async () => {
+    const load = vi.fn().mockResolvedValue({ hasMore: true, nextCursor: 'same' });
+    await expect(loadBambookHistoryPage(scopes, { scopeIndex: 0, cursor: 'same' }, load)).rejects.toThrow();
+    load.mockClear(); await loadBambookHistoryPage(scopes, { scopeIndex: 2 }, load);
+    expect(load).not.toHaveBeenCalled();
+  });
+});
+
+describe('Bambook implicit workspace policy', () => {
+  it('uses Standard for newly created conversations only', () => expect(BAMBOOK_AGENT_MODE).toBe('Standard'));
+  it('prefers the registered host workspace without renaming or moving owners', () => {
+    const host = local('host', '/Bambook/tmp/openbitfun-workspace');
+    expect(resolveBambookWorkspace([local('older'), host])).toBe(host);
+  });
+  it('recognizes the installed host workspace and Windows separators', () => {
+    const host = local('host', 'C:\\Bambook\\agent-workspace');
+    expect(resolveBambookWorkspace([host, local('older')])).toBe(host);
+  });
+  it('can use the sole registered local workspace', () => {
+    const host = local('only'); expect(resolveBambookWorkspace([host])).toBe(host);
+  });
+  it('fails closed for missing or ambiguous owners', () => {
+    expect(resolveBambookWorkspace([])).toBeNull();
+    expect(resolveBambookWorkspace([local('a'), local('b')])).toBeNull();
+    expect(resolveBambookWorkspace([local('a', '/a/agent-workspace'), local('b', '/b/agent-workspace')])).toBeNull();
+  });
+  it('never chooses an assistant or remote workspace', () => {
+    expect(resolveBambookWorkspace([{ ...local('remote'), workspaceKind: WorkspaceKind.Remote }, { ...local('assistant'), workspaceKind: WorkspaceKind.Assistant }])).toBeNull();
+  });
+});
