+// @vitest-environment jsdom
+import React, { act } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+const mock = vi.hoisted(() => ({
+  workspaces: [{ id: 'host', name: 'Host', rootPath: '/tmp/openbitfun-workspace', workspaceKind: 'normal' }],
+  create: vi.fn(), activate: vi.fn(), open: vi.fn(), scene: vi.fn(), settings: vi.fn(), error: vi.fn(), loading: false,
+}));
+vi.mock('@openbitfun/ui', () => ({
+  Button: ({ children, variant: _, ...props }: any) => <button {...props}>{children}</button>,
+  Icon: () => null,
+  ScrollArea: ({ children }: any) => <div>{children}</div>,
+  NavigationPanelItem: ({ children, leading: _, ...props }: any) => <button {...props}>{children}</button>,
+}));
