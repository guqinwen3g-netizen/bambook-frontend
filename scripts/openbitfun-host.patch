diff --git a/src/crates/interfaces/app-server/src/server/bambook_host.rs b/src/crates/interfaces/app-server/src/server/bambook_host.rs
new file mode 100644
index 0000000..f8d481f
--- /dev/null
+++ b/src/crates/interfaces/app-server/src/server/bambook_host.rs
@@ -0,0 +1,426 @@
+//! Local-only Bambook host compatibility for the existing desktop model UI.
+//! No credentials are imported from another application or returned to Bambook.
+use agent_client_protocol::Error;
+use openbitfun_core::infrastructure::subscription_auth as auth;
+use serde::Deserialize;
+use serde_json::Value;
+
+pub(super) fn supports(method: &str) -> bool {
+    matches!(method, "get_ai_model_catalog" | "get_local_models_dev_catalogs" | "list_ai_models_by_config"
+        | "get_models_dev_catalog_status" | "refresh_models_dev_catalog_now"
+        | "list_subscription_accounts" | "start_subscription_login"
+        | "get_subscription_login_status" | "cancel_subscription_login"
+        | "logout_subscription_account" | "refresh_subscription_account"
+        | "initialize_workspace_startup_state" | "get_current_workspace"
+        | "get_recent_workspaces" | "get_opened_workspaces" | "get_assistant_workspaces"
+        | "get_primary_assistant_workspace" | "list_persisted_sessions_page"
+        | "initialize_mcp_servers" | "initialize_mcp_servers_non_destructive"
+        | "get_available_modes" | "manage_dialog_queue" | "bambook/createSession"
+        | "bambook/updateSessionModel" | "get_session_permission_mode"
+        | "restore_session_view" | "load_persisted_session_metadata" | "ensure_coordinator_session")
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct LoginRequest {
+    provider: auth::SubscriptionProvider,
+    session_id: String,
+    #[serde(default)]
+    method: Option<auth::SubscriptionLoginMethod>,
+}
+#[derive(Deserialize)]
+struct ProviderRequest { provider: auth::SubscriptionProvider }
+
+fn encode(value: impl serde::Serialize) -> Result<Value, Error> {
+    serde_json::to_value(value).map_err(|_| Error::internal_error())
+}
+fn failure(_: impl std::fmt::Display) -> Error {
+    // Provider responses can contain sensitive details; do not echo them.
+    Error::internal_error().data(serde_json::json!({"reason": "host_operation_failed"}))
+}
+async fn http_options() -> Result<auth::SubscriptionHttpOptions, Error> {
+    let service = openbitfun_core::service::config::get_global_config_service().await.map_err(failure)?;
+    let config: openbitfun_core::service::config::GlobalConfig = service.get_config(None).await.map_err(failure)?;
+    Ok(auth::SubscriptionHttpOptions::new(config.ai.proxy.enabled.then_some(config.ai.proxy), false))
+}
+
+#[derive(Deserialize)]
+struct ModelDiscoveryRequest {
+    config: openbitfun_core::service::config::types::AIModelConfig,
+}
+
+async fn discover_models(body: Value) -> Result<Value, Error> {
+    use openbitfun_core::infrastructure::ai::{client_factory, AIClient};
+    let request: ModelDiscoveryRequest = serde_json::from_value(body)
+        .map_err(|_| Error::invalid_params())?;
+    // Same transient client contract as desktop; never persist discovery drafts
+    // or expose the subscription credential resolved by the shared owner.
+    let operation = async {
+        let service = openbitfun_core::service::config::get_global_config_service().await.map_err(failure)?;
+        let global: openbitfun_core::service::config::GlobalConfig = service.get_config(None).await.map_err(failure)?;
+        let stream = openbitfun_core::infrastructure::ai::build_stream_options_for_model(&global.ai, Some(&request.config));
+        let identity = request.config.auth.clone();
+        let mut config: openbitfun_core::util::types::AIConfig = request.config.try_into().map_err(failure)?;
+        let proxy = global.ai.proxy.enabled.then_some(global.ai.proxy);
+        let options = auth::SubscriptionHttpOptions::new(proxy.clone(), config.skip_ssl_verify);
+        client_factory::apply_subscription_auth_with_options(&identity, &mut config, &options).await.map_err(failure)?;
+        let client = client_factory::apply_subscription_request_profile(&identity,
+            AIClient::new_with_runtime_options(config, proxy, stream));
+        encode(client.list_models().await.map_err(|_| Error::internal_error()
+            .data(serde_json::json!({"reason": "model_discovery_failed"})))?)
+    };
+    tokio::time::timeout(std::time::Duration::from_secs(30), operation).await
+        .map_err(|_| Error::internal_error().data(serde_json::json!({"reason": "model_discovery_timeout"})))?
+}
+
+fn workspace_dto(info: openbitfun_core::service::workspace::WorkspaceInfo) -> Result<Value, Error> {
+    use openbitfun_core::service::workspace::{WorkspaceKind, WorkspaceType};
+    let kind = match info.workspace_kind {
+        WorkspaceKind::Normal => "normal",
+        WorkspaceKind::Assistant => "assistant",
+        WorkspaceKind::Remote => "remote",
+    };
+    let workspace_type = if info.workspace_type == WorkspaceType::Other { "other" } else { "singleProject" };
+    let mut value = encode(&info)?;
+    value["workspaceKind"] = Value::from(kind);
+    value["workspaceType"] = Value::from(workspace_type);
+    // Persistence metadata is not part of the desktop presentation contract.
+    value.as_object_mut().unwrap().remove("metadata");
+    Ok(value)
+}
+fn workspace_list(items: Vec<openbitfun_core::service::workspace::WorkspaceInfo>) -> Result<Value, Error> {
+    items.into_iter().map(workspace_dto).collect::<Result<Vec<_>, _>>().map(Value::Array)
+}
+async fn workspace_read(method: &str) -> Result<Value, Error> {
+    let service = openbitfun_core::service::workspace::get_global_workspace_service()
+        .ok_or_else(Error::internal_error)?;
+    let current = async { service.get_current_workspace().await.map(workspace_dto).transpose().map(|v| v.unwrap_or(Value::Null)) };
+    match method {
+        "get_current_workspace" => current.await,
+        "get_recent_workspaces" => workspace_list(service.get_recent_workspaces().await),
+        "get_opened_workspaces" => workspace_list(service.get_opened_workspaces().await),
+        "get_assistant_workspaces" => workspace_list(service.get_assistant_workspaces().await),
+        "get_primary_assistant_workspace" => service.get_primary_assistant_workspace().await.map(workspace_dto).transpose().map(|v| v.unwrap_or(Value::Null)),
+        "initialize_workspace_startup_state" => Ok(serde_json::json!({
+            "cleanupRemovedCount": 0,
+            "currentWorkspace": current.await?,
+            "recentWorkspaces": workspace_list(service.get_recent_workspaces().await)?,
+            "openedWorkspaces": workspace_list(service.get_opened_workspaces().await)?,
+            "assistantWorkspaces": workspace_list(service.get_assistant_workspaces().await)?,
+            "primaryAssistantWorkspaceId": service.get_primary_assistant_workspace().await.map(|v| v.id),
+            "legacyRemoteWorkspace": null
+        })),
+        _ => Err(Error::method_not_found()),
+    }
+}
+
+#[derive(Deserialize)]
+struct SessionPageRequest {
+    workspace_id: String,
+    limit: usize,
+    cursor: Option<String>,
+    session_ids: Option<Vec<String>>,
+}
+pub(super) async fn session_page(runtime: &crate::agent::OpenBitFunAppRuntime, params: Value) -> Result<Value, Error> {
+    let request: SessionPageRequest = serde_json::from_value(params.get("request").unwrap_or(&params).clone())
+        .map_err(|_| Error::invalid_params())?;
+    if request.limit == 0 || request.limit > 128 { return Err(Error::invalid_params()); }
+    let service = openbitfun_core::service::workspace::get_global_workspace_service().ok_or_else(Error::internal_error)?;
+    let workspace = service.require_workspace(&request.workspace_id).await.map_err(failure)?;
+    if workspace.workspace_kind == openbitfun_core::service::workspace::WorkspaceKind::Remote {
+        return Err(Error::invalid_params());
+    }
+    let owner = runtime.bambook_compatibility.as_ref().ok_or_else(Error::internal_error)?;
+    let mut page = owner.list_persisted_sessions_page_with_activity(runtime.runtime(), &workspace.root_path,
+        request.cursor.as_deref(), request.limit, request.session_ids.as_deref()).await.map_err(failure)?;
+    for session in &mut page.sessions { session.workspace_id.get_or_insert_with(|| workspace.id.clone()); }
+    encode(page)
+}
+
+#[derive(Default, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct ModeRequest {
+    workspace_id: Option<String>,
+    workspace_path: Option<String>,
+}
+
+async fn available_modes(body: Value) -> Result<Value, Error> {
+    let request: ModeRequest = serde_json::from_value(body).map_err(|_| Error::invalid_params())?;
+    let service = openbitfun_core::service::workspace::get_global_workspace_service().ok_or_else(Error::internal_error)?;
+    let has_scope = request.workspace_id.is_some() || request.workspace_path.is_some();
+    let workspace = service.resolve_legacy_workspace_reference(request.workspace_id.as_deref(),
+        request.workspace_path.as_deref().unwrap_or_default(), None, None).await.map_err(failure)?;
+    if has_scope && workspace.is_none() { return Err(Error::invalid_params()); }
+    if workspace.as_ref().is_some_and(|w| w.workspace_kind == openbitfun_core::service::workspace::WorkspaceKind::Remote) {
+        return Err(Error::invalid_params());
+    }
+    // The local registry owns builtin/custom modes. Do not advertise external
+    // plugin routes before their activation lifecycle is supported by this host.
+    let modes = openbitfun_core::agentic::agents::get_agent_registry()
+        .get_modes_info_for_workspace(workspace.as_ref().map(|w| w.id.as_str()), false).await;
+    let mut values = Vec::with_capacity(modes.len());
+    for mode in modes {
+        let profile = mode.config_profile_id.clone().unwrap_or_else(|| mode.id.clone());
+        let mut value = encode(mode)?;
+        value["configProfileId"] = Value::from(profile);
+        values.push(value);
+    }
+    Ok(Value::Array(values))
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct SessionReadRequest {
+    #[serde(alias = "session_id")]
+    session_id: String,
+    #[serde(alias = "workspace_id")]
+    workspace_id: String,
+    #[serde(alias = "remote_connection_id")]
+    remote_connection_id: Option<String>,
+    #[serde(alias = "remote_ssh_host")]
+    remote_ssh_host: Option<String>,
+    #[serde(alias = "tail_turn_count")]
+    tail_turn_count: Option<usize>,
+    #[serde(default, alias = "include_internal")]
+    include_internal: bool,
+}
+
+pub(super) async fn session_read(runtime: &crate::agent::OpenBitFunAppRuntime, method: &str, params: Value) -> Result<Value, Error> {
+    let request: SessionReadRequest = serde_json::from_value(
+        params.get("request").unwrap_or(&params).clone()).map_err(|_| Error::invalid_params())?;
+    // Resolve only registered local workspace identities. Never trust a path
+    // supplied by a browser, and never silently fall back from a remote scope.
+    if request.remote_connection_id.is_some() || request.remote_ssh_host.is_some() {
+        return Err(Error::invalid_params());
+    }
+    let service = openbitfun_core::service::workspace::get_global_workspace_service().ok_or_else(Error::internal_error)?;
+    let workspace = service.require_workspace(&request.workspace_id).await.map_err(failure)?;
+    if workspace.workspace_kind == openbitfun_core::service::workspace::WorkspaceKind::Remote {
+        return Err(Error::invalid_params());
+    }
+    let owner = runtime.bambook_compatibility.as_ref().ok_or_else(Error::internal_error)?;
+    let scope = openbitfun_runtime_ports::SessionStoragePathRequest {
+        workspace_path: workspace.root_path.clone(), remote_connection_id: None, remote_ssh_host: None,
+    };
+    owner.ensure_workspace_runtime_ownership(&scope).map_err(failure)?;
+    if method == "ensure_coordinator_session" {
+        // Same readiness owner as desktop: reuse a loaded session, or restore
+        // its persisted context. Never recreate it or reset earlier turns.
+        let storage_path = owner.resolve_persisted_session_storage_path(scope).await.map_err(failure)?;
+        owner.ensure_session_loaded_from_storage_path(
+            &storage_path, &request.session_id, request.include_internal,
+        ).await.map_err(failure)?;
+        return Ok(Value::Null);
+    }
+    if method == "load_persisted_session_metadata" {
+        return encode(owner.load_persisted_session_metadata(&workspace.root_path, &request.session_id).await.map_err(failure)?);
+    }
+    let tail = request.tail_turn_count.unwrap_or(16).clamp(1, 16);
+    let (mut session, turns, total, catalog, timings) = owner.restore_session_view_for_workspace(
+        scope, &request.session_id, false, Some(tail)).await.map_err(failure)?;
+    if let Some(live) = owner.loaded_session_snapshot(&request.session_id).map_err(failure)? {
+        session.state = live.state;
+    }
+    let context_usage = owner.load_persisted_session_metadata(&workspace.root_path, &request.session_id)
+        .await.map_err(failure)?.and_then(|metadata| metadata.current_context_usage);
+    let snapshot = runtime.runtime().session_event_projection_snapshot(&request.session_id).map(|snapshot| {
+        let events: Vec<Value> = snapshot.events.into_iter()
+            .filter_map(openbitfun_events::project_agentic_frontend_event)
+            .map(|event| serde_json::json!({"eventName": event.event_name, "payload": event.payload})).collect();
+        serde_json::json!({"sessionId": snapshot.session_id, "streamId": snapshot.stream_id,
+            "cursor": snapshot.cursor, "activeTurnId": snapshot.active_turn_id, "events": events})
+    });
+    let loaded = turns.len();
+    Ok(serde_json::json!({
+        "session": {
+            "sessionId": session.session_id, "sessionName": session.session_name,
+            "agentType": session.agent_type, "modelName": session.config.model_id,
+            "reasoningPreset": session.config.reasoning_preset,
+            "lastUserDialogAgentType": session.last_user_dialog_agent_type,
+            "lastSubmittedAgentType": session.last_submitted_agent_type,
+            "state": format!("{:?}", session.state), "turnCount": total,
+            "createdAt": session.created_at.duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_secs(),
+        },
+        "turns": turns,
+        "interactionSnapshot": runtime.runtime().session_interaction_snapshot(&request.session_id),
+        "runtimeEventSnapshot": snapshot, "currentContextUsage": context_usage,
+        "turnCatalog": catalog, "contextRestoreState": "pending",
+        "isPartial": loaded < total, "loadedTurnCount": loaded, "totalTurnCount": total,
+        "timings": timings,
+    }))
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct LocalSessionRequest {
+    session_id: Option<String>,
+    config: Option<Value>,
+    #[serde(flatten)]
+    request: openbitfun_runtime_ports::AgentSessionCreateRequest,
+}
+
+pub(super) async fn create_session(runtime: &crate::agent::OpenBitFunAppRuntime, params: Value) -> Result<Value, Error> {
+    let mut request: LocalSessionRequest = serde_json::from_value(
+        params.get("request").unwrap_or(&params).clone()).map_err(|_| Error::invalid_params())?;
+    if request.request.model_id.is_none() {
+        request.request.model_id = request.config.as_ref().and_then(|v| v.get("modelName"))
+            .and_then(Value::as_str).filter(|s| !s.trim().is_empty()).map(str::to_owned);
+    }
+    let result = match request.session_id {
+        Some(id) if id.trim().is_empty() => return Err(Error::invalid_params()),
+        Some(id) => runtime.runtime().create_session_with_id(id, request.request).await,
+        None => runtime.runtime().create_session(request.request).await,
+    };
+    encode(result.map_err(failure)?)
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct ModelSelectionRequest {
+    session_id: String,
+    model_name: String,
+    reasoning_preset: Option<String>,
+}
+
+pub(super) async fn update_model(runtime: &crate::agent::OpenBitFunAppRuntime, params: Value) -> Result<Value, Error> {
+    use openbitfun_runtime_ports::{AgentSessionModelSelection, AgentSessionModelSelectionUpdateRequest, AgentSessionModelUpdateRequest};
+    let body = params.get("request").unwrap_or(&params);
+    let request: ModelSelectionRequest = serde_json::from_value(body.clone()).map_err(|_| Error::invalid_params())?;
+    if body.get("reasoningPreset").is_some() {
+        runtime.runtime().update_session_model_selection(AgentSessionModelSelectionUpdateRequest {
+            session_id: request.session_id,
+            selection: AgentSessionModelSelection { model_id: request.model_name, reasoning_preset: request.reasoning_preset },
+        }).await.map_err(failure)?;
+    } else {
+        runtime.runtime().update_session_model(AgentSessionModelUpdateRequest {
+            session_id: request.session_id, model_id: request.model_name,
+        }).await.map_err(failure)?;
+    }
+    Ok(Value::Null)
+}
+
+pub(super) async fn dialog_queue(runtime: &crate::agent::OpenBitFunAppRuntime, params: Value) -> Result<Value, Error> {
+    let request: openbitfun_runtime_ports::DialogQueueRequest = serde_json::from_value(
+        params.get("request").unwrap_or(&params).clone()).map_err(|_| Error::invalid_params())?;
+    // Delegate epoch fencing, idempotency, attachments and execution to the same
+    // AgentRuntime owner used by Desktop. Never emulate a successful queue receipt.
+    encode(runtime.runtime().manage_dialog_queue(request).await.map_err(failure)?)
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct PermissionModeRequest { session_id: String, turn_id: Option<String> }
+
+fn permission_mode(body: Value) -> Result<Value, Error> {
+    use openbitfun_core::agentic::core::SessionState;
+    let request: PermissionModeRequest = serde_json::from_value(body).map_err(|_| Error::invalid_params())?;
+    let owner = openbitfun_core::agentic::coordination::get_global_coordinator().ok_or_else(Error::internal_error)?;
+    let manager = owner.get_session_manager();
+    let session = manager.get_session(&request.session_id).ok_or_else(Error::invalid_params)?;
+    let active = request.turn_id.filter(|turn_id| matches!(&session.state,
+        SessionState::Processing { current_turn_id, .. } if current_turn_id == turn_id));
+    Ok(serde_json::json!({
+        "mode": manager.session_permission_mode(&request.session_id),
+        "turnMode": active.as_deref().and_then(|id| manager.active_turn_permission_mode(&request.session_id, id)),
+        "activeTurnId": active,
+    }))
+}
+
+pub(super) async fn handle(method: &str, params: Value) -> Result<Value, Error> {
+    let body = params.get("request").unwrap_or(&params).clone();
+    match method {
+        "get_available_modes" => available_modes(body).await,
+        "get_session_permission_mode" => permission_mode(body),
+        "initialize_workspace_startup_state" | "get_current_workspace" | "get_recent_workspaces"
+        | "get_opened_workspaces" | "get_assistant_workspaces" | "get_primary_assistant_workspace" => workspace_read(method).await,
+        "initialize_mcp_servers" | "initialize_mcp_servers_non_destructive" => {
+            let service = openbitfun_core::service::mcp::get_global_mcp_service().ok_or_else(Error::internal_error)?;
+            service.server_manager().initialize_non_destructive().await.map_err(failure)?;
+            Ok(Value::Null)
+        }
+        "list_ai_models_by_config" => discover_models(body).await,
+        "get_ai_model_catalog" => encode(openbitfun_core::get_remote_model_catalog().await.map_err(failure)?),
+        "get_local_models_dev_catalogs" => encode(openbitfun_core::get_local_models_dev_catalogs().await.map_err(failure)?),
+        "get_models_dev_catalog_status" => encode(openbitfun_core::get_models_dev_catalog_status().await),
+        "refresh_models_dev_catalog_now" => encode(openbitfun_core::refresh_models_dev_catalog_now().await.map_err(failure)?),
+        "list_subscription_accounts" => encode(auth::list_accounts().await),
+        "start_subscription_login" | "get_subscription_login_status" | "cancel_subscription_login" => {
+            let request: LoginRequest = serde_json::from_value(body).map_err(|_| Error::invalid_params())?;
+            match method {
+                "start_subscription_login" => encode(auth::start_login_with_method_and_options(request.provider, request.session_id, request.method, http_options().await?).await.map_err(failure)?),
+                "get_subscription_login_status" => encode(auth::login_status(request.provider, &request.session_id).await.map_err(failure)?),
+                _ => { auth::cancel_login(request.provider, &request.session_id).await.map_err(failure)?; Ok(Value::Null) }
+            }
+        }
+        "logout_subscription_account" | "refresh_subscription_account" => {
+            let request: ProviderRequest = serde_json::from_value(body).map_err(|_| Error::invalid_params())?;
+            if method == "logout_subscription_account" { encode(auth::logout(request.provider).await.map_err(failure)?) }
+            else { encode(auth::refresh_account_with_options(request.provider, &http_options().await?).await.map_err(failure)?) }
+        }
+        _ => Err(Error::method_not_found()),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn narrow_host_surface() {
+        assert!(supports("start_subscription_login"));
+        assert!(!supports("exec"));
+        assert!(!supports("read_credentials"));
+    }
+    #[test]
+    fn workspace_read_surface_and_page_contract_are_explicit() {
+        assert!(supports("initialize_workspace_startup_state"));
+        assert!(supports("list_persisted_sessions_page"));
+        assert!(supports("get_available_modes"));
+        assert!(supports("manage_dialog_queue"));
+        assert!(!supports("open_remote_workspace"));
+        assert!(serde_json::from_value::<SessionPageRequest>(serde_json::json!({"workspace_path":"/arbitrary", "limit":10})).is_err());
+        let request: SessionPageRequest = serde_json::from_value(serde_json::json!({"workspace_id":"local", "limit":10})).unwrap();
+        assert_eq!(request.workspace_id, "local");
+        assert!(request.session_ids.is_none());
+    }
+    #[test]
+    fn session_reads_require_registered_identity_not_browser_paths() {
+        assert!(supports("restore_session_view"));
+        assert!(supports("load_persisted_session_metadata"));
+        assert!(supports("ensure_coordinator_session"));
+        assert!(serde_json::from_value::<SessionReadRequest>(serde_json::json!({
+            "sessionId": "session", "workspacePath": "/arbitrary"
+        })).is_err());
+        for value in [
+            serde_json::json!({"sessionId": "session", "workspaceId": "workspace"}),
+            serde_json::json!({"session_id": "session", "workspace_id": "workspace"}),
+        ] {
+            let request: SessionReadRequest = serde_json::from_value(value).unwrap();
+            assert_eq!(request.workspace_id, "workspace");
+            assert!(request.remote_connection_id.is_none());
+            assert!(!request.include_internal);
+        }
+        let internal: SessionReadRequest = serde_json::from_value(serde_json::json!({
+            "sessionId": "session", "workspaceId": "workspace", "includeInternal": true
+        })).unwrap();
+        assert!(internal.include_internal);
+    }
+    #[tokio::test]
+    async fn model_discovery_requires_a_config_not_a_saved_pool_request() {
+        assert!(supports("list_ai_models_by_config"));
+        for body in [Value::Null, serde_json::json!({"request": {}}),
+            serde_json::json!({"request": {"config": {"auth": {"type": "subscription", "provider": "invalid"}}}})] {
+            let error = handle("list_ai_models_by_config", body).await.unwrap_err();
+            assert_eq!(error.code, Error::invalid_params().code);
+        }
+    }
+    #[test]
+    fn errors_do_not_expose_provider_details() {
+        let error = encode(failure("dummy-sensitive-provider-response")).unwrap();
+        assert!(!error.to_string().contains("dummy-sensitive-provider-response"));
+    }
+    #[tokio::test]
+    async fn login_requires_a_typed_request() {
+        assert!(handle("start_subscription_login", serde_json::json!({})).await.is_err());
+        assert!(handle("exec", Value::Null).await.is_err());
+    }
+}
