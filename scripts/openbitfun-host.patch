@@ -0,0 +1,33 @@
+import type { WorkspaceInfo } from '@/shared/types/global-state';
+
+/** This checkout is the Bambook product surface, not the upstream general-purpose IDE. */
+export const BAMBOOK_PRODUCT = true;
+export const BAMBOOK_AGENT_MODE = 'Standard' as const;
+export const BAMBOOK_MODEL_SETTINGS = 'ai.models' as const;
+export const BAMBOOK_HISTORY_PAGE_SIZE = 30;
+
+export interface BambookHistoryPosition { scopeIndex: number; cursor?: string }
+
+/** One bounded request per user action; never walk every page at startup. */
+export async function loadBambookHistoryPage(
+  scopes: readonly { workspaceId: string }[],
+  position: BambookHistoryPosition,
+  load: (workspaceId: string, limit: number, cursor?: string) => Promise<{ hasMore: boolean; nextCursor?: string | null }>,
+): Promise<BambookHistoryPosition> {
+  const scope = scopes[position.scopeIndex];
+  if (!scope) return position;
+  const page = await load(scope.workspaceId, BAMBOOK_HISTORY_PAGE_SIZE, position.cursor);
+  if (page.hasMore) {
+    if (!page.nextCursor || page.nextCursor === position.cursor) throw new Error('Bambook history cursor did not advance');
+    return { scopeIndex: position.scopeIndex, cursor: page.nextCursor };
+  }
+  return { scopeIndex: position.scopeIndex + 1 };
+}
+
+/** Resolve an existing local owner; never invent an ID, open a directory, or rebind history. */
+export function resolveBambookWorkspace(workspaces: readonly WorkspaceInfo[]): WorkspaceInfo | null {
+  const local = workspaces.filter(workspace => workspace.workspaceKind !== 'remote' && workspace.workspaceKind !== 'assistant');
+  const configured = local.filter(workspace => /(?:^|\/)(?:openbitfun-workspace|agent-workspace)\/?$/.test(workspace.rootPath.replace(/\\/g, '/')));
+  if (configured.length === 1) return configured[0];
+  return local.length === 1 ? local[0] : null;
+}
