+import { useMemo, useState } from 'react';
+import { useI18n } from '@/infrastructure/i18n';
+import { Button, Icon, NavigationPanelItem, ScrollArea } from '@openbitfun/ui';
+import { useWorkspaceContext } from '@/infrastructure/contexts/WorkspaceContext';
+import { isRemoteWorkspace } from '@/shared/types';
+import { BAMBOOK_AGENT_MODE, BAMBOOK_MODEL_SETTINGS, resolveBambookWorkspace } from '@/bambookProduct';
+import { flowChatManager } from '@/flow_chat/services/FlowChatManager';
+import { openMainSession } from '@/flow_chat/services/sessionActivation';
+import { flowChatSessionConfigForWorkspace } from '@/app/utils/projectSessionWorkspace';
+import { notificationService } from '@/shared/notification-system';
+import { useSceneManager } from '@/app/hooks/useSceneManager';
+import { useSettingsStore } from '@/app/scenes/settings/settingsStore';
+import SessionsSection from './sections/sessions/SessionsSection';
+
+export async function createBambookConversation(workspace: NonNullable<ReturnType<typeof resolveBambookWorkspace>>, activateWorkspace: (id: string) => Promise<unknown>) {
+  const id = await flowChatManager.createChatDraft(flowChatSessionConfigForWorkspace(workspace), BAMBOOK_AGENT_MODE);
+  await openMainSession(id, { workspaceId: workspace.id, activateWorkspace });
+  return id;
+}
+
+export default function BambookNav() {
+  const { t } = useI18n('common');
+  const { openedWorkspacesList, loading, setActiveWorkspace } = useWorkspaceContext();
+  const workspace = resolveBambookWorkspace(openedWorkspacesList);
+  const scopes = useMemo(() => openedWorkspacesList.filter(item => !isRemoteWorkspace(item))
+    .sort((a, b) => Number(b.id === workspace?.id) - Number(a.id === workspace?.id))
+    .map(item => ({ workspaceId: item.id, workspaceName: item.name })), [openedWorkspacesList, workspace?.id]);
+  const [creating, setCreating] = useState(false);
+  const { openScene } = useSceneManager();
+  const create = async () => {
+    if (!workspace || creating) return;
+    setCreating(true);
+    try { await createBambookConversation(workspace, setActiveWorkspace); }
+    catch (error) { notificationService.error(error instanceof Error ? error.message : t('bambook.createFailed')); }
+    finally { setCreating(false); }
+  };
+  return <div className="bambook-agent-nav" data-testid="bambook-agent-nav">
+    <Button variant="primary" disabled={loading || !workspace || creating} onClick={() => void create()} data-testid="bambook-new-conversation">
+      <Icon name="plus" size="sm" />{creating ? t('bambook.creating') : t('bambook.newConversation')}
+    </Button>
+    {!loading && !workspace && <p role="alert">{t('bambook.notReady')}</p>}
+    <div className="bambook-agent-nav__label">{t('bambook.history')}</div>
+    <ScrollArea className="bambook-agent-nav__history" edgeFade="vertical">
+      {scopes.length > 0 && <SessionsSection workspaceId={workspace?.id} workspacePath={workspace?.rootPath} workspaceScopes={scopes} layout="flat" compactProduct />}
+    </ScrollArea>
+    <div className="bambook-agent-nav__footer">
+      <NavigationPanelItem leading={<Icon name="settings" size="sm" />} onClick={() => { useSettingsStore.getState().openPage(BAMBOOK_MODEL_SETTINGS); openScene('settings'); }} data-testid="bambook-model-settings">{t('bambook.models')}</NavigationPanelItem>
+      <NavigationPanelItem leading={<Icon name="info" size="sm" />} onClick={() => window.dispatchEvent(new Event('nav:show-about'))} data-testid="bambook-about">{t('bambook.about')}</NavigationPanelItem>
+    </div>
+  </div>;
+}
