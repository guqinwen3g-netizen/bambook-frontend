{
  "name": "bambook-intelligent-hub",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev:stack": "bash scripts/dev-stack.sh",
    "dev:agent-local": "bash scripts/agent-local-stack.sh web",
    "dev": "npm run dev:mist",
    "dev:web": "vite",
    "dev:mist": "node scripts/mist-dev.mjs",
    "dev:mist:ui": "vite --config vite.mist.config.ts",
    "mist:ref": "vite --config dev-ui-preview/mist-atelier/app/vite.config.ts --port 3131 --strictPort",
    "mist:ref:build": "node dev-ui-preview/mist-atelier/app/build-single.mjs",
    "mist:check": "node scripts/check-mist.mjs",
    "mist:docs": "node scripts/gen-mist-docs.mjs",
    "mist:shots": "node scripts/mist-shots.mjs",
    "mist:overflow": "node scripts/mist-overflow/scan.mjs",
    "mist:overflow:quick": "node scripts/mist-overflow/scan.mjs --quick",
    "dev:desktop": "VITE_UI_MODE=desktop vite --port 3000",
    "build": "vite build",
    "build:desktop": "VITE_UI_MODE=desktop vite build",
    "scan:html-injection": "node scripts/scan-unescaped-interpolation.mjs",
    "check:exporter-profile": "node scripts/check-exporter-profile-consistency.mjs",
    "check:bundle-secret": "node scripts/check-bundle-secret-leak.mjs",
    "check:migration": "node scripts/check-migration.mjs",
    "preview": "vite preview",
    "electron:dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "electron:agent-local": "bash scripts/agent-local-stack.sh electron",
    "electron:build": "electron-vite build",
    "electron:dist": "electron-vite build && electron-builder --mac --publish never",
    "electron:preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "electron:start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "electron:rebuild:native": "node node_modules/@electron/rebuild/lib/cli.js -f --only better-sqlite3",
    "notify": "./scripts/bark_notify.sh",
    "restart:dev": "./scripts/restart_dev.sh",
    "reload": "bash scripts/reload-electron.sh",
    "agent:status": "node scripts/agent-runtime-status.mjs",
    "openbitfun:prepare": "node scripts/prepare-openbitfun.mjs",
    "openbitfun:start": "node scripts/start-openbitfun.mjs",
    "deploy:web": "bash scripts/ops-upload-webapp.sh",
    "deploy:web:light": "BAMBOOK_WEB_LIGHT=1 bash scripts/ops-upload-webapp.sh",
    "deploy:web:subdomain": "BAMBOOK_WEB_SUBDOMAIN=1 bash scripts/ops-upload-webapp.sh",
    "deploy:web:subdomain:light": "BAMBOOK_WEB_SUBDOMAIN=1 BAMBOOK_WEB_LIGHT=1 bash scripts/ops-upload-webapp.sh",
    "deploy:server": "bash scripts/ops-upload-package.sh",
    "deploy:all": "npm run deploy:server && npm run deploy:web",
    "test": "vitest run dev-ui-preview/mist-atelier/app components/mist electron/assistant",
    "test:mist:tooling": "vitest run scripts/mist-version.test.ts",
    "test:mist:server": "npm --prefix server run test:mist",
    "test:access:server": "npm --prefix server run test:access",
    "typecheck:mist": "tsc -p tsconfig.mist.json && tsc -p tsconfig.assistant.json",
    "typecheck:mist:server": "npm --prefix server run typecheck:mist",
    "verify:mist": "npm run typecheck:mist && npm run typecheck:mist:server && npm test && npm run test:mist:server && npm run test:access:server && npm run test:mist:tooling && npm run build && npm run mist:check"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.18",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/urbanist": "^5.2.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.182.0",
    "ai": "^6.0.49",
    "axios": "^1.13.3",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.29.0",
    "harmonyos-sans-sc-webfont-splitted": "^1.1.0",
    "liquid-gooey": "0.2.2",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^5.24.0",
    "mermaid": "^11.15.0",
    "openai": "^6.16.0",
    "pdf-parse": "^2.4.5",
    "pmtiles": "^4.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-virtuoso": "^4.18.1",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx": "^1.13.2",
    "three": "^0.182.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jimp": "^1.6.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.bambook.desktop",
    "productName": "Bambook",
    "mac": {
      "icon": "build/bambook-v3.icns"
    },
    "win": {
      "icon": "build/bambook-v3.ico"
    },
    "linux": {
      "icon": "build/bambook-v3.png"
    },
    "directories": {
      "output": "dist-electron"
    },
    "extraResources": [
      {
        "from": "models/stt/paraformer-zh-en-int8",
        "to": "models/stt/paraformer-zh-en-int8"
      },
      {
        "from": "tmp/openbitfun-runtime",
        "to": "openbitfun"
      },
      {
        "from": "build/bambook-v3.png",
        "to": "brand/bambook-v3.png"
      }
    ],
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/sherpa-onnx/**/*"
    ]
  }
}
