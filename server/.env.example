# Bambook 主数据 API（Mac Mini 数据中心）环境模板
# 复制为 .env.local 并替换占位值。禁止提交 .env / .env.local。
# 分组按域组织；标注「必填」的键缺失会导致启动失败或核心链路不可用。

# ─── 核心 ───────────────────────────────────────────────────────────
# 必填：PostgreSQL 业务主库
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/panda_hub?schema=public"
PORT=8081
NODE_ENV=production
LOG_LEVEL=info

# 必填：公开部署必须开启认证
BAMBOOK_REQUIRE_AUTH=true
# API Key 认证令牌（客户端 X-Bambook-API-Key 头；长随机串）
BAMBOOK_SDK_KEY="replace-with-a-long-random-token"
# 等价别名（src 同时识别，二者取其一即可）
# BAMBOOK_API_KEY=""
# 会话 JWT 签名密钥（生产必填，长随机串）
JWT_SECRET="replace-with-a-long-random-secret"
# 注册是否需要邮箱验证（默认 false）
AUTH_REQUIRE_EMAIL_VERIFY=false

# ─── Agent 服务主体（API Key 认证的 Agent 调用）─────────────────────
# 不配置时 API Key 认证的 Agent 调用将被拒绝（AI Runtime 返回 UNAUTHORIZED）
# actor_id 必须对应 UserAccount 表中存在的用户 ID
BAMBOOK_AGENT_API_KEY_ACTOR_ID="replace-with-user-id-from-UserAccount"
BAMBOOK_AGENT_API_KEY_ROLES="agent_operator"
BAMBOOK_AGENT_API_KEY_DISPLAY_NAME="Bambook API Service"
BAMBOOK_AGENT_API_KEY_DEPARTMENTS="company"
# Agent 回调查询业务数据的内部通道（默认指向本机）
# BAMBOOK_AGENT_DATA_API_BASE="http://127.0.0.1:8081"
# BAMBOOK_AGENT_DATA_API_KEY=""
# Agent 循环开关（默认开启；设 false 关闭 agentLoop）
# BAMBOOK_AGENT_LOOP=true

# ─── LLM 网关 ───────────────────────────────────────────────────────
# 主对话模型（火山引擎 Ark，Coding Plan）
ARK_API_KEY="replace-with-ark-api-key"
BAMBOOK_MODEL_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
BAMBOOK_MODEL_NAME="replace-with-model-endpoint-id"
# 可选备用 provider
# ZHIPU_API_KEY=""
# VOLCENGINE_API_KEY=""
# TENCENT_API_KEY=""
# 视觉模型（图片理解，可选）
# BAMBOOK_VISION_API_KEY=""
# BAMBOOK_VISION_BASE_URL=""
# BAMBOOK_VISION_MODEL_NAME=""
# AI 并发上限（可选，有默认值）
# BAMBOOK_AI_MODEL_CONCURRENCY=4
# BAMBOOK_AI_HEAVY_CONCURRENCY=2
# BAMBOOK_AI_SEARCH_CONCURRENCY=2

# ─── 知识库 / RAG ───────────────────────────────────────────────────
# 知识库服务（knowledge_api）连接
BAMBOOK_KNOWLEDGE_API_KEY="replace-with-knowledge-api-key"
BAMBOOK_KNOWLEDGE_BASE_URL="http://127.0.0.1:8800"
BAMBOOK_KNOWLEDGE_PROJECT="bambook"
BAMBOOK_KNOWLEDGE_COLLECTIONS="default"
BAMBOOK_KNOWLEDGE_DEFAULT_COLLECTION="default"
# 对外公开基址（生成分享链接用，可选）
# BAMBOOK_KNOWLEDGE_PUBLIC_BASE_URL=""
# 检索上下文注入上限（可选，有默认值）
# BAMBOOK_KNOWLEDGE_CONTEXT_LIMIT=6
# BAMBOOK_KNOWLEDGE_LIMIT=8
# BAMBOOK_KNOWLEDGE_UPLOAD_MAX_BYTES=52428800
# RAG 直连（可选，与 knowledge 服务二选一或并用）
# BAMBOOK_RAG_BASE_URL=""
# BAMBOOK_RAG_API_KEY=""

# ─── TTS（Melo，默认 provider）──────────────────────────────────────
BAMBOOK_TTS_PROVIDER=melo
# 必填：主 API 调 Melo 服务的 HTTP 入口（缺失则 getMeloServiceUrl() 直接 throw）
BAMBOOK_MELO_URL=http://127.0.0.1:8765
BAMBOOK_MELO_HOST=127.0.0.1
BAMBOOK_MELO_PORT=8765
# Melo 服务自身依赖的 Python（必须是持久路径，禁止 /tmp/*）
# 由 ops-setup-melo-tts.sh / ops-panel「安装 Melo」自动生成
BAMBOOK_MELO_PYTHON=/Users/panda1/bambook-main-api/.venv-melo/bin/python
# 主 API → Melo 单次合成的 fetch 超时（毫秒）
BAMBOOK_MELO_REQUEST_TIMEOUT_MS=120000
# 默认合成参数（前端 voiceSpeed 通过 rate 百分比叠加在 baseline 上）
BAMBOOK_MELO_DEFAULT_SPEED=1.0
BAMBOOK_MELO_DEFAULT_LANGUAGE=ZH
# Melo 推理参数（对应 MeloTTS.tts_to_file 的 sdp_ratio / noise_scale / noise_scale_w）
# 改完 ops-panel restartMainApi 即可生效，无需改代码或重新部署
BAMBOOK_MELO_SDP_RATIO=0.2
BAMBOOK_MELO_NOISE_SCALE=0.6
BAMBOOK_MELO_NOISE_SCALE_W=0.8
# 主 API 启动后是否自动预热 Melo（首句延迟约 -3s）
BAMBOOK_MELO_PREWARM_ON_START=true
# 单次 TTS 文本上限（字符）
BAMBOOK_TTS_MAX_CHARS=2000
# HuggingFace 镜像（首次下载模型用，下载完后建议设 HF_HUB_OFFLINE=1）
BAMBOOK_HF_ENDPOINT=https://hf-mirror.com

# ─── 邮件（EmailManager 发信 / 注册验证邮件）─────────────────────────
# SMTP 与 Resend 二选一；都不配则发信功能不可用
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Bambook <no-reply@example.com>"
# RESEND_API_KEY=""
# RESEND_FROM="Bambook <no-reply@example.com>"

# ─── PDML 桥接（外部 PLM 数据同步，可选）─────────────────────────────
# PDML_ENDPOINT=""
# PDML_BRIDGE_KEY=""
# PDML_GSID=""
# PDML_TOKEN=""
# PDML_ZT_CODE=""
# PDML_SYNC_ENABLED=false
# PDML_SYNC_INTERVAL_MINUTES=30
# PDML_SYNC_PAGE_SIZE=200

# ─── 告警外发（error 级日志 webhook，默认关闭）───────────────────────
# 非空即启用：error 级日志以 POST JSON 外发到该 URL（generic webhook / Bark relay）
# 同源消息默认 5 分钟节流；外发失败绝不反噬日志管线
# BAMBOOK_ALERT_WEBHOOK_URL=""
# BAMBOOK_ALERT_MIN_LEVEL=error
# BAMBOOK_ALERT_THROTTLE_MS=300000

# ─── 可观测性阈值（可选，有默认值）───────────────────────────────────
# BAMBOOK_SLOW_REQUEST_MS=2000
# BAMBOOK_SLOW_QUERY_MS=500

# ─── 存储路径 ───────────────────────────────────────────────────────
# 上传文件目录（默认 server/uploads）
# BAMBOOK_UPLOAD_DIR=""
# 私有文件根（邮件附件/QC 测试报告等敏感文件；不挂 /api/uploads 静态服务，
# 只走带权限门的下载路由。默认 <server>/private-files，且不可位于上传目录之内）
# BAMBOOK_PRIVATE_FILES_DIR=""
# Web 静态资源目录 / 挂载路径（部署 web 构建产物时用）
# BAMBOOK_WEBAPP_DIR=""
# BAMBOOK_WEBAPP_MOUNT="/"
# 对外公开基址（生成绝对链接用）
# BAMBOOK_PUBLIC_BASE_URL="https://ops.jiangsupanda.com"
# 备份脚本默认目录
BAMBOOK_BACKUP_DIR="/Users/Shared/BambookBackups"
# 遗留本地 SQLite 源（仅迁移/回滚验证用）
# PO_DATABASE_PATH="/path/to/po_database.db"
# 数据源类型（默认 postgresql；仅特殊迁移场景调整）
# BAMBOOK_DATA_SOURCE_KIND="postgresql"
