DATABASE_URL=postgresql://panda1@localhost:5432/bambook
API_KEY=change-me
ALLOWED_ORIGINS=*

# Bind host/port (match Cloudflare Tunnel origin; 127.0.0.1 since cloudflared is co-located)
HOST=127.0.0.1
PORT=8091

OLLAMA_BASE=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

DEEPSEEK_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

RAG_TOP_K=5
CHUNK_MAX_CHARS=1200

# Path segment matching Cloudflare Tunnel « Path ».
# /bambook/kb namespaces the knowledge API under /bambook/kb/* so that
# /bambook/api/* can be routed by Cloudflare directly to the main data API (8081).
URL_MOUNT_PATH=/bambook/kb

# Optional: public URL after Cloudflare Tunnel (for client apps / docs only)
# PUBLIC_BASE_URL=https://jiangsupanda.com/bambook/kb
