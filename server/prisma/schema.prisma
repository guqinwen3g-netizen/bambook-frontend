model Department {
  id       String  @id
  name     String
  parentId String?
  status   String  @default("active")
  metadata Json?

  // ============ P0-10：部门主管（DR-007 resolveReviewerByDepartment 入口真源）============
  /// FK UserAccount.id；headId=NULL → 触发 FALLBACK_DEPT_HEAD_VACANT 兜底（DR7-A4）
  /// 设计真源：底座域模型组.md §39 BASE-39-A1；跨部门head可选允许但告警（代码层校验）
  headId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

