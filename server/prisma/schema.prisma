model DevelopmentCase {
  fabricSpecification Json?
  garmentSpecification Json?
  ownerId String?
  ownerAccount UserAccount? @relation("DevelopmentOwner", fields: [ownerId], references: [id])
  pendingExpenses DevelopmentPendingExpense[]
  lifecycleEvents DevelopmentLifecycleEvent[]
  expenseReviews DevelopmentExpenseReview[]
  id       String @id
  code     String @unique
  name     String
  type     String // fabric | garment | pp | trim
  stage    String // developing | shipping | feedback | revision | approved | cancelled
  priority String @default("normal") // urgent | high | normal | low

  // Owner / responsible person
  owner String?

  // Linked entities (soft references, no FK constraint)
  customerRelationId String?
  customerName       String?
  supplierRelationId String?
  supplierName       String?
  productAssetId     String?
  productName        String?

  // Process tracking
  currentRound  Int     @default(1)
  nextAction    String?
  targetDate    String?
  completedDate String?

  // Sample category + review (业务规定: 5A 样衣需生产部评审)
  sampleCategory String? @default("normal") // normal(普通) | 5a(5A重点)
  reviewStatus   String? // null(无需评审) | pending(待评审) | passed(通过) | failed(不通过)
  reviewerId     String?
  reviewDate     String?
  reviewNote     String?

  // Sample details
  sampleType             String? // lab-dip | handloom | yardage | fit-sample | pp-sample | size-set
  sampleQuantity         Float?
  sampleUnit             String? @default("meter")
  sampleSentDate         String?
  sampleTrackingNumber   String?
  sampleCourier          String?
  sampleShippingFee      Float? // 寄样邮寄费（快递费用留痕，费用币种随客户合同）
  // 寄样收件信息（DR-057 v2.1：开发单寄样收件方全量留痕）
  sampleRecipientName    String? // 收件人
  sampleRecipientCompany String? // 收件公司
  sampleRecipientAddress String? // 收件地址（城市/国家或完整地址）
  sampleRecipientPhone   String? // 联系电话
  sampleFeedback         String?
  sampleFeedbackDate     String?
  // 样品发票关联（跳财务·发票管理直达该发票详情）
  sampleInvoiceId        String?

  // Conversion to bulk order
  linkedOrderId String?
  linkedOrderPo String?
  convertedAt   BigInt?

  // Additional info
  notes       String?
  tags        String[]
  attachments Json?

  // Garment-specific specs (成衣专用，type=garment 时填写)
  styleSpec   String?
  sizeSpec    String?
  fabricSpec  String?
  processSpec String?

  // ── ★ 开发方向与实物样指向（2026-10-05 Kevin 拍板）──────────────────────
  // 业务原话：「开发的本质就是朝着一个方向，然后还有一些参数，还有一些需求」
  // ⇒ developmentDirection 是**总纲**，spec* 各项是**参数**。
  // spec* 原来只有一份文字"总纲 + 参数"混在一起，工厂/客户看样时没有一句可读的目标。
  developmentDirection String?
  // 客户给的实物样/色卡/参考物在关系智库里的指向（customerInput=physical-sample 时用）
  referenceRelationId  String?

  // ── 立项分类（三层，2026-10-05 Kevin 拍板）────────────────────────────────
  // ①开发什么：type（fabric面料/ garment成衣/ pp/ trim辅料）已在上方定义
  // ② 谁发起：initiator —— internal(我方内部) | customer(客户要求)
  // ③ 客户给什么：customerInput —— physical-sample(有明确来样·去复刻)
  //    | spec-direction(只给参数方向·我方设计) | none(无外部输入)
  // ⚠️ 下方 source 为历史遗留混合列，读写请优先用 initiator + customerInput。
  source           String? // legacy: customer-sample | customer-colorcard | internal
  initiator        String? // internal(我方内部) | customer(客户要求)
  customerInput    String? // physical-sample(有样复刻) | spec-direction(仅给方向) | none
  dyeMethod        String? // top_fiber_dyed(散纤染) | yarn_dyed(色纱织) | piece_dyed(匹染)
  // 需求方部门（source=internal 内部开发时：同公司不同部门提出的开发需求，DR-005 内部部门场景）
  departmentId     String?
  departmentName   String?
  // 面料规格要求（与 FabricProfile 同构，开发初期档案未建时先行承载）
  specComposition  String?
  specWeight       String?
  specWidth        String?
  specWeave        String?
  specFinish       String?
  targetPrice      Decimal? @db.Decimal(18, 4)
  moqEstimate      Float?
  // 技术评审（可选动作）
  techReviewStatus String? // null(未评审) | pass(可做) | adjust(需调整) | reject(不可做)
  techReviewNote   String?
  techReviewAt     String? // YYYY-MM-DD
  techReviewBy     String?

  // Timestamps & soft delete
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([type])
  @@index([stage])
  @@index([customerRelationId])
  @@index([supplierRelationId])
  @@index([productAssetId])
  @@index([owner])
  @@index([targetDate])
  @@index([code])
}

// ════════════════════════════════════════════════════════════════════
// Phase F1 — 面料开发链（DR-050，type=fabric 专用，2026-09-06 拍板）
// 设计真源：docs/design/04-模块设计/03-订单与生产/Development-开发/面料开发流程.md
// 核心：开发案 ↔ 多工厂试样（DevelopmentSupplier）→ 统一样品批次（SampleBatch，
//   色样/手织样/米样一套模型，lab-dip 内嵌色差字段）→ 封样（SealSample，同厂
//   批次组合、可多个）→ 强制转面料档案（convert-to-asset）→ 转大货/采购。
// 约定：developmentCaseId/supplierRelationId 为软引用快照风格（无 FK 约束，
//   与既有 DevelopmentCase/SampleNode 范式一致）；所有 mutation 写审计。
// ════════════════════════════════════════════════════════════════════

// 开发供应商：开发案 ↔ 工厂 多对多。建案时列表多选；报价/交期/结论渐进披露。
// 开发样品的三层业务主干：轮次保存一批修改要求，版本保存某工厂的设计结果，
// SampleBatch.sampleVersionId 再把一件/一种形态的实物样品挂到版本下。
// 使用软引用，避免历史开发案及跨域档案受级联删除影响。
model DevelopmentSampleRound {
  id                String @id
  developmentCaseId String
  round             Int
  purpose           String?
  clientVersion     String?
  materialConfig    String?
  notes             String?
  createdBy         String?
  createdAt         BigInt
  updatedAt         BigInt
  deletedAt         BigInt?

  @@unique([developmentCaseId, round])
  @@index([developmentCaseId, deletedAt])
}

model DevelopmentSampleVersion {
  id                 String @id
  roundId            String
  developmentCaseId  String
  supplierRelationId String
  supplierName       String?
  versionLabel       String
  versionKind        String @default("major") // major | minor
  parentVersionId    String?
  physicalSequence   Int?
  sourceVersionId    String?
  factoryCode        String?
  minorVersion       Int    @default(0)
  minorChangeNote    String?
  // Task-local copy of the round request plus factory edits; later round edits never cascade.
  roundRequirementsSnapshot String? @db.Text
  factoryRequirements String? @db.Text
  targetCompletionDate String?
  referenceAttachments Json?
  createdBy          String?
  createdAt          BigInt
  updatedAt          BigInt
  deletedAt          BigInt?

  // Legacy null physicalSequence rows retain a partial unique index in SQL migration.
  @@unique([roundId, supplierRelationId, physicalSequence, minorVersion], map: "DevelopmentSampleVersion_physical_minor_key")
  @@index([developmentCaseId, roundId])
  @@index([parentVersionId])
  @@index([versionLabel])
}

model DevelopmentSupplier {
  id                 String  @id // 格式：DS__${shortId}
  developmentCaseId  String
  supplierRelationId String
  supplierName       String? // 名称快照

  // 渐进披露（建案后推进中填写）
  quoteNote       String? // 试样报价/报价说明
  leadTime        String? // 试样交期
  trialConclusion String? // null(进行中) | ok(试样通过) | fail(试样失败)
  notes           String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  // ⚠️ 2026-10-05 移除 @@unique([developmentCaseId, supplierRelationId])
  //   依据：Kevin 拍板「同一案、同一工厂可以打第二/三/四轮，这非常正常」
  //   （开发本质是反复打样、反复确认）。
  //   2026-10-07：实际 dev 恢复演练发现旧迁移仍建有独立唯一索引；
  //   reconciliation 迁移只删除该索引，保留全部历史行与普通查询索引。
  @@index([developmentCaseId])
  @@index([supplierRelationId])
}

// 统一样品批次：色样 lab-dip / 手织样 handloom / 米样 yardage 一套概念。
// 每批归属工厂；新版本按打样安排→工厂返样成果→QC→业务确认→样品仓库入库→客户寄样推进。
// lab-dip 型内嵌色差扩展字段（缸号/评级/疵点/照片/客户判定，语义对齐 SampleColorBatch）。
//
// ★★★ 版本语义（2026-10-05 Kevin 拍板，全模块地基）★★★
//   DevelopmentSampleRound = 一批修改要求；DevelopmentSampleVersion = 某工厂的设计结果；
//   SampleBatch = 实物样品（成衣版本通常对应一件样衣，面料版本可挂多种形态批次）。
//   命名：R{round}-{工厂字母}[-{小版本序号}]
//     · R1-A   = 轮次1、A工厂的设计版本；成衣对应一件实物，面料可对应多种实物形态
//     · R4-A-1 = 在 R4-A 基础上的文字微调版本（**小版本，无实物**，仅服装使用）
//   轮次语义：一轮 = 客户/内部给出一批修改要求 → 挑相似版本 → 交给选中工厂再打。
//     轮次号**允许跳号**（A工厂可能连做四轮）。
//   小版本（-1）**从属于大版本**：不产生新实物、**不重复封样**（实物只有一件，
//     封样/留样永远归属大版本，否则两边抢不过来），但**可被下游大货/订单引用**。
//   面料几乎不用小版本（「要改就重打样」），故小版本仅在 type=garment 生效。
model SampleBatch {
  sampleSources SampleSource[]
  id                 String  @id // 格式：SB__${shortId}
  batchCode          String  @unique // 业务号：SB-YYYYMMDD-001
  developmentCaseId  String
  supplierRelationId String // 归属工厂（必填）
  supplierName       String?
  sampleType         String // lab-dip | handloom | yardage（面料）；garment-round（DR-054 阶段 G-Ⅱ 成衣轮次）
  specNote           String? // 描述（色号/组织/克重/颜色等）
  round              Int     @default(1)

  // ── ★ 版本身份（2026-10-05）────────────────────────────────────────────
  // 人类可读的版本号，如 R1-A / R1-A.1。业务员在界面上看到、互相沟通用的就是它。
  versionLabel String? // 大版本 R{round}-{工厂字母}；小版本追加点号序号，如 R1-A / R1-A.1
  sampleVersionId String? // 该实物批次所属的设计版本节点
  // 小版本从属于哪个大版本（自身即大版本时为 null）。微调不产生新实物。
  parentBatchId String?
  // 小版本序号：0/null = 大版本；1、2、3… = 基于大版本的第 n 次微调
  minorVersion Int @default(0)
  // 面料一件可含多种形态样品时的形态序号（同一版本内区分色样/手织样/米样）。
  // 成衣通常只有 0（单形态）。
  formIndex Int @default(0)
  // 微调说明：小版本必须在确认时留下**清晰明确**的备注（Kevin 拍板硬要求）
  minorChangeNote String?

  // 通用状态机 + 寄样/反馈/批准
  status         String  @default("pending") // pending | making | sent | approved | revising
  sentDate       String?
  courier        String?
  trackingNumber String?
  shippingFee    Float?
  feedback       String?
  feedbackDate   String?
  approvedAt     BigInt?
  approvedBy     String?

  // DR-054 阶段 G-Ⅱ：成衣轮次并入批次（sampleType='garment-round'）——内部 QC 门禁（DR-008/DR-029）
  qcStatus             String? // null | passed | failed（成衣轮次内部 QC 评审；面料批次为 null）
  qcReviewedBy         String?
  qcReviewedAt         BigInt?
  qcInspectionReportId String? // QC 结论引用 InspectionReport（QC 域只读引用）

  // DR-054 阶段 G-Ⅱ：成衣轮次扩展字段（purpose/version/materialConfig/qcNote/submittedAt/submittedBy/shipment/
  //   confirmation/modifications/evidence/sealedRoundStatus 等）统一承载于 attachments JSON
  attachments Json?

  // 批次 = 开发活动 + 确认单位
  // 打样时登记计划数量；工厂返样后登记实际结果；QC 通过并由业务确认后才登记样品间库存。
  // confirmStatus = 确认锚点（批次级 tag）：批次内所有样品一起被确认；已确认批次不可重复确认。
  planQuantity   Decimal? @db.Decimal(18, 4) // 打样计划数量（如 8 米/2 件）
  planUnit       String? // 计划单位（米/件/张…）
  actualQuantity Decimal? @db.Decimal(18, 4) // 实际收到数量（以实际为准，如 5 米）
  actualUnit     String? // 实际单位
  // 工厂返样结果登记（早于 QC 与样品仓库入库）；不是样品卡的库存收货事实。
  returnedAt        BigInt?
  returnedBy        String?
  returnRequestKey  String?
  returnFingerprint String? @db.VarChar(64)
  // 成果字段仅在工厂返样后填写；计划阶段保持为空。
  confirmStatus  String   @default("unconfirmed") // unconfirmed | confirmed（批次级确认）
  confirmedAt    BigInt?
  confirmedBy    String?

  // lab-dip 色差扩展（sampleType=lab-dip 时使用）
  dyeLotNo             String?
  colorRating          Int?
  sideDiff             Int?
  endDiff              Int?
  defectCauses         String[] @default([]) // red_cast | blue_cast | lighter | darker
  customerStatus       String? // null(未判定) | approved | rejected | needs_recast
  approvedAsSealed     Boolean  @default(false)
  customerFeedbackNote String?
  customerFeedbackDate String?
  photos               Json?

  // 转档回填（批次直接转面料档案）
  convertedProductAssetId String?
  convertedAt             BigInt?

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([developmentCaseId])
  @@index([supplierRelationId])
  @@index([sampleType])
  // ★ 版本检索（2026-10-05）：按轮次/父版本/版本号快速定位
  @@index([developmentCaseId, round])
  @@index([parentBatchId])
  @@index([versionLabel])
  @@index([sampleVersionId])
  @@index([status])
}

/// Append-only formal QC work items for an exact development version, referencing
/// the existing physical sample. Legacy rows retain unknown version identity.
/// Saving factory-return results already synchronizes the same warehouse record.
model DevelopmentSampleQualityReview {
  // Legacy null means no recorded measurements; never infer historical readings.
  measurements Json?
  routingTeamId String?
  responsibleHeadId String?
  id                   String @id
  sampleBatchId        String
  sampleVersionId      String?
  reviewSequence       Int?
  developmentCaseId    String
  requestKey           String @unique
  sourceFingerprint    String @db.VarChar(64)
  sourceSnapshot       Json
  status               String @default("queued") // queued | in_progress | reviewed | acknowledged
  requestedBy          String
  requestedAt          BigInt
  startedBy            String?
  startedAt            BigInt?
  result               String? // pass | needs_adjustment | reject
  opinion              String? @db.Text
  inspectionDate       String?
  inspectorOrg         String?
  criticalDefects      Int @default(0)
  majorDefects         Int @default(0)
  minorDefects         Int @default(0)
  evidence             Json?
  reviewedBy           String?
  reviewedAt           BigInt?
  completionRequestKey String? @unique
  completionFingerprint String? @db.VarChar(64)
  acknowledgedBy       String?
  acknowledgedAt       BigInt?
  acknowledgementRequestKey String? @unique
  createdAt            BigInt
  updatedAt            BigInt

  @@index([status, requestedAt])
  @@index([developmentCaseId, requestedAt])
  @@index([requestedBy, requestedAt])
  @@index([sampleBatchId, requestedAt])
  @@index([sampleVersionId, requestedAt])
  @@unique([sampleVersionId, reviewSequence], map: "DevelopmentSampleQualityReview_version_sequence_key")
  @@index([routingTeamId, status])
  @@index([responsibleHeadId, status])
}

/// Actual customer/internal requester confirmation is separate from the staff
/// member recording it and from QC or business acknowledgement of a QC report.
/// Each minor version has its own immutable history; no parent inheritance.
model DevelopmentVersionConfirmation {
  id                    String @id
  developmentCaseId     String
  sampleVersionId       String
  requestKey            String @unique
  requestFingerprint    String @db.VarChar(64)
  confirmerType         String // customer | internal
  confirmerName         String
  confirmerUserId       String?
  confirmerRelationId   String?
  confirmerOrganization String?
  confirmedAt           BigInt
  result                String // approved | rejected | needs_adjustment
  basis                 String @db.Text
  evidence              Json?
  recordedBy            String
  recordedAt            BigInt
  sourceFingerprint     String @db.VarChar(64)
  sourceSnapshot        Json

  @@index([developmentCaseId, recordedAt])
  @@index([sampleVersionId, recordedAt])
}

// 封样：同厂批次组合的标准样实体。品质基准 + 标准样信息 + 可绑定客户（可选）。
// 状态机：draft(草稿) → sealed(已封样) → converted(已转档)；converted 终态不可软删。
model SealSample {
  sampleSources SampleSource[]
  id                 String  @id // 格式：SEAL__${shortId}
  sealCode           String  @unique // 业务号：SEAL-YYYYMMDD-001
  developmentCaseId  String
  supplierRelationId String // 归属工厂（组合同厂强校验）
  name               String?

  // 标准样信息
  standardNo     String?
  retainLocation String?
  qualityNote    String?

  // 可选绑定客户（内部标准样可不绑）
  customerRelationId String?
  customerName       String?

  status                  String  @default("draft") // draft | sealed | converted
  convertedProductAssetId String?
  convertedAt             BigInt?

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([developmentCaseId])
  @@index([supplierRelationId])
  @@index([status])
}

// 封样批次组合：SealSample ↔ SampleBatch 多对多（同厂校验在 service 层）
model SealSampleBatch {
  id            String @id
  sealSampleId  String
  sampleBatchId String

  @@unique([sealSampleId, sampleBatchId])
  @@index([sampleBatchId])
}

// ════════════════════════════════════════════════════════════════════
// Phase B4 — 三级样衣节点（确认样 → 产前样 → 大货样）
// 每个 DevelopmentCase 最多 3 个节点（每级一行），状态机：
//   pending(待打样) → making(制作中) → sent(已寄出) → approved(客户批准)
//                                                ↘ revising(需修改) → making（round+1）
// 业务规则：产前样批准是开裁前置条件；大货样（TOP）从大货首件抽取留档。
// ════════════════════════════════════════════════════════════════════
model SampleNode {
  id                String @id // 格式：SN__${caseId}__${level}
  developmentCaseId String
  level             String // confirmation(确认样) | pp(产前样) | top(大货样)
  round             Int    @default(1) // 修改轮次（revising → making 时 +1）
  status            String @default("pending") // pending | making | sent | approved | revising

  // DR-051 样品归属打样工厂（方案 A）：确认样由哪家打样工厂出品（软引用，与 DevelopmentSupplier 对齐）
  supplierRelationId String?
  supplierName       String?

  // 寄样信息
  sentDate       String? // YYYY-MM-DD
  courier        String?
  trackingNumber String?

  // 客户反馈 / 批准
  feedback     String?
  feedbackDate String? // YYYY-MM-DD
  approvedAt   BigInt?
  approvedBy   String?

  notes String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@unique([developmentCaseId, level])
  @@index([developmentCaseId])
  @@index([status])
  // B243：这条索引一直只活在库里（迁移 20260907000000_sample_node_supplier 建它，schema 却没声明）
  //   ⇒ 按 schema 建新库会静默少掉它。补进主线，让 `db push` 与迁移两条路一致。
  @@index([supplierRelationId])
}

// ════════════════════════════════════════════════════════════════════
// 样品管理域（DR-052，2026-09-07 开始落地）
// 设计真源：docs/design/04-模块设计/03-订单与生产/Development-开发/样品管理域设计.md
// 统一 Sample 对象：承载「设计确认」产物（dev 开发样 / seal 确认样封样）与
//   「生产确认」产物（pp 产前样 / top 大货样 / ship 船样 / head 匹头样 / pioneer 先锋样），
//   类型可演进（复刻 fork），每个样品对象是产物级开票触点。
// 状态机：设计确认 draft→making→sent→confirmed→sealed（revising→making round+1）
//         生产确认 draft→making→qc→submitted→confirmed→approved（产前样 approved=开裁前置）
// ════════════════════════════════════════════════════════════════════
model Sample {
  orderSampleSource OrderSampleSource?
  /// Canonical native output only. Physical registrations and descendants leave this null.
  projectionKey String? @unique
  sourceBindings SampleSource[]
  id   String @id // 格式：SMP__${shortId}
  code String @unique // 业务号：SMP-YYYYMMDD-001

  // ── 类型（可演进） ──
  type    String // dev(开发样) | seal(确认样/封样) | pp(产前样) | top(大货样)
  //  | ship(船样) | head(匹头样) | pioneer(先锋样)
  subType String? // 面料：lab-dip/handloom/yardage；成衣：fit/pp/size-set 等（对齐开发管理样品类型）

  // ── 来源（设计确认 ↔ 开发案；生产确认 ↔ 订单） ──
  sourceCaseId   String? // 设计确认样品：来源开发案
  sourceOrderId  String? // 生产确认样品：来源大货订单
  productAssetId String? // 关联产品档案（封样后转档回填）

  // ── 归属 ──
  supplierRelationId String? // 打样/生产工厂（多工厂场景，DR-051 方案 A 对齐）
  supplierName       String?
  customerRelationId String? // 客户（可空=内部）

  // ── 状态机（按 type 语境） ──
  status String @default("draft") // 设计确认：draft/making/sent/confirmed/sealed
  // 生产确认：draft/making/qc/submitted/confirmed/approved
  round  Int    @default(1) // 轮次（PP1/PP2…；开发样复样轮次）

  // DR-054 阶段 A：确认锚点上移至批次（SampleBatch.confirmStatus），样品侧仅保留展示口径。
  // 设计确认链（dev/seal）的 confirmed 语义由批次同步；sealed（封样）为实物级 tag，挂 SampleCardItem。
  designConfirmStatus String? // batch-confirmed（由批次确认同步，展示口径）| null（历史/未确认）

  // ── 寄样 / 反馈 / 批准 ──
  sentDate         String?
  courier          String?
  trackingNumber   String?
  shippingFee      Float?
  recipientName    String?
  recipientCompany String?
  recipientAddress String?
  recipientPhone   String?
  feedback         String?
  feedbackDate     String?
  approvedAt       BigInt?
  approvedBy       String?

  // ── 生产确认门禁（产前样：QC + 客户确认） ──
  qcStatus             String? // null/passed/failed
  qcInspectionReportId String? // QC 报告
  customerStatus       String? // null/approved/rejected/needs_revision

  // ── 复刻（类型演进） ──
  forkedFromSampleId String? // 由哪个样品复刻（确认样 → 产前样）

  // ── 开票触点 ──
  invoiceId String? // 产物级发票关联（每个样品可开票）

  // DR-054 阶段 G：大货生产样明细（ship/head/pioneer 扩展字段统一承载，与 DevelopmentCase.attachments 同风格）：
  //   sampleQuantity/sampleUnit（取样数量/单位）、batchNo（工厂批次号）、rollNos（匹号数组，匹头样）、
  //   cuttingDate（裁剪日期）、productionStage（先锋样生产阶段 greige_out_of_loom/after_dyeing/after_finishing）、
  //   producedMeterage（取样时已产米数）、millName（工厂冗余）
  attachments Json?

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  // ── D6-Q1 米样长度口径（2026-09-16 拍板：米样升为 Decimal 长度；样卡 SampleCardItem 张数不动） ──
  // 当前持有长度（可分割给客户/余量退回/损耗/借入归还的口径）；null = 非长度口径样品（历史数据不回填）
  lengthQty  Decimal? @db.Decimal(18, 4)
  lengthUnit String? // M | YD（米/码可选；同一样品的全部长度流水必须同单位，不可互算裸加）

  @@index([type])
  @@index([status])
  @@index([sourceCaseId])
  @@index([sourceOrderId])
  @@index([productAssetId])
  @@index([supplierRelationId])
}

/// Immutable exact physical origin; several physical Samples may share one batch/round.
/// Unknown historical rows remain unbound. These facts do not restore workflow approval.
model SampleSource {
  id String @id
  sampleId String
  sample Sample @relation(fields: [sampleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sampleBatchId String
  sampleBatch SampleBatch @relation(fields: [sampleBatchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceRound Int
  sourceSealId String?
  sourceSeal SealSample? @relation(fields: [sourceSealId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceSnapshot Json
  sourceFingerprint String
  sourceUpdatedAt BigInt
  sourceHistoryRevision Int?
  sourceEventId String?
  evidenceAuditId String
  boundAt BigInt
  boundBy String
  // native | recorded_exact | current_link_recorded | inherited. No independent approval lifecycle.
  provenance String

  @@unique([sampleId, sampleBatchId, sourceRound])
  @@index([sampleBatchId, sourceRound])
  @@index([sampleId])
  @@index([sourceSealId])
}


/// Immutable order-domain identity and sample facts. Only the two event-head
/// fields may advance together; migration triggers enforce the committed chain.
model OrderSampleSource {
  commandCancellations OrderSampleCommandCancellation[]
  id String @id
  sampleId String @unique
  orderId String
  businessLine String
  family String
  factoryRelationId String
  chainId String
  round Int
  previousSourceId String?
  provenance String
  specSnapshot Json
  sampleQuantity Decimal @db.Decimal(18, 4)
  sampleUnit String
  cuttingDate String
  contentFingerprint String
  coverageFingerprint String
  creationAuditId String @unique
  createdBy String
  createdAt BigInt
  headSequence Int @default(0)
  headEventId String?

  sample Sample @relation(fields: [sampleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  factory Relation @relation("OrderSampleFactory", fields: [factoryRelationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator UserAccount @relation("OrderSampleCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creationAudit AuditLog @relation("OrderSampleCreationAudit", fields: [creationAuditId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousSource OrderSampleSource? @relation("OrderSampleRounds", fields: [previousSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  followingSources OrderSampleSource[] @relation("OrderSampleRounds")
  coverage OrderSampleCoverage[]
  events OrderSampleEvent[] @relation("OrderSampleEvents")
  // DEFERRABLE INITIALLY DEFERRED in SQL; Prisma cannot express deferrability.
  headEvent OrderSampleEvent? @relation("OrderSampleHead", fields: [id, headSequence, headEventId], references: [sourceId, sequence, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([chainId, round])
  // Non-null previousSourceId has a partial unique index in migration SQL.
  @@index([orderId, family, factoryRelationId])
}

/// Immutable half-open represented ranges, never a sampling/stock quantity.
model OrderSampleCoverage {
  id String @id
  sourceId String
  scopeKey String
  orderLineId String
  scopeKind String
  productionBatchId String?
  productionBatchRevision Int?
  rangeStart Decimal @db.Decimal(18, 4)
  quantity Decimal @db.Decimal(18, 4)
  unit String
  lineQuantity Decimal @db.Decimal(18, 4)
  lineFingerprint String
  batchRangeStart Decimal? @db.Decimal(18, 4)
  batchQuantity Decimal? @db.Decimal(18, 4)
  specFingerprint String
  sourceFingerprint String

  // Exact material planning basis; NULL retains historical unknown facts.
  materialProof Json?

  // Explicit factory/actual-line declaration frozen at sample registration.
  // NULL preserves historical unknown facts; never inferred from a line name.
  productionLineIdentity Json?

  source OrderSampleSource @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productionBatch ProductionBatch? @relation(fields: [productionBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sourceId, scopeKey])
  @@index([orderLineId])
  @@index([productionBatchId, productionBatchRevision, sourceId], map: "OrderSampleCoverage_batch_revision_source_idx")
}

/// Append-only native event and permanent original command acknowledgement.
/// SQL enforces sequence/previous/head identity; the producer/reader verifies
/// real audit content and the pure reducer's business-event payload contract.
model OrderSampleEvent {
  id String @id
  sourceId String
  sequence Int
  previousEventId String?
  eventType String
  actorId String
  recordedAt BigInt
  occurredAt String
  contentFingerprint String
  coverageFingerprint String
  payload Json
  auditId String @unique
  protocolVersion Int
  requestKey String
  commandHash String
  commandSnapshot Json
  acknowledgement Json
  ackHash String
  qcReportId String?
  qcReportRevision Int?
  qcReportAuditId String?

  source OrderSampleSource @relation("OrderSampleEvents", fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor UserAccount @relation("OrderSampleEventActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  audit AuditLog @relation("OrderSampleEventAudit", fields: [auditId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousEvent OrderSampleEvent? @relation("OrderSamplePreviousEvent", fields: [sourceId, previousEventId], references: [sourceId, id], onDelete: Restrict, onUpdate: Restrict)
  followingEvents OrderSampleEvent[] @relation("OrderSamplePreviousEvent")
  headForSources OrderSampleSource[] @relation("OrderSampleHead")
  qcReport InspectionReport? @relation("OrderSampleQcReport", fields: [qcReportId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  qcReportAudit AuditLog? @relation("OrderSampleQcAudit", fields: [qcReportAuditId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sourceId, sequence])
  @@unique([protocolVersion, actorId, requestKey])
  @@unique([sourceId, id])
  @@unique([sourceId, sequence, id])
  @@index([qcReportId, qcReportRevision])
  @@index([qcReportAuditId])
}

// D6-Q1 米样长度台账（append-only）：分割 / 剪给客户 / 余量退回 / 损耗入账 / 借入归还
// 业务规则：
//   - Sample.lengthQty 是当前持有长度快照真源；本表是它的变动流水（与 StockMovement 同范式）
//   - 同一样品的全部流水必须同 lengthUnit（M 与 YD 不可互算，直接拒绝——报错优于算错）
//   - cut（分割）新建子样（type/subType/来源/工厂/客户继承），父子双向流水互引
model SampleLengthMovement {
  id                  String   @id // 格式：SLM__${shortId}
  sampleId            String // 归属米样（snapshot FK → Sample.id）
  // set(建账) | cut(分割出子样) | give(剪给客户) | return(余量退回工厂) | loss(损耗入账) | borrow_in(从工厂借入) | borrow_return(归还工厂)
  type                String
  quantity            Decimal  @db.Decimal(18, 4) // 本笔变动数量（绝对值；方向由 type 语义决定）
  unit                String // M | YD（必须与样品 lengthUnit 一致）
  counterpartSampleId String? // cut 关联的另一侧样（子样或被分割的父样）
  balanceAfter        Decimal? @db.Decimal(18, 4) // 变动后该样持有长度（快照留痕）

  // ─── D7-① 转化通道：目标对象（转大货 / 转售）─────────────────────────
  // to_bulk（米样转大货）→ targetInventoryItemId 记录大货库存项（大货侧经
  //   createStockMovement 增账，referenceType='Sample'）；
  // to_resale（米样转售）→ targetRelationId 记录客户、amount 记录售价（应收侧走
  //   既有 BillingItem(sourceType='Sample') 通路，不新建收款通道）。
  targetInventoryItemId String? // 转大货的目标 InventoryItem.id
  targetRelationId      String? // 转售的目标客户 Relation.id
  amount                Decimal? @db.Decimal(18, 4) // 转售金额（币种随发票/计费项，不在此冗余）
  note                  String?
  operator              String?
  createdAt             BigInt

  @@index([sampleId])
  @@index([type])
}

// ════════════════════════════════════════════════════════════════════
// Finance Module — 财务发票管理 + 收/付款凭证核销
// Added: 2026-06-15
// Contract: docs/MODULE_CONTRACT.md (linkKind: billTo / aboutOrder / settlesInvoice)
//
// 设计取舍：
//  - 金额字段已迁移至 Decimal @db.Decimal(18,4)（Phase 3 完成）；
//    全库 Float→Decimal 迁移已完成（Phase 3）。
//    待统一 PR 迁移，不在本模块单独破例。
//  - 业务日期（issueDate/dueDate/paymentDate）用 String YYYY-MM-DD —— 与 Order.dueDate / DevelopmentCase.targetDate 一致。
//  - 时间戳（createdAt/updatedAt/deletedAt）用 BigInt epoch ms —— 与 Order/DevelopmentCase 一致。
//  - exchangeRate 已迁移至 Decimal @db.Decimal(18,4)；外贸 USD→CNY 汇率存"开票/收款当日"快照。
//  - PaymentVoucher.appliedAmount 表达"本笔凭证核销发票多少钱"，支持部分销账；
//    1:N 销账数据模型已通过 InvoiceAllocation 中间表提供地基（task_mqxwgafj），为后续 payment.receive_and_reconcile flow 做准备。
//  - Relation 关联用 *Snapshot* FK 风格（不加 @relation），与 Order 的 customerRelationId
//    一致——避免 Relation 归档时级联删除。
// ════════════════════════════════════════════════════════════════════

model Invoice {
  id            String @id // 格式：INV__${shortId}
  invoiceNumber String @unique // 业务发票号（如 INV-20260615-001）

  // ─── 业务字段 ───
  type           String // Receivable(应收-客户账单) | Payable(应付-工厂账单)
  status         String // Draft(草稿) | Issued(已开票) | PartiallyPaid(部分销账) | Paid(已结清) | Cancelled(已作废)
  amount         Decimal @db.Decimal(18, 4) // 发票金额（含税）
  currency       String // USD | CNY | EUR | HKD ...
  issueDate      String // 开票日期 YYYY-MM-DD
  dueDate        String? // 应收/应付到期日 YYYY-MM-DD（部分场景可空）
  settlementDate String? // 实际结算日期 YYYY-MM-DD（全额收/付款完成日，由 allocation 自动写入）

  // ─── 汇率快照（外贸场景必填，本币发票可空） ───
  exchangeRate Decimal? @db.Decimal(18, 4) // 开票当日 currency → baseCurrency 汇率
  baseCurrency String   @default("CNY") // 本位币

  // ─── 关联（snapshot FK） ───
  orderId            String? // 关联订单（aboutOrder linkKind）
  customerRelationId String? // 结算单位 / 开票对象（billTo linkKind）
  customerName       String? // 冗余快照：避免 Relation 改名后历史发票显示错乱

  // ─── 来源幂等（DR-053 阶段 0）：invoice 唯一来源约束，防并发/重试重复建票 ───
  // 业务语义：同一来源（如某个样品/收费事项）最多一张有效发票。
  // sourceId 可为业务单据 ID（样品开票=Sample.id）；sourceType+sourceId 联合唯一
  // 在数据库层防并发重复建票 + 支撑"建票中途失败后重试恢复"（先查已有票再回填）。
  // 历史/订单级发票两字段均为 null（PG unique 对 NULL 不互斥，安全）。
  sourceType String? // 来源类型：Sample | BillingItem(未来收费事项) | ...
  sourceId   String? // 来源业务单据 ID

  // ─── 备注 / 附件 ───
  notes       String?
  attachments Json?

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  // ─── Phase 1-03 财务域升级：行级权限 ───
  ownerId      String?
  departmentId String?

  @@unique([sourceType, sourceId])
  @@index([type])
  @@index([status])
  @@index([orderId])
  @@index([customerRelationId])
  @@index([invoiceNumber])
  @@index([issueDate])
  @@index([dueDate])
  @@index([ownerId])
  @@index([departmentId])
}

// ════════════════════════════════════════════════════════════════════
// DR-053 阶段 3：收费事项与成本记录（费用四层表达）
// ════════════════════════════════════════════════════════════════════
// 费用四层表达（DR-053 §12.8 结论修正第 4 点，设计真源：样品管理域设计.md §12/§15）：
//   ① 费用发生 = CostRecord（成本记录，实际打样/邮寄/测试花费，归集口径）
//   ② 收费决定 = BillingItem（收费事项：客户应承担金额、免收/抵扣决定、内部归集）
//   ③ 应收草稿 = Invoice(status=Draft, sourceType='BillingItem')——收费决定确认后才生成，
//     费用发生不自动形成应收
//   ④ 正式签发 = Invoice(status=Issued)——对客户生效；PI(Proforma) 仅外贸可选前置（既有
//     proformaInvoiceService Quotation→PI→convertToReceivable 链路），不设为所有应收必经
// 支持部分免收（waivedAmount）/抵货款（offsetAmount+offsetOrderId，净应收扣除）/案取消收费
// （来源=DevelopmentCase，stage=cancelled 不阻断收费——收费资格绑费用发生事实，不绑开发案状态）。
// snapshot FK 风格（与全库一致，不加 @relation），软删（deletedAt）。
// ════════════════════════════════════════════════════════════════════

/// 成本记录：费用发生层。一条实际发生的打样/邮寄/测试/开发花费事实（可独立登记，供收费决定参考）。
model CostRecord {
  registrationKey String? @unique
  registrationFingerprint String?
  developmentShippingSource Json? // Immutable native send-event/audit and round snapshot; legacy amounts do not imply currency or payment.
  evidence CostEvidence[]
  billingCoverage BillingItemCostCoverage[]
  pendingExpense DevelopmentPendingExpense?
  id               String  @id // 格式：CR__${shortId}
  recordNo         String  @unique // 业务号：CR-YYYYMMDD-001
  sourceType       String // 来源类型：Sample | SealSample | SampleBatch | DevelopmentCase | OrderLine | Quotation
  sourceId         String // 来源业务单据 ID
  costType         String // sample_making(打样费) | shipping(邮寄费) | testing(测试费) | development(开发费) | other
  amount           Decimal @db.Decimal(18, 4) // 实际花费金额
  currency         String  @default("CNY")
  incurredAt       String // 发生日期 YYYY-MM-DD
  bearerType       String  @default("customer") // customer | internal | supplier——费用承担/归集口径（谁的钱花出去）
  bearerRelationId String? // 对应 Relation（客户/工厂/内部部门）
  notes            String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([sourceType, sourceId])
  @@index([costType])
}

/// 收费事项：收费决定层。向客户/内部/供应商"收多少钱、免收多少、抵多少货款"的决策实体；
/// 确认（confirm）锁定决定后，才生成应收草稿（Invoice Draft，sourceType='BillingItem'）。
model BillingItem {
  developmentChargeLines DevelopmentBillingChargeLine[]
  developmentCiClaims DevelopmentCiBillingClaim[]
  developmentCommercialFingerprint String?
  developmentCommercialConfirmedAt BigInt?
  developmentCommercialConfirmedBy String?
  developmentCommercialCostSelection Json?
  developmentWorkflowState String?
  developmentWorkflowVersion Int @default(0)
  developmentSubmittedBy String?
  developmentSubmittedAt BigInt?
  developmentAssigneeId String?
  developmentApprovalId String?
  developmentWorkflowEvents DevelopmentBillingWorkflowEvent[]
  developmentExpenseReviewId String?
  developmentExpenseReview DevelopmentExpenseReview? @relation(fields: [developmentExpenseReviewId], references: [id], onDelete: Restrict)
  costCoverage BillingItemCostCoverage[]
  id                String  @id // 格式：BI__${shortId}
  itemNo            String  @unique // 业务号：BI-YYYYMMDD-001
  sourceType        String // 来源类型：Sample | SealSample | SampleBatch | DevelopmentCase | OrderLine | Shipment(运费应收,CIF口径)
  sourceId          String // 来源业务单据 ID
  costRecordId      String? // 关联主成本记录（费用发生→收费决定；多成本合并收费时选主记录，收费金额可独立合计）
  chargeType        String // sample_fee | shipping_fee | testing_fee | development_fee | other
  // 承担方（向谁收）
  bearerType        String  @default("customer") // customer | internal | supplier
  bearerRelationId  String?
  bearerName        String? // 冗余快照
  // 金额与决定
  amount            Decimal @db.Decimal(18, 4) // 应收费总额（成本侧合计口径，可含多轮）
  currency          String  @default("CNY")
  waivedAmount      Decimal @default(0) @db.Decimal(18, 4) // 免收
  offsetAmount      Decimal @default(0) @db.Decimal(18, 4) // 抵货款（净应收扣除；订单发票结算时财务据此冲抵）
  offsetOrderId     String? // 抵扣到哪个订单（货款）
  offsetOrderNumber String? // 冗余快照
  // 状态机：draft → confirmed → invoiced；draft/confirmed → cancelled
  // 净应收 = amount − waivedAmount − offsetAmount（派生值，服务端计算返回，不落库防漂移）
  status            String  @default("draft")
  invoiceId         String? // 回填（应收草稿；净应收 ≤0 时为空，语义=无应收闭环）
  invoiceNumber     String? // 冗余快照
  confirmedAt       BigInt?
  confirmedBy       String?
  notes             String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([sourceType, sourceId])
  @@index([status])
}

/// DR-054 阶段 A：发票行（费用行为开票唯一来源；一费用行最多被一张票的一行引用）。
/// 新费用开票链路（CostRecord/BillingItem → 发票）走本行级；Invoice.sourceType/sourceId 保留为
/// 兼容字段（样品快速开票历史）。invoiceLines 在 createInvoice 时写入。
model InvoiceLine {
  id          String  @id // 格式：INVLINE__${shortId}
  invoiceId   String
  sourceType  String // 'CostRecord'（费用行）| 'OrderLine' | 'BillingItem' | 'Manual'
  sourceId    String
  amount      Decimal @db.Decimal(18, 4)
  currency    String  @default("CNY")
  description String?

  createdAt BigInt

  @@unique([sourceType, sourceId]) // 一费用行最多一张票的一行（防重复占用）
  @@index([invoiceId])
}

// ════════════════════════════════════════════════════════════════════
// 业务语义：一张应收/应付发票可含多个订单（合并开票），也可仅覆盖一个订单；
//           一个订单可能被多张发票分摊（分期开票/预开）。发票 ↔ 订单为多对多，
//           由本分配表承载。原 Invoice.orderId 保留为主订单快照（兼容既有数据/列表）。
// snapshot FK 风格（与全库一致，不加 @relation），软删（deletedAt）。
model InvoiceOrderAllocation {
  id              String   @id // 格式：IOA__${shortId}
  invoiceId       String
  orderId         String
  orderNumber     String? // 冗余快照：订单号
  poNumber        String? // 冗余快照：客户 PO
  allocatedAmount Decimal? @db.Decimal(18, 4) // 本订单在发票中的分摊金额（可空=整单）
  batchId         String? // 归属出运批次（snapshot FK → OrderShipmentBatch.id；P0-1：分批开票时指定，null=整单/预开票等非批次场景）
  note            String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@unique([invoiceId, orderId])
  @@index([invoiceId])
  @@index([orderId])
  @@index([batchId]) // P0-1：批次已开票金额聚合锚点
}

// ════════════════════════════════════════════════════════════════════
// REQ2-08 催款函与对账单财务套件 (DR-050)
// ════════════════════════════════════════════════════════════════════
// 设计决策（DR-050，设计文档 §2）：
//   ① 函生成即时组装（不落模板表）：账龄明细是逐发票动态行，模板变量表达不了
//      表格——中英函由服务即时组装；EmailTemplate 单发票轻提醒模板保留两档并存
//   ② 催款记录独立建模（快照留痕）：记录当次账龄全景（客户还款后历史不失真）；
//      发送走既有 Outbox/SMTP，催款域只登记事实
//   ③ 一键发起挂账龄行（选中即上下文：客户×币种）
// 设计真源：docs/design/04-模块设计/05-财务与结算/催款函套件.md
// ════════════════════════════════════════════════════════════════════

/// 催款记录：当次账龄全景快照留痕（渠道/结果/跟进人）
model DunningRecord {
  id                 String  @id // 格式：DUN__${shortId}
  customerRelationId String? // 关联客户（快照 FK）
  customerName       String // 冗余快照（还款后历史不失真）
  currency           String // 币种
  totalOverdue       Decimal @db.Decimal(18, 4) // 逾期总额快照
  invoiceCount       Int // 逾期发票数快照
  agingBuckets       Json // 五桶快照 {current,d1_30,d31_60,d61_90,d90plus}
  channel            String // email | phone | visit | other
  result             String // sent | promised | paid | disputed | no_response
  stage              String? // 记录发生时的催款分级快照（reminder|firm|urgent|legal；P0-2 前历史为 null）
  note               String?
  operator           String? // 跟进人
  createdAt          BigInt

  @@index([customerRelationId])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════════
// P0-2 催款分级状态机（缺口 15 · 中度缺失）
// ════════════════════════════════════════════════════════════════════
// 业务语义：逾期账款按账龄分级推进——提醒（d1-30）→ 催款（d31-60）→
//           严催（d61-90）→ 法务准备（d90+），每级对应不同催款函模板、
//           升级动作与责任人（watchdog 自动升级 + 人工升降级留痕）。
// 设计决策：
//   ① 粒度 = 账龄行（客户×币种），scopeKey 锚点与 getAgingReport row key
//     同构（rel:{relationId} 或 name:{customerName} + 币种），升降级/看板
//     均以账龄行为上下文（DR-050-③ 同范式）。
//   ② 双来源合成：stage 为当前生效分级，stageSource 标记来源——
//     auto = watchdog 按账龄五桶自动定级（可升可降，还款后自动回落 none）；
//     manual = 人工钉住（升级=提前严催，降级=客户已承诺还款）。
//     合成规则：manual 钉住期间，账龄自动定级只能向上穿透（aging 证据
//     压过人工降级），避免「账已烂到 90+ 但仍停在提醒档」的失真。
//   ③ DunningRecord.stage 记录动作发生时的分级快照（历史不失真），
//     本表只承载当前态 + 升降级时间戳（留痕走 routeAudit）。
//   ④ P0-1 尾款喂入：末批 finalPaymentDueDate 逾期未结清 → 自动保底
//     reminder 档（watchdog 扫描 OrderShipmentBatch，同一状态机收口）。
// snapshot FK 风格（与全库一致，不加 @relation）。
// 设计真源：docs/design/10-评审与决策/2026-08-25-中度与严重缺失功能开发优先级规划.md P0-2
model DunningProfile {
  id                 String  @id // 格式：DNP__${shortId}
  scopeKey           String // 账龄行锚点：rel:{relationId}:{currency} | name:{customerName}:{currency}
  customerRelationId String? // 客户关联（快照 FK；无 relation 客户为 null）
  customerName       String // 冗余快照
  currency           String // 币种（账龄行粒度）

  // ─── 分级状态机（当前生效态） ───
  stage       String @default("none") // none | reminder(提醒) | firm(催款) | urgent(严催) | legal(法务准备)
  stageSource String @default("auto") // auto（账龄自动定级） | manual（人工钉住）
  stageSince  BigInt // 当前分级生效时间（分级停留时长计时锚点）
  autoStage   String @default("none") // 账龄自动定级快照（watchdog/看板刷新；与 stage 分离避免覆盖人工态）

  // ─── 升降级留痕时间戳（审计明细走 routeAudit） ───
  escalatedAt  BigInt? // 最近一次升级时间
  downgradedAt BigInt? // 最近一次降级时间
  lastScanAt   BigInt? // watchdog 最近扫描时间（扫描轨迹）

  // ─── 责任人（快照；升级通知对象） ───
  ownerName String? // 跟进责任人（人工维护；watchdog 升级通知收件人）

  createdAt BigInt
  updatedAt BigInt

  @@unique([scopeKey]) // 一客户×币种一条主档
  @@index([customerRelationId])
  @@index([stage]) // 分级看板按档归列
}

// ════════════════════════════════════════════════════════════════════
// REQ2-07 历史数据批量迁移 (DR-049)
// ════════════════════════════════════════════════════════════════════
// 设计决策（DR-049，设计文档 §2）：
//   ① 校验与落库两段式：validate 无副作用可反复；commit 自带二次校验
//      （validate→commit 间库内新增重复 → 跳过计 skipped，不硬失败）
//   ② 四类模板列契约（英文 key 表头）：customers/suppliers→Relation、
//      orders→Order（source='data-migration'）、invoices→Invoice；
//      查重双层：文件内 + 库内
//   ③ 跨域独立路由 /api/v1/data-migration（不挂任一业务域）；
//      整批回滚走软删（entityIds 是回滚真源）
// 设计真源：docs/design/04-模块设计/08-设置与后台/Settings-设置/历史数据迁移.md
// ════════════════════════════════════════════════════════════════════

/// 导入批次：entityIds 整批回滚（软删）真源
model ImportBatch {
  id           String   @id // 格式：IMB__${shortId}
  type         String // customers | suppliers | orders | invoices
  fileName     String
  totalRows    Int // 文件数据行数
  importedRows Int // 实际落库行数（valid 且非库内重复）
  skippedRows  Int // 跳过行数（校验错误 + commit 时库内重复）
  entityIds    String[] @default([]) // 本批次创建的实体 id（回滚软删依据）
  status       String   @default("committed") // committed | rolled_back
  rolledBackAt BigInt?
  createdAt    BigInt
  updatedAt    BigInt

  @@index([type])
  @@index([createdAt])
}

model PaymentVoucher {
  id            String @id // 格式：PAY__${shortId}
  voucherNumber String @unique // 业务凭证号（如 PAY-20260615-001）

  // ─── 业务字段 ───
  type String // Receipt(收款) | Disbursement(付款)

  // ============ 凭证分类（P0-9；DR-022 三类费用归入）============
  /// normal(常规) | advance(预收款，DR-019) | deposit(保证金)
  /// | sample_express(样品快递费，默认计入内部运营成本)
  /// | customer_reimburse(客户报销费用，对应 OrderProfitSheet.costBreakdown 三档)
  /// | business_cost(业务成本/招待费/佣金等)
  /// 设计真源：财务域模型组.md §2.2 / 订单利润表生成.md §8 三类费用
  voucherCategory String @default("normal")

  amount        Decimal @db.Decimal(18, 4) // 凭证金额（实际入/出账金额，已扣手续费前）
  currency      String // USD | CNY | EUR | HKD ...
  paymentDate   String // 实际收/付款日 YYYY-MM-DD
  paymentMethod String // TT | LC | OA | DP | DA | Cash | Other
  status        String  @default("unreconciled") // unreconciled(未核销) | partially_reconciled(部分核销) | reconciled(已核销)
  bankFee       Decimal @default(0) @db.Decimal(18, 4) // 银行手续费（与 amount 同币种）
  /// ★ 银行手续费承担方（KB-1.7 / 口径 D7-③）：OUR(汇款方承担) | BEN(收款方承担，从款里扣) | SHA(双方各自承担)
  ///   null = 未标注 —— 不得猜测；未标注时按 D7-① 处理（手续费一律单列成本项）
  feeBearer     String?

  // ─── 汇率快照 ───
  exchangeRate Decimal? @db.Decimal(18, 4) // 实际收/付款日 currency → baseCurrency 汇率
  baseCurrency String   @default("CNY")

  // ─── 核销信息 ───
  invoiceId     String? // 核销的发票（settlesInvoice linkKind）；为空表示"未核销/暂挂账"
  appliedAmount Decimal? @db.Decimal(18, 4) // 本笔凭证实际核销发票多少钱（可能 < amount，余款挂账）

  // ─── 关联（snapshot FK） ───
  orderId            String? // 冗余：直接关联订单（aboutOrder linkKind），便于按订单聚合资金流
  customerRelationId String? // 交易对象（billTo linkKind）
  customerName       String? // 冗余快照

  // Real company cash source; legacy unassigned vouchers stay null.
  companyAccountId String?
  cashEntryId String? @unique
  companyAccount CompanyCashAccount? @relation(fields: [companyAccountId], references: [id], onDelete: Restrict)
  cashEntry CashAccountEntry? @relation("VoucherCashPointer", fields: [cashEntryId], references: [id], onDelete: Restrict)
  cashSourceEntry CashAccountEntry? @relation("CashVoucherSource")

  // ─── 备注 / 附件 ───
  notes       String?
  attachments Json?

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  // ─── Phase 1-03 财务域升级：行级权限 ───
  ownerId      String?
  departmentId String?

  cashRefund CreditNoteRefund? @relation("CashRefundVoucher")
  cashRefundSettlements CreditNoteSettlementEvent[] @relation("CashRefundSettlementVoucher")
  cashRefundReturnSources CreditNoteRefundReturn[] @relation("CashRefundReturnSourceVoucher")
  cashRefundReturnReceipt CreditNoteRefundReturn? @relation("CashRefundReturnReceiptVoucher")

  @@index([type])
  @@index([status])
  @@index([invoiceId])
  @@index([orderId])
  @@index([customerRelationId])
  @@index([voucherNumber])
  @@index([paymentDate])
  @@index([ownerId])
  @@index([departmentId])
  @@index([companyAccountId])
}

/// Current explicit company-account authority. Currency never changes.
model CompanyCashAccount {
  id String @id
  name String
  companyName String
  companyRelationId String?
  currency String
  bankName String
  accountName String
  accountNumberMasked String
  branch String?
  status String @default("Active")
  ownerId String?
  teamId String?
  departmentId String?
  allowedUserIds Json
  revision Int @default(1)
  createdBy String
  createdAt BigInt
  updatedAt BigInt
  entries CashAccountEntry[]
  vouchers PaymentVoucher[]
  commands CashAccountCommandReceipt[]

  @@index([status, currency])
  @@index([ownerId])
  @@index([teamId])
}

/// Immutable actual bank facts. Removal of a voucher never removes cash.
model CashAccountEntry {
  id String @id
  accountId String
  sequence Int
  kind String
  amount Decimal @db.Decimal(18, 4)
  signedAmount Decimal @db.Decimal(18, 4)
  currency String
  occurredDate String
  sourceVoucherId String? @unique
  correctsEntryId String?
  evidence Json
  reason String?
  postedBy String
  postedAt BigInt
  account CompanyCashAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  sourceVoucher PaymentVoucher? @relation("CashVoucherSource", fields: [sourceVoucherId], references: [id], onDelete: Restrict)
  pointedVoucher PaymentVoucher? @relation("VoucherCashPointer")
  correctsEntry CashAccountEntry? @relation("CashEntryCorrection", fields: [correctsEntryId], references: [id], onDelete: Restrict)
  corrections CashAccountEntry[] @relation("CashEntryCorrection")

  @@unique([accountId, sequence])
  @@index([accountId, occurredDate])
  @@index([correctsEntryId])
}

/// Stable original bank command acknowledgement; never recompute on retry.
model CashAccountCommandReceipt {
  id String @id
  actorId String
  operation String
  requestKey String @db.VarChar(36)
  commandHash String @db.VarChar(64)
  accountId String?
  receipt Json
  createdAt BigInt
  account CompanyCashAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, requestKey], map: "CashAccountCommand_actor_operation_key")
  @@index([accountId, createdAt])
}

// ════════════════════════════════════════════════════════════════════
// InvoiceAllocation — 发票核销明细（1:N 销账中间表）
// ════════════════════════════════════════════════════════════════════
// 支持一笔 PaymentVoucher 核销多张 Invoice，或一张 Invoice 被多笔 Voucher 核销。
// 替代 PaymentVoucher.appliedAmount 的单 1:1 表达（后者保留作为"主核销"快照，向后兼容）。
// 语义：硬删除（无 deletedAt）——核销调整时先 delete 旧明细再 insert 新明细，避免软删+unique 冲突。
// ════════════════════════════════════════════════════════════════════
model InvoiceAllocation {
  id            String  @id // 格式：ALLOC__${shortId}
  invoiceId     String // 核销的发票
  voucherId     String // 核销的凭证
  appliedAmount Decimal @db.Decimal(18, 4) // 本笔核销金额
  appliedDate   String // 核销日期 YYYY-MM-DD
  createdAt     BigInt
  updatedAt     BigInt

  @@unique([invoiceId, voucherId]) // 一对 invoice-voucher 只能有一条明细（硬删除，调整=delete+insert）
  @@index([invoiceId])
  @@index([voucherId])
}

// ════════════════════════════════════════════════════════════════════
// CreditNoteAllocation — 贷项票（CN）抵扣发票核销明细（A3 少收销账闭环）
// ════════════════════════════════════════════════════════════════════
// 为什么不写 InvoiceAllocation：InvoiceAllocation.voucherId 必填且在唯一键内，
// 语义 = 收款凭证核销（15+ 消费方按「真金流水」读它）—— 贷项票没有凭证，
// 伪造 voucherId 会让收款/对账/现金流类消费方把折让当成收进来的钱（静默错账）。
// 语义：硬删除（无 deletedAt）—— 与 InvoiceAllocation 同范（反核销=二期，作废只放行未核销单）。
// 口径：发票「已核销总额」= ΣInvoiceAllocation（收款）+ ΣCreditNoteAllocation（折让），
//   真源在 finance/allocationService.sumAppliedAmount —— 发票据此可到 Paid，
//   从 openReceivable（未结清应收）退出，账龄/催办/授信随之归位。
// ════════════════════════════════════════════════════════════════════
model CreditNoteAllocation {
  id            String  @id // 格式：CNA__${creditNoteId}__${invoiceId}
  creditNoteId  String // 核销的退款单（CreditNote.id）
  invoiceId     String // 被抵扣的发票
  appliedAmount Decimal @db.Decimal(18, 4) // 本笔抵扣金额
  appliedDate   String // 抵扣日期 YYYY-MM-DD
  createdAt     BigInt
  updatedAt     BigInt

  @@unique([creditNoteId, invoiceId]) // 一对 CN-invoice 只能有一条明细（多次核销=upsert 覆盖）
  @@index([invoiceId])
  @@index([creditNoteId])
}

// ════════════════════════════════════════════════════════════════════
// FxSettlement — 结汇水单（F2 外汇核销闭环核心）
// ════════════════════════════════════════════════════════════════════
// 业务语义：收款凭证（PaymentVoucher type=Receipt，外币）→ 银行结汇 → 人民币入账。
//   - 一笔外币收款可分次结汇（1 voucher : N settlements），核销余额 = voucher.amount - Σsettlements.foreignAmount
//   - cnyAmount 由服务端按 foreignAmount × fxRate 计算（round4），不接受客户端传入（防篡改）
//   - 汇兑损益线索：voucher.exchangeRate（收款日快照）vs settlement.fxRate（结汇日实际）
//   - 软删（deletedAt），删除即回滚核销余额（无独立状态机——水单是事实记录）
// ════════════════════════════════════════════════════════════════════
model FxSettlement {
  id               String @id // 格式：FXS__${shortId}
  settlementNumber String @unique // 结汇水单号（如 FXS-20260808-001）

  // ─── 核销关联（snapshot FK） ───
  voucherId          String // 关联收款凭证（settlesVoucher linkKind）
  orderId            String? // 冗余关联订单（aboutOrder linkKind），便于按订单聚合
  customerRelationId String? // 交易对象（billTo linkKind）

  // ─── 结汇信息 ───
  settleDate    String // 结汇日期 YYYY-MM-DD
  foreignAmount Decimal @db.Decimal(18, 4) // 结汇外币金额（≤ 凭证未结汇余额，币种须与凭证一致）
  currency      String // 外币币种（与凭证币种一致；CNY 凭证无结汇语义，fail closed）
  fxRate        Decimal @db.Decimal(18, 8) // 结汇汇率（外币 → CNY）
  cnyAmount     Decimal @db.Decimal(18, 4) // 折合人民币（服务端计算 = foreignAmount × fxRate）

  // ─── 银行信息 ───
  bank       String? // 结汇银行
  slipNumber String? // 银行水单号

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([voucherId])
  @@index([orderId])
  @@index([customerRelationId])
  @@index([settleDate])
}

// ════════════════════════════════════════════════════════════════════
// OutwardRemittance — 付汇水单（阶段 C6，镜像 FxSettlement 付款侧）
// ════════════════════════════════════════════════════════════════════
// 业务语义：付款凭证（PaymentVoucher type=Disbursement，外币）→ 银行购汇/自有外汇 → 境外付汇。
//   - 一笔外币付款可分次付汇（1 voucher : N remittances），未付余额 = voucher.amount - Σremittances.foreignAmount
//   - cnyAmount 由服务端按 foreignAmount × fxRate 计算（round4），不接受客户端传入（防篡改）
//   - CNY 凭证无付汇语义（fail closed）；Receipt 凭证走 FxSettlement 结汇路径
//   - 软删（deletedAt），删除即回滚未付余额（无独立状态机——水单是事实记录）
// ════════════════════════════════════════════════════════════════════
model OutwardRemittance {
  id               String @id // 格式：OWR__${shortId}
  remittanceNumber String @unique // 付汇水单号（如 OWR-20260808-001）

  // ─── 核销关联（snapshot FK） ───
  voucherId          String // 关联付款凭证（paysVoucher linkKind）
  orderId            String? // 冗余关联订单（aboutOrder linkKind），便于按订单聚合
  customerRelationId String? // 交易对象（billTo linkKind）

  // ─── 付汇信息 ───
  remitDate     String // 付汇日期 YYYY-MM-DD
  foreignAmount Decimal @db.Decimal(18, 4) // 付汇外币金额（≤ 凭证未付余额，币种须与凭证一致）
  currency      String // 外币币种（与凭证币种一致；CNY 凭证无付汇语义，fail closed）
  fxRate        Decimal @db.Decimal(18, 8) // 购汇汇率（外币 → CNY）
  cnyAmount     Decimal @db.Decimal(18, 4) // 折合人民币（服务端计算 = foreignAmount × fxRate）

  // ─── 境外收款方 ───
  payeeName  String? // 收款人名称
  payeeBank  String? // 收款行
  payeeSwift String? // SWIFT 代码
  purpose    String? // GoodsPayment(货款) | Freight(运费) | Insurance(保费) | Commission(佣金) | Other

  // ─── 银行信息 ───
  bank       String? // 付汇银行
  slipNumber String? // 银行水单号

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([voucherId])
  @@index([orderId])
  @@index([customerRelationId])
  @@index([remitDate])
}

// ════════════════════════════════════════════════════════════════════
// VatInvoice — 增值税发票（阶段 C6，退税合规硬前提）
// ════════════════════════════════════════════════════════════════════
// 业务语义：外贸企业「免退」办法下，出口退税 = 进项专票注明金额 × 退税率，
//   无增值税专用发票无退税。本模型管理专票全生命周期：
//   收票(Received) → 勾选认证(Verified) → 申报退税(Declared) → 红冲(RedFlushed) / 作废(Cancelled)
// 设计决策：
//   - 金额三栏服务端校验：totalAmount == round4(netAmount + taxAmount) 精确一致；
//     taxAmount vs round4(netAmount × taxRate/100) 容差 0.02（开票尾差）
//   - 退税联动：→Declared 强制 direction=Input + invoiceType=Special + taxRefundId 有效（未软删）
//   - 唯一性：(vatCode, vatNumber) 复合唯一；全电票 vatCode 为 NULL（PG NULL 不参与唯一冲突），
//     由应用层事务内查重兜底（fail closed）
//   - 红冲/作废为终态；Declared 不可删除（税务留痕），仅可红冲
// ════════════════════════════════════════════════════════════════════
model VatInvoice {
  id String @id // 格式：VAT__${shortId}

  // ─── 税务标识 ───
  vatCode   String? // 发票代码（纸质 10/12 位；全电票无代码）
  vatNumber String // 发票号码（纸质 8 位；全电票 20 位）

  // ─── 类型/状态 ───
  direction   String @default("Input") // Input(进项-采购取得) | Output(销项-内销开出)
  invoiceType String @default("Special") // Special(专票) | Normal(普票)
  status      String @default("Received") // Received | Verified | Declared | RedFlushed | Cancelled

  // ─── 开票方/受票方 ───
  sellerName  String // 销售方名称
  sellerTaxNo String? // 销售方纳税人识别号
  buyerName   String // 购买方名称
  buyerTaxNo  String? // 购买方纳税人识别号

  // ─── 金额（专票三栏拆分） ───
  issueDate   String // 开票日期 YYYY-MM-DD
  netAmount   Decimal @db.Decimal(18, 4) // 不含税金额
  taxRate     Decimal @db.Decimal(6, 4) // 税率(%)，如 13.0000
  taxAmount   Decimal @db.Decimal(18, 4) // 税额
  totalAmount Decimal @db.Decimal(18, 4) // 价税合计 = netAmount + taxAmount
  currency    String  @default("CNY")

  // ─── 认证/勾选 ───
  verifiedDate    String? // 勾选认证日期 YYYY-MM-DD
  deductionPeriod String? // 勾选所属期 YYYY-MM

  // ─── 退税联动 ───
  taxRefundId String? // 关联退税申报（→Declared 必填；declaredInRefund linkKind）

  // ─── 红冲 ───
  redFlushNumber String? // 红字发票号码
  redFlushDate   String? // 红冲日期 YYYY-MM-DD

  // ─── 关联（snapshot FK） ───
  invoiceId  String? // 关联业务发票（应付/应收 Invoice；settlesInvoice linkKind）
  orderId    String? // 关联订单（aboutOrder linkKind）
  relationId String? // 供应商/客户（billTo linkKind）

  // ─── 备注 / 附件 ───
  notes       String?
  attachments Json?

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@unique([vatCode, vatNumber])
  @@index([status])
  @@index([direction])
  @@index([relationId])
  @@index([taxRefundId])
  @@index([invoiceId])
  @@index([issueDate])
}

// ════════════════════════════════════════════════════════════════════
// Shipping Module — 货运与报关
// ════════════════════════════════════════════════════════════════════
// 设计决策：
//   - 金额字段统一 Decimal(18,4) — 第一个 Decimal-first 新模型，
//     旧模块金额字段已同步迁移至 Decimal（Phase 3 完成）。
//   - 重量/体积用 Decimal(12,3)，精度到克/cm³。
//   - 业务日期用 String YYYY-MM-DD，时间戳用 BigInt epoch ms —— 与 Finance 一致。
//   - Relation 关联用 snapshot FK 风格，不加 @relation。
//   - ShipmentLine 代表运单下的装箱明细行（1运单:N行），
//     每行关连 OrderLine（loadedWith linkKind）。
// ════════════════════════════════════════════════════════════════════

model Shipment {
  id             String @id // 格式：SHP__${shortId}
  shipmentNumber String @unique // 运单号（如 SHP-20260615-001）

  // ─── 业务字段 ───
  type           String // Export(出口) | Import(进口) | Domestic(内贸)
  status         String // Draft(草稿) | Booked(已订舱) | Loading(装货中) | Shipped(已发运) | Arrived(已到港) | Cleared(已清关) | Delivered(已交付) | Cancelled(已取消)
  shippingMethod String // Sea(海运) | Air(空运) | Land(陆运) | Rail(铁运) | Courier(快递)
  /// ★ D1 拼柜（2026-09-30）：装载方式 FCL(整柜) | LCL(拼柜)；**可空 = 未录**（不是 FCL）。
  ///   与 `shippingMethod` **正交**：一票可以是 Sea+LCL，也可以是 Sea+FCL ⇒
  ///   绝不把 FCL/LCL 塞进 shippingMethod 枚举（矩阵点名 manifest.ts:537 那个示例是错的）。
  loadType       String?

  // ─── 日期 ───
  bookingDate String? // 订舱日期 YYYY-MM-DD
  etd         String? // 预计离港日 Estimated Time of Departure
  atd         String? // 实际离港日 Actual Time of Departure
  eta         String? // 预计到港日 Estimated Time of Arrival
  ata         String? // 实际到港日 Actual Time of Arrival

  // ─── 运输信息 ───
  vesselOrFlight     String? // 船名/航班号
  voyageNumber       String? // 航次号
  portOfLoading      String? // 装货港
  portOfDischarge    String? // 卸货港
  containerNumber    String? // 集装箱号
  sealNumber         String? // 封条号
  trackingNumber     String? // C4：物流跟踪号（快递单号/集装箱跟踪号）
  carrierTrackingUrl String? // C4：承运商跟踪查询链接（前端跳转，不内置外部 API）

  // ─── 重量/体积 ───
  totalPackages    Int? // 总件数
  grossWeight      Decimal? @db.Decimal(12, 3) // 毛重(kg)
  netWeight        Decimal? @db.Decimal(12, 3) // 净重(kg)
  volume           Decimal? @db.Decimal(12, 3) // 体积(CBM)
  // ★ 2026-09-29：计费重量。客户 PO 的规则是「不足 20 公斤按体积重算」，
  //   但使用方决定（J-3）「只存字段，不自动算」⇒ 本列只承载人工填的值，不实现任何折算逻辑。
  chargeableWeight Decimal? @db.Decimal(12, 3) // 计费重量(kg)，人工填，不自动折算

  // ─── 费用（Decimal-first） ───
  freightAmount        Decimal? @db.Decimal(18, 4) // 运费
  freightCurrency      String? // 运费币种
  insuranceAmount      Decimal? @db.Decimal(18, 4) // 保险费
  insuranceCurrency    String? // 保险费币种
  customsAmount        Decimal? @db.Decimal(18, 4) // 报关费
  customsCurrency      String? // 报关费币种
  otherCharges         Decimal? @db.Decimal(18, 4) // 其他费用
  otherChargesCurrency String? // 其他费用币种

  // ─── 关联（snapshot FK） ───
  // DR-016：orderId 降级为投影字段，由服务层从分配表首条派生维护，非直接真源
  orderId            String? // 投影：主订单（分配表首条 orderId）
  businessLine       String? // 品类下沉（D8-Q3 拍板：fabric | garment | capsule | other；由订单 businessLine 派生回填，合票同业务线由服务层校验保证一致）
  customerRelationId String? // 开票对象 billTo（保持语义不变，DR-016 明确）
  customerName       String? // 冗余快照
  carrierRelationId  String? // 货代/船公司（shipsVia linkKind）
  carrierName        String? // 冗余快照

  // ─── DR-016 四方交易方（均 snapshot FK → Relation，逐步迁移） ───
  consigneeRelationId    String? // 收货方/目的工厂（consignee linkKind）
  consigneeName          String? // 冗余快照
  docRecipientRelationId String? // 单证收件方（docRecipient linkKind）
  docRecipientName       String? // 冗余快照
  payerRelationId        String? // 实际付款方（payer linkKind）
  payerName              String? // 冗余快照

  // ─── T6-a 订舱段（H12，2026-09-16 设计稿拍板建议：订舱号不唯一——并舱 = 多票同号） ───
  bookingNo        String? // 订舱号（我方/货代侧）
  soNumber         String? // 船公司 SO（Shipping Order）
  spaceConfirmedAt BigInt? // 舱位确认时间（epoch ms；null=未确认）
  cutOffAt         String? // 截关时间（YYYY-MM-DD HH:mm）
  docCutOffAt      String? // 截单时间（YYYY-MM-DD HH:mm）
  billOfLadingNo   String? // 海运 B/L 号
  masterBillNo     String? // 空运 MAWB（航司→货代）
  houseBillNo      String? // 空运 HAWB（货代→发货人）

  // ─── 报关 ───
  hsCode                   String? // 海关HS编码（统一编码，行级在 ShipmentLine）
  customsBroker            String? // 报关行
  customsDeclarationNumber String? // 报关单号
  customsClearanceDate     String? // 清关日期
  /// 系统外出口申报的完成事实（不复用 CustomsDeclaration 本地模拟状态机）。
  exportDeclarationCompletedAt       String? // 完成时间 ISO-8601；只有凭证归档后可写
  exportDeclarationReference         String? // 外部申报编号（如适用）
  exportDeclarationEvidenceDocumentId String? // TradeDocument.id；必须是本运单的 ExportDeclarationProof 且有已校验归档版本

  // ─── 备注 / 附件 ───
  notes       String?
  attachments Json?

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([type])
  @@index([status])
  @@index([orderId])
  @@index([customerRelationId])
  @@index([carrierRelationId])
  @@index([shipmentNumber])
  @@index([etd])
  @@index([exportDeclarationEvidenceDocumentId])
}

// ════════════════════════════════════════════════════════════════════
// T6-b 陆运段（H12/D4 拍板 3，2026-09-16 设计稿）：工厂 → 货代仓一程的约定与实绩 + 费用采集
// 边界（D8-Q3/T3）：货代仓不建库存账（受托保管非自有仓），进仓=实际送达时刻的时间线记录；
// 费用列只采集——进毛利的 Incoterms 分支与 CIF 运费切换是同一刀（见 T2 回报 ❓1），本批不切。
model ShipmentLandTransport {
  id                    String   @id // 格式：SLT__${shortId}
  shipmentId            String   @unique // 一票一段（upsert 语义）；多段需求出现时再降级为普通 FK
  direction             String   @default("factory_to_forwarder") // 本批只用默认方向；预留 forwarder_to_port 等
  plannedArrivalAt      String? // 约定运抵货代仓时间（YYYY-MM-DD HH:mm）
  actualDeliveredAt     String? // 实际送达（= 进仓时刻）
  plateNo               String? // 车牌
  driverName            String? // 司机
  driverPhone           String? // 司机电话
  carrierName           String? // 车队/承运商（冗余快照）
  inlandFreightAmount   Decimal? @db.Decimal(18, 4) // 陆运费（FOB 进成本 / CIF 走应收——口径切换未拍板，先采集）
  inlandFreightCurrency String?
  warehouseFeeAmount    Decimal? @db.Decimal(18, 4) // 进仓费
  warehouseFeeCurrency  String?
  notes                 String?
  createdAt             BigInt
  updatedAt             BigInt

  @@index([shipmentId])
}

model ShipmentLine {
  id         String @id // 格式：SHPL__${shortId}
  shipmentId String // 所属运单

  // ─── 行号 ───
  lineNumber Int

  // ─── 关联订单明细行 ───
  orderLineId String? // 关联 OrderLine（loadedWith linkKind）

  // ─── 产品信息（冗余快照，从 OrderLine 带出） ───
  productCode String?
  productName String?
  colorCode   String?
  quantity    Decimal? @db.Decimal(18, 4) // C4：Int→Decimal（面料米数/码数含小数；模型此前无写路径，零存量行，安全变更）
  unit        String? // e.g. "m", "yd", "kg", "pcs"

  // ─── 箱规/包装 ───
  cartons     Int? // 箱数
  grossWeight Decimal? @db.Decimal(12, 3) // 毛重(kg)
  netWeight   Decimal? @db.Decimal(12, 3) // 净重(kg)
  volume      Decimal? @db.Decimal(12, 3) // 体积(CBM)

  // ─── 海关 ───
  hsCode          String? // 行级HS编码（可能与运单级不同）
  countryOfOrigin String? // 原产地

  // ─── 时间戳 ───
  createdAt BigInt
  updatedAt BigInt

  @@index([shipmentId])
  @@index([orderLineId])
}

// ShipmentOrderAllocation：订单↔出运多对多分配记录（DR-016 合票建模）
// 业务规则：
//   - 一单拆多票 + 一票合多单：每个订单参与某票出运须有独立分配记录
//   - 合票边界：仅同业务线 + 同一签约客户允许合票（服务层校验）
//   - 数量上限：跨票累计实际出运量 ≤ 订单可出运量（服务层校验）
//   - 门禁：按每个来源订单分配逐项核验 QC/S/S/RC，整票不合格
// 设计原则：
//   - snapshot FK 风格，不加 @relation（与全库一致）
//   - 无软删：随 Shipment 软删过滤（Shipment.deletedAt IS NULL 才有效）
//   - orderLineId 为 null 表示订单级整单分配（未细化到行）
model ShipmentOrderAllocation {
  id          String  @id // 格式：SHPA__${shortId}
  shipmentId  String // 所属票（snapshot FK → Shipment.id）
  orderId     String // 来源订单（snapshot FK → Order.id）
  orderLineId String? // 来源订单行（行级分配时填；订单级整单分配为 null）

  // ─── 数量 ───
  plannedQty Decimal? @db.Decimal(18, 4) // 计划出运数量
  actualQty  Decimal? @db.Decimal(18, 4) // 实际出运数量（发货确认后回填）
  unit       String? // 单位快照（m/yd/kg/pcs）

  // ─── 状态 ───
  status            String // Planned | PartiallyShipped | Fulfilled | ShortShipped | Cancelled
  batchOrCartonNote String? // 批次/箱号备注（如适用）
  exception         String? // 异常说明（短装/溢装原因）

  // ─── 时间戳 ───
  createdAt BigInt
  updatedAt BigInt

  @@unique([shipmentId, orderId, orderLineId]) // 同票同订单行不重复分配
  @@index([shipmentId])
  @@index([orderId])
  @@index([orderLineId])
  @@index([status])
}

// ════════════════════════════════════════════════════════════════════
// 订单出运批次·财务结算主档（P0-1 分批出运与尾款结算）
// ════════════════════════════════════════════════════════════════════
// 业务语义：大货订单按船期分 2~N 批出运（如首批 60% + 末批 40%），每批独立
//           开票、独立收款、末批挂钩尾款结算。本模型是「订单视角的批次」：
//           接单后即建计划（此时未排船），排船后回填 shipmentId，开票经
//           InvoiceOrderAllocation.batchId 归属到批，收款经 InvoiceAllocation
//           联聚出批次结算进度。
// 设计决策：
//   ① 与 ShipmentOrderAllocation 的分工：物理侧（一票运了哪些单多少货，票视角）
//     已由 DR-016 承载不动；本模型补财务侧（一批结算多少钱、开票归属、尾款状态），
//     计划期先于排船存在，shipmentId 可空。
//   ② 双状态机正交：status = 出运维度生命周期（planned→shipped→cancelled）；
//     settleStatus = 财务维度（unsettled→partially_settled→settled），互不覆盖。
//   ③ 结算进度快照（invoicedAmount/paidAmount）由服务层从分配/核销表聚合回写，
//     供列表与尾款 watchdog 免聚合查询（快照留痕与 DunningRecord 同范式）。
//   ④ 尾款锚点：isFinalBatch 标记末批；finalPaymentDueDate = 末批发运日 + 账期
//     （账期优先取本批覆盖值，缺省推导自订单 paymentTerms），watchdog 按此扫描。
// snapshot FK 风格（与全库一致，不加 @relation），软删。
// 设计真源：docs/design/10-评审与决策/2026-08-25-中度与严重缺失功能开发优先级规划.md P0-1
model OrderShipmentBatch {
  id         String  @id // 格式：OSB__${shortId}
  orderId    String // 所属订单（snapshot FK → Order.id）
  shipmentId String? // 排船后回填（snapshot FK → Shipment.id；计划期未排船为 null）
  batchNo    Int // 批次序号（订单内 1,2,3…，与 orderId 联合唯一）

  // ─── 批次计划（接单后即可建立） ───
  plannedRatio Decimal? @db.Decimal(5, 2) // 计划占比 %（如 60.00；与 plannedQty/amount 可只填其一）
  plannedQty   Decimal? @db.Decimal(18, 4) // 计划数量快照（米/码/件；实际出运以 ShipmentOrderAllocation 为真源）
  unit         String? // 单位快照（m/yd/kg/pcs）
  amount       Decimal? @db.Decimal(18, 4) // 本批计划结算金额（缺省由订单额 × plannedRatio 推导，手工可覆盖）
  currency     String // 币种快照（随订单销售币种，如 USD）

  // ─── 客户快照（watchdog 催款联动免 join） ───
  customerRelationId String? // 结算客户（snapshot FK → Relation.id）
  customerName       String? // 冗余快照

  // ─── 出运维度生命周期 ───
  status    String  @default("planned") // planned(计划) | shipped(已出运) | cancelled(已取消)
  shippedAt BigInt? // 本批发运时间（回填自 Shipment.atd/updatedAt）

  // ─── 财务维度结算状态机 ───
  settleStatus   String   @default("unsettled") // unsettled(未结算) | partially_settled(部分结算) | settled(已结清)
  invoicedAmount Decimal? @db.Decimal(18, 4) // 已开票金额快照（服务层从 InvoiceOrderAllocation.batchId 聚合回写）
  paidAmount     Decimal? @db.Decimal(18, 4) // 已收款金额快照（服务层经 InvoiceAllocation 联聚回写）
  settledAt      BigInt? // 批次金额全额结清时间戳

  // ─── 尾款（末批锚点） ───
  isFinalBatch        Boolean @default(false) // 末批标记（尾款结算锚点；同订单至多一批为 true，服务层校验）
  finalPaymentDueDays Int? // 尾款账期天数覆盖值（缺省推导自订单 paymentTerms）
  finalPaymentDueDate String? // 尾款到期日 YYYY-MM-DD（末批发运日 + 账期，服务层计算；watchdog 扫描锚点）

  // ─── 备注 ───
  notes String?

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@unique([orderId, batchNo]) // 同订单批次序号不重复
  @@index([orderId])
  @@index([shipmentId])
  @@index([status])
  @@index([settleStatus])
  @@index([customerRelationId])
  @@index([finalPaymentDueDate]) // 尾款 watchdog 扫描
}

// ShipmentEvent：运单物流节点事件（F3 lifecycle 深化）
// 每次状态机转换在事务内追加一条节点事件，形成可回溯的
// 订舱→装货→发运→到港→清关→交付 物流时间轴（独立于通用 auditLog，
// 面向业务查询与前端时间轴渲染；append-only，无软删）。
model ShipmentEvent {
  id         String @id // 格式：SHPE__${shortId}
  shipmentId String // 关联运单

  // ─── 节点信息 ───
  fromNode String? // 上一节点（首节点为 null）
  toNode   String // 到达节点（取值与运单状态一致：Draft | Booked | Loading | Shipped | Arrived | Cleared | Delivered | Cancelled）

  eventDate String // 节点业务日期 YYYY-MM-DD（优先取对应业务日期：Shipped→atd / Arrived→ata / Cleared→清关日 / Booked→订舱日，兜底当日）
  note      String? // 节点备注（船名航次 / 异常说明等）
  actorId   String? // 操作人

  createdAt BigInt

  @@index([shipmentId])
  @@index([toNode])
}

/// Durable business-to-logistics handoff for a shipment. This lifecycle is
/// intentionally independent from Shipment.status and never records actual
/// shipment / departure facts.
model ShipmentHandoff {
  id                   String  @id // SHH__${shortId}
  shipmentId           String  @unique // Existing physical Shipment; no parallel shipment identity
  status               String  // PendingLogistics | Processing | NeedsBusinessDecision | ReturnedToBusiness | Cancelled
  businessActorId      String  // Person who submitted this handoff
  logisticsActorId     String? // First logistics operator who started processing
  requestKey           String? // Optional client retry key, scoped to businessActorId
  commandHash          String? // Canonical submitted intent for safe retry detection
  note                 String?
  discrepancyReason    String?
  businessResponse     String?
  returnedToBusinessAt BigInt?
  businessRespondedAt  BigInt?
  completedAt          BigInt?
  createdAt            BigInt
  updatedAt            BigInt

  @@unique([businessActorId, requestKey])
  @@index([status, createdAt])
  @@index([businessActorId, createdAt])
}

/// Immutable source snapshot for each existing ShipmentOrderAllocation in a
/// handoff. A single SOA can have several lines here when its order line is
/// split across multiple factory ProductionBatches.
model ShipmentHandoffLine {
  id                      String  @id // SHHL__${shortId}
  handoffId               String
  allocationId            String  // ShipmentOrderAllocation.id; deliberately not unique
  orderId                 String
  orderLineId             String
  productionBatchId       String
  productionBatchRevision Int
  factoryRelationId       String
  factoryName             String?
  scopeFingerprint        String
  partialShipmentAllowed Boolean?
  requiredSampleFamilies Json?
  eligibilityFingerprint  String?
  plannedQty              Decimal @db.Decimal(18, 4)
  unit                    String
  createdAt               BigInt

  @@index([handoffId])
  @@index([allocationId])
  @@index([orderId, orderLineId])
  @@index([productionBatchId, productionBatchRevision])
  @@index([factoryRelationId])
}

/// Append-only audit trail for the handoff state machine. It does not reuse
/// ShipmentEvent, whose nodes represent physical transport status.
model ShipmentHandoffEvent {
  id         String  @id // SHHE__${shortId}
  handoffId  String
  requestKey String? // Idempotency receipt for business cancel/departure commands
  commandHash String? // Binds retries to the exact command body
  fromStatus String?
  toStatus   String
  actorId    String
  note       String?
  decision   String? // accept_actual | revise_plan | cancel for business decisions
  payload    Json?   // Immutable exact decision facts; does not replace the original plan snapshot.
  createdAt  BigInt

  @@index([handoffId, createdAt])
  @@index([actorId, createdAt])
  @@unique([handoffId, requestKey])
}

// ShipmentCarton：逐箱装箱明细（C4 发货深化）
// 行级 ShipmentLine 回答「发什么货」，逐箱回答「每个箱子装了什么/多重/多大」：
// 装箱单（PL）按 C/NO 逐箱列示是外贸刚需，混装经 ShipmentCartonItem 分配数量。
// 汇总口径：运单 totalPackages/grossWeight/netWeight/volume 在有箱时由箱级派生
// （服务层重算写回），无箱有行时由行级派生，两者皆无保持手工录入。
model ShipmentCarton {
  id         String @id // 格式：SHPC__${shortId}
  shipmentId String // 所属运单（snapshot FK）

  cartonNo    String // 箱号（如 "1" / "1-60"，展示用字符串）
  description String? // 箱内货物描述（混装摘要，可空）

  // ─── 尺寸/重量/体积 ───
  length      Decimal? @db.Decimal(10, 2) // 长(cm)
  width       Decimal? @db.Decimal(10, 2) // 宽(cm)
  height      Decimal? @db.Decimal(10, 2) // 高(cm)
  grossWeight Decimal? @db.Decimal(12, 3) // 毛重(kg)
  netWeight   Decimal? @db.Decimal(12, 3) // 净重(kg)
  volume      Decimal? @db.Decimal(12, 4) // 体积(CBM)；三尺寸齐全且缺省时由服务层推导

  createdAt BigInt
  updatedAt BigInt

  items ShipmentCartonItem[]

  @@index([shipmentId])
}

// ShipmentCartonItem：箱内货物分配（混装支持）
// 同一 (cartonId, shipmentLineId) 唯一；服务层校验每行累计分配量 ≤ 行数量。
model ShipmentCartonItem {
  id             String  @id // 格式：SHPCI__${shortId}
  cartonId       String
  shipmentLineId String // 关联 ShipmentLine（snapshot FK，行删除由服务层清理）
  quantity       Decimal @db.Decimal(18, 4) // 该行在此箱中的数量

  createdAt BigInt
  updatedAt BigInt

  carton ShipmentCarton @relation(fields: [cartonId], references: [id], onDelete: Cascade)

  @@unique([cartonId, shipmentLineId])
  @@index([shipmentLineId])
}

// ════════════════════════════════════════════════════════════════════
// End of Shipping Module
// ════════════════════════════════════════════════════════════════════

// ════════════════════════════════════════════════════════════════════
// Production Pipeline Module — 大货十阶段生产管线 (Phase 1-2)
// ════════════════════════════════════════════════════════════════════
// 业务规定: 10 阶段门禁式推进
//   ① order_placed → ② materials_confirmed → ③ production_planned
//   → ④ in_production → ⑤ materials_arrived → ⑥ pre_cut_checked
//   → ⑦ pp_sample_approved → ⑧ manufacturing → ⑨ final_review
//   → ⑩ qc_shipped
// 门禁: ⑥ 需 PreCutChecklist 四项全 true; ⑦ 需双签;
//       ⑩ 需验货 passRate≥90% + defectRate≤3% + 业务部批准
// ════════════════════════════════════════════════════════════════════

model ProductionStage {
  id        String  @id // 格式: PST__${orderId}__${stageKey}
  orderId   String
  stageKey  String // order_placed | materials_confirmed | ...
  stageSeq  Int // 1-10 序号
  status    String  @default("pending") // pending | in_progress | done | blocked
  note      String?
  operator  String?
  startedAt BigInt?
  doneAt    BigInt?

  // 双签审批（用于 pp_sample_approved 阶段：生产部+业务部双签）
  signedByProduction String?
  signedByBusiness   String?
  signedAtProduction BigInt?
  signedAtBusiness   BigInt?

  createdAt BigInt
  updatedAt BigInt

  @@unique([orderId, stageKey])
  @@index([orderId])
  @@index([status])
}

// ════════════════════════════════════════════════════════════════════
// DR-053 阶段 2：生产放行范围化（§14 设计真源：样品管理域设计.md §14）
// 按订单行/实际批次确定适用范围；批准证据不可变；失效/暂停追加事件。
// ════════════════════════════════════════════════════════════════════

/// 放行范围（ReleaseScope）：实际生产动作的执行/检查单位。
/// 必须归属有效订单行+工厂；覆盖整行或绑定实际生产批次稳定 ID（拆批后整行退出，
/// 禁止整行与子批次同时有效）。scopeRevision 递增=范围/工厂/规格/批次变化，旧批准不再匹配。
/// Physical production range, independent of whether this item requires PP approval.
/// Source and quantity coordinates are server-frozen facts; state is the current
/// projection of mandatory append-only audit events, never evidence of stock receipt.
model ProductionBatch {
  orderSampleCoverages OrderSampleCoverage[]
  productionCompletions ProductionBatchCompletion[]
  id                  String  @id
  batchCode           String
  orderId             String
  orderLineId         String
  parentBatchId       String?
  factoryRelationId   String
  /// Real business declaration only; null legacy facts remain unknown.
  productionLineId    String?
  productionLineSnapshot Json?
  factoryProductionLine FactoryProductionLine? @relation(fields: [productionLineId], references: [id], onDelete: Restrict)
  rangeStart          Decimal @db.Decimal(18, 4)
  quantity            Decimal @db.Decimal(18, 4)
  /// Garment branch plan by contract size. Null is retained only for legacy
  /// lines without a confirmed size matrix; new matrix-backed branches require it.
  sizeBreakdown       Json?
  unit                String
  revision            Int     @default(1)
  state               String  @default("active") // active | split | cancelled | invalidated
  confirmedSourceType String
  confirmedSourceId   String
  specSnapshot        Json
  sourceFingerprint   String
  requestKey          String
  parameterHash       String
  commandSnapshot     Json
  createdBy           String
  createdAt           BigInt
  updatedAt           BigInt

  stockReceipts ProductionStockReceipt[]

  @@unique([orderLineId, batchCode])
  @@unique([orderLineId, createdBy, requestKey])
  @@index([orderId])
  @@index([orderLineId, state])
  @@index([parentBatchId])
  @@index([productionLineId])
}

/// Actual named line under an existing factory. Factory-single declarations
/// stay on the branch and never create a virtual master line.
model FactoryProductionLine {
  id                String @id
  factoryRelationId String
  name              String
  location          String?
  state             String @default("active")
  revision          Int @default(1)
  requestKey        String
  parameterHash     String
  createdBy         String
  createdAt         BigInt
  updatedAt         BigInt
  productionBatches ProductionBatch[]

  @@unique([factoryRelationId, name])
  @@unique([factoryRelationId, createdBy, requestKey], map: "FactoryProductionLine_factory_actor_request_key")
  @@index([factoryRelationId, state])
}

/// Immutable business record that a specific active factory branch finished
/// production at an exact batch revision. It is deliberately separate from
/// ProductionBatch.quantity (planned range) and shipment actual quantities.
model ProductionBatchCompletion {
  id                      String  @id
  productionBatchId       String
  productionBatchRevision Int
  orderId                 String
  orderLineId             String
  actualQuantity          Decimal @db.Decimal(18, 4)
  /// Immutable final actual garment quantity by size; null for fabric and legacy no-matrix lines.
  actualSizeBreakdown     Json?
  unit                    String
  lineFingerprint         String
  scopeSnapshot           Json
  requestKey              String
  commandHash             String
  commandSnapshot         Json
  recordedBy              String
  recordedAt              BigInt

  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([productionBatchId, productionBatchRevision])
  @@unique([recordedBy, requestKey])
  @@index([orderId, orderLineId, recordedAt])
  @@index([productionBatchId, productionBatchRevision])
}

/// Immutable native receipt anchors one original physical batch/revision to its
/// dedicated inventory item and actual central Inbound. No approval is implied.
model ProductionStockReceipt {
  id                      String  @id
  productionBatchId       String
  productionBatchRevision Int
  orderId                 String
  orderLineId             String
  warehouseId             String
  inventoryItemId         String  @unique
  stockMovementId         String  @unique
  quantity                Decimal @db.Decimal(18, 4)
  unit                    String
  scopeFingerprint        String
  scopeSnapshot           Json
  movementDate            String
  receiptReference        String
  requestKey              String
  commandHash             String
  commandSnapshot         Json
  receiptSnapshot         Json
  createdBy               String
  createdAt               BigInt

  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  stockMovement   StockMovement   @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)

  @@unique([productionBatchId, createdBy, requestKey])
  @@index([orderId])
  @@index([orderLineId])
  @@index([warehouseId])
}

/// Explicit physical-range coverage of the existing ShipmentOrderAllocation.
/// Planned/actual quantities remain distinct. Released/reversed projections and
/// their original scope snapshots remain available; native changes require audit.
// Immutable logistics verification of goods loaded at a factory. This is a
// physical dispatch proof, not a warehouse receipt or inventory movement.
model FactoryLoadingReceipt {
  id                      String  @id
  handoffId               String
  shipmentId              String
  allocationId            String
  orderId                 String
  orderLineId             String
  productionBatchId       String
  productionBatchRevision Int
  factoryRelationId       String
  scopeFingerprint        String  @db.VarChar(64)
  scopeSnapshot           Json
  quantity                Decimal @db.Decimal(18, 4)
  unit                    String
  loadingDate             String
  reference               String  @db.Text
  createdBy               String
  verifiedAt              BigInt
  createdAt               BigInt
  requestKey              String
  commandHash             String  @db.VarChar(64)
  commandSnapshot         Json
  receiptSnapshot         Json

  @@unique([handoffId, productionBatchId, createdBy, requestKey], map: "FactoryLoadingReceipt_command_key")
  @@index([productionBatchId, productionBatchRevision], map: "FactoryLoadingReceipt_batchRevision_idx")
  @@index([shipmentId])
  @@index([allocationId])
}

model ShipmentProductionAllocation {
  id                      String  @id
  allocationId            String
  shipmentId              String
  orderId                 String
  orderLineId             String
  productionBatchId       String
  productionBatchRevision Int
  plannedQty              Decimal? @db.Decimal(18, 4)
  actualQty               Decimal? @db.Decimal(18, 4)
  unit                    String
  scopeSnapshot           Json
  state                   String   @default("reserved") // reserved | shipped | released | reversed
  createdBy               String
  updatedBy               String
  createdAt               BigInt
  updatedAt               BigInt

  @@unique([allocationId, productionBatchId])
  @@index([shipmentId])
  @@index([orderId])
  @@index([orderLineId])
  @@index([productionBatchId, state])
}

model ReleaseScope {
  id                  String  @id // RS__${shortId}
  orderId             String
  orderLineId         String
  factoryRelationId   String? // 生产工厂（软引用 Relation）
  productionBatchId   String? // 实际生产批次稳定 ID（整行可空；拆批后必填）
  productionBatchRevision Int? // 明确绑定实际 ProductionBatch 修订；历史未知不补造
  quantity            Decimal @db.Decimal(18, 4)
  unit                String? // m / pcs / set 等
  scopeRevision       Int     @default(1)
  /// 当前投影状态（可由事件重建，非历史真源）：no_release | ready | paused | revoked | invalidated
  state               String  @default("no_release")
  // 规格依据（下单确认版本引用 + 快照；审批锁定当前受控规格）
  confirmedSourceType String?
  confirmedSourceId   String?
  specSnapshot        Json?
  currentReleaseId    String? // 当前有效批准引用

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@unique([orderId, orderLineId, productionBatchId])
  @@index([orderId])
  @@index([orderLineId])
  @@index([factoryRelationId])
}

/// 产前样批准（PpSampleRelease）：两角色签字齐备且服务端重验通过后写入。
/// 批准事实禁止覆盖/删除；requestId 唯一；证据快照冻结。
model PpSampleRelease {
  id                 String  @id // REL__${shortId}
  requestId          String  @unique
  scopeId            String
  scopeRevision      Int
  // 双签（不同人员承担；身份来自认证上下文）
  signedByProduction String?
  signedByBusiness   String?
  signedAtProduction BigInt?
  signedAtBusiness   BigInt?
  approvedBy         String
  approvedAt         BigInt
  // 证据快照（冻结：样品引用+轮次+规格摘要）
  sampleId           String?
  sampleRound        Int?
  evidenceSnapshot   Json?
  ruleVersion        String  @default("pp-release-v1")
  notes              String?

  createdAt BigInt

  @@index([scopeId])
  @@index([sampleId])
}

/// 放行请求（ReleaseRequest）：固定本次审批输入（scope 规格依据 + 样品证据修订）。
/// 输入变化作废待签请求，重新发起；requestRevision 防并发漂移。
model ReleaseRequest {
  id               String @id // RRQ__${shortId}
  scopeId          String
  scopeRevision    Int
  evidenceSnapshot Json? // 样品证据修订快照（样品引用+轮次+QC/客户确认摘要）
  specSnapshot     Json? // 订单行受控规格依据快照
  ruleVersion      String @default("pp-release-v1")
  requestRevision  Int    @default(1)
  state            String @default("pending") // pending | granted | rejected | voided
  createdBy        String
  createdAt        BigInt
  updatedAt        BigInt
  rejectedBy       String?
  rejectedAt       BigInt?
  rejectionReason  String? @db.Text
  requestedChanges String? @db.Text

  @@index([scopeId])
}

/// 放行签署（ReleaseSignature）：追加；同请求同角色唯一；两角色由不同人员承担。
model ReleaseSignature {
  id          String  @id // RSG__${shortId}
  requestId   String
  role        String // production | business
  actorId     String
  actorName   String?
  signedAt    BigInt
  inputDigest String? // 签署输入摘要（requestRevision+evidence 摘要）

  @@unique([requestId, role])
  @@index([requestId])
}

/// 放行事件（ReleaseEvent）：append-only，scope 内 sequence 唯一。
/// kind：granted | paused | resumed | revoked | invalidated | superseded。
/// sourceKey 承载触发源幂等键——同一触发不得重复处理。
model ReleaseEvent {
  id         String  @id // REV__${shortId}
  scopeId    String
  sequence   Int
  kind       String
  releaseId  String?
  reason     String?
  actorId    String?
  sourceKey  String?
  occurredAt BigInt
  createdAt  BigInt

  @@unique([scopeId, sequence])
  @@index([scopeId])
  @@index([releaseId])
}

model PreCutChecklist {
  id                   String  @id // 格式: PCL__${orderId}
  orderId              String  @unique
  gradingConfirmed     Boolean @default(false) // 推码确认
  consumptionConfirmed Boolean @default(false) // 耗料确认
  patternConfirmed     Boolean @default(false) // 样板确认
  preProductionMeeting Boolean @default(false) // 产前会议
  meetingNote          String?
  confirmedBy          String?
  confirmedAt          BigInt?

  createdAt BigInt
  updatedAt BigInt

  @@index([orderId])
}

// ════════════════════════════════════════════════════════════════════
// Phase B4 扩展：QC 验货报告（中期 + 终期多份）
//   - (orderId, inspectionType) 复合唯一：每单可有 midline(中期验货) 与
//     final(终期/出货前验货) 各一份报告；终期报告是 qc_shipped 门禁判据。
//   - AQL 抽样字段 + 三级疵点计数（critical 零容忍 / major / minor）。
//   - result: pass | conditional | fail（fail 后可整改重验，覆盖更新）。
// ════════════════════════════════════════════════════════════════════
model InspectionReport {
  orderSampleEvents OrderSampleEvent[] @relation("OrderSampleQcReport")
  id             String @id // final: INR__${orderId}；midline: INR__${orderId}__midline
  orderId        String
  inspectionType String @default("final") // midline(中期验货) | final(终期/出货前验货)
  /// Legacy rows remain explicitly whole-order with unknown historical coverage.
  /// A native producer freezes current facts; defaults never manufacture them.
  scopeType               String @default("whole_order")
  scopeKey                String @default("whole_order")
  productionBatchId       String?
  productionBatchRevision Int?
  scopeSnapshot           Json?
  scopeFingerprint        String?
  revision                Int @default(1)
  supersedesId            String?
  contentFingerprint      String?
  requestKey              String?
  commandHash             String?
  totalUnits     Int    @default(0)
  passedUnits    Int    @default(0)

  // ─── QC 明细（Phase B4） ───
  inspectionDate  String? // YYYY-MM-DD
  inspectorOrg    String? // 验货方：自有 QC | SGS | BV | Intertek | 客户验货员 ...
  aqlLevel        String? // 例 "2.5/4.0 II"（major/minor AQL + 检验水平）
  lotSize         Int? // 批量
  sampleSize      Int? // 抽样数
  criticalDefects Int     @default(0) // 致命疵点（AQL 0，>0 即整批拒收）
  majorDefects    Int     @default(0) // 主要疵点
  minorDefects    Int     @default(0) // 次要疵点
  defectSummary   String? // 疵点描述（如 "跳线x3 污渍x2"）
  result          String? // pass | conditional | fail
  /// QC records actual inspected sizes independently from the order's planned
  /// matrix and quantity tolerance. Legacy null means unknown, never covered.
  productionSizeChecks Json?
  shipmentId      String? // 关联运单（终期验货对应出运批次）

  reportFile         String?
  evidenceFiles      Json? // Native immutable uploaded evidence; legacy null remains unknown.
  inspectedBy        String?
  approvedByBusiness Boolean @default(false)
  businessApprover   String?
  approvedAt         BigInt?
  notes              String?

  /// ★ 2026-09-29 晚：幅宽实测（QC 查货验货时登记）—— 窄幅索赔扣款的输入事实
  widthMeasurements InspectionWidthMeasurement[]

  // ============ P1-7：产前样双签（质量门禁 §9.3-②）============
  /// JSONB：{ qcSignedAt, qcSignerId, businessSignedAt, businessSignerId }
  /// 后端 StageService.checkPreCutReady() 校验两字段均非空才放行开裁
  /// 设计真源：质量门禁规则.md §9.3 条 ② / 订单与生产模型组.md §12 PP 双签
  signatures Json? @default("{}")

  createdAt BigInt
  updatedAt BigInt

  @@unique([orderId, inspectionType, scopeKey, revision])
  @@unique([inspectedBy, requestKey])
  @@index([orderId])
  @@index([productionBatchId])
  @@index([supersedesId])
}

/// Exact production-batch QC NOK. The failure report and original revision are
/// immutable anchors; later reinspection and business-resume facts are appended
/// to ProductionQcIssueEvent rather than overwriting the issue or report.
model ProductionQcIssue {
  id                      String  @id
  orderId                 String
  orderLineId             String
  productionBatchId       String
  productionBatchRevision Int
  failedReportId          String  @unique
  reason                  String?
  createdBy               String
  createdAt               BigInt

  @@index([orderId, orderLineId])
  @@index([productionBatchId, productionBatchRevision, createdAt])
}

/// Append-only issue state facts: opened -> waiting_business_resume ->
/// business_resumed. Each fact carries the exact batch revision on which it was
/// recorded so an old QC pass or business decision cannot unlock a new revision.
model ProductionQcIssueEvent {
  id                      String  @id
  issueId                 String
  orderId                 String
  orderLineId             String
  productionBatchId       String
  productionBatchRevision Int
  kind                    String  // opened | qc_resolved | business_resumed
  fromStatus              String?
  toStatus                String  // open | resolved | resumed (business explicit continuation)
  actorId                 String
  reportId                String?
  requestKey              String
  commandHash             String
  note                    String?
  payload                 Json?
  createdAt               BigInt

  @@unique([issueId, kind, requestKey])
  @@index([issueId, createdAt])
  @@index([productionBatchId, productionBatchRevision, createdAt])
  @@index([reportId])
  @@index([actorId, requestKey])
}

/// 幅宽实测（QC 查货验货过程中登记）。
///
/// ── 为什么需要它（使用方 2026-09-29 口述）──
/// 「第三方测试（ITS 之类）不用我们管……如果是 QC 的话，这不是第三方 QC，是属于我们内部的 QC 团队，
///   服装面料我们都会派 QC 出去查货验货的。这部分我们肯定是**自己去在 QC 的工作过程当中把它记录下来**。」
/// ⇒ 幅宽 = **我方 QC 现场查货时量到的值**；载体 = 那一次查货的验货报告。
///
/// ── 为什么是"报告 + 订单行"两个维度 ──
///   · 挂**报告**：事实来源是"哪一次查货"（报告 = 那一次），出运门禁/质量复盘都以报告为单位；
///   · 挂**订单行**：窄幅索赔的基数是**该订单行的货款金额**（使用方 2026-09-29 拍），
///     且一张订单常有多支面料（多行）⇒ 必须逐行记，否则算不出钱。
///
/// ── 两列都**必填**（与"可空 = 未录"那条纪律方向相反，理由写在这里）──
///   这条路没有"半条记录"的合法形态：没有实测值就谈不上量过；没有基准就**算不出偏差**。
///   ★ 宁可不建这条记录，也不许拿别处的默认幅宽替它猜基准（R6：算不出来就说算不出来）。
model InspectionWidthMeasurement {
  id              String  @id // 格式：IWM__${shortId}
  reportId        String
  orderId         String
  orderLineId     String
  /// QC 实测幅宽（cm）
  measuredWidthCm Decimal @db.Decimal(8, 2)
  /// 基准幅宽（合同/PO 上的可用幅宽，cm）—— 偏差 = (基准 − 实测) / 基准
  basisWidthCm    Decimal @db.Decimal(8, 2)
  note            String?
  createdAt       BigInt
  updatedAt       BigInt

  report InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, orderLineId]) // 一份报告里同一行只留一条（修正 = 覆盖，不堆历史）
  @@index([orderId])
  @@index([orderLineId])
}

// ════════════════════════════════════════════════════════════════════
// Third-Party Test Request — 第三方测试管理 (REQ2-04, IND-03 缺口补齐)
// ════════════════════════════════════════════════════════════════════
// 设计决策：
//   - 与质量域既有两轨分工（避免双轨）：qcChainService 样品评审是过程质量控制，
//     InspectionReport 是出货前实物验货（AQL 抽检）；本模块是第三方实验室送样检测
//     （理化/合规指标），测试结果数据仅在此建模（档案 complianceTests 是客户要求非结果）。
//   - fail 结论强制挂整改（100% 跟踪闭环验收锚点）：PATCH result=fail 时服务端校验
//     failItems 非空且 ≥1 条 open 整改，否则 400。
//   - 报告 PDF 附件走 ProductImage 范式：multer diskStorage 相对路径 + 软删，
//     访问经 /api/uploads 静态服务同源。
//   - 业务日期 String YYYY-MM-DD、时间戳 BigInt epoch ms、id 格式 TR__${shortId}——
//     与其他模块一致。
// 设计真源：docs/design/04-模块设计/03-订单与生产/QcWorkbench-QC质检中心/第三方测试管理.md
// ════════════════════════════════════════════════════════════════════

/// 测试委托：订单级第三方实验室检测委托单
model TestRequest {
  id   String @id // 格式：TR__${shortId}
  trNo String @unique // 业务号：TR-YYYYMMDD-001

  orderId String // 挂订单（全类型：面料/成衣/其他）

  // ─── 委托内容 ───
  testItems    String[] // 测试项目枚举多选：color_fastness/shrinkage/tensile/ph/formaldehyde/azo/gsm/width/other
  agency       String // 委托机构：sgs | its | bv | other
  sentDate     String? // 送样日 YYYY-MM-DD
  expectedDate String? // 预计报告日
  notes        String? // 委托备注（样品描述/客户特殊要求）

  // ─── 结论（pending→pass/fail 单向终态；重测走新委托单） ───
  result        String   @default("pending") // pending | pass | fail
  reportNo      String? // 实验室报告编号
  // ★ 2026-09-29：缩水率实测值。客户 PO 要求「工厂必须提供所有面料的缩水率」。
  //   使用方决定（J-8）「给个可填字段，不绑死」——QC 过程登记一下即可，不做校验不做提醒（低频）。
  shrinkageRate Decimal? @db.Decimal(8, 4) // 缩水率实测值（%），人工填
  reportDate    String? // 报告签发日
  failItems     String[] @default([]) // 失败项子集（fail 时必填，整改挂此维度）

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt? // 软删（仅 pending 态允许；终态单归档保留）

  files             TestReportFile[]
  correctiveActions TestCorrectiveAction[]

  @@index([orderId])
}

/// 报告 PDF 附件（ProductImage 范式：相对路径 + 软删）
model TestReportFile {
  id            String  @id
  testRequestId String
  filePath      String // 相对路径：test-reports/{requestId}/{timestamp}-{rand}.pdf
  fileName      String // 原始文件名
  mimeType      String // application/pdf
  fileSize      Int
  uploadedAt    BigInt
  deletedAt     BigInt?

  testRequest TestRequest @relation(fields: [testRequestId], references: [id], onDelete: Cascade)

  @@index([testRequestId])
}

/// 失败项整改记录（独立模型：open 清单可查询、闭环状态可审计）
model TestCorrectiveAction {
  id            String  @id
  testRequestId String
  failItem      String // 对应 TestRequest.failItems 之一
  action        String // 整改措施（返工/复测/让步接收/客户沟通…）
  owner         String? // 责任人
  dueDate       String? // 整改期限 YYYY-MM-DD
  status        String  @default("open") // open | closed
  closedAt      BigInt?
  closeNote     String? // 闭环说明
  createdAt     BigInt
  updatedAt     BigInt

  testRequest TestRequest @relation(fields: [testRequestId], references: [id], onDelete: Cascade)

  @@index([testRequestId])
}

// ════════════════════════════════════════════════════════════════════
// Email Module — 邮件接收与附件存储 (Phase 4a)
// ════════════════════════════════════════════════════════════════════
// 设计决策：
//   - 邮件从 IMAP 实时获取 → 改为 IMAP→DB 后台同步 + API 读 DB，
//     大幅减少 IMAP 连接频率，支持离线查阅和 Agent 引用。
//   - 附件下载到本地 uploads/ 目录，路径存 EmailAttachment.filePath。
//   - 业务日期用 String YYYY-MM-DD，时间戳用 BigInt epoch ms —— 与其他模块一致。
//   - Relation 关联用 snapshot FK 风格，不加 @relation。
//   - EntityLink: email→order(aboutOrder), email→contact(sentBy/receivedFrom),
//     email→invoice(aboutInvoice) — 供 Agent 跨模块查询。
// ════════════════════════════════════════════════════════════════════

model Email {
  id        String  @id // 格式：EML__${shortId}
  messageId String? @unique // RFC 2822 Message-ID header (e.g. "<abc@mail.com>")

  // ─── 方向与状态 ───
  direction String // inbound(收到) | outbound(发出) | draft(草稿)
  status    String // new(未读) | read(已读) | starred(星标) | important(重要) | archived(归档) | deleted(已删)

  // ─── 发件/收件 ───
  fromAddress    String // 发件人邮箱
  fromName       String? // 发件人显示名
  toAddresses    String // 收件人 (JSON array: ["a@b.com","c@d.com"])
  ccAddresses    String? // 抄送 (JSON array)
  bccAddresses   String? // 密送 (JSON array)
  replyToAddress String? // 回复地址

  // ─── 邮件内容 ───
  subject  String
  bodyText String? // 纯文本正文
  bodyHtml String? // HTML 正文
  snippet  String? // 预览片段 (自动从 bodyText 截取前 200 字)

  // ─── IMAP 元数据 ───
  mailbox     String // IMAP 邮箱名 (INBOX, Sent Messages, Drafts, etc.)
  mailboxOwnerUserId String? // 员工邮箱归属；null 仅保留给无法判定归属的历史邮件，由开发者/管理员核对迁移
  uid         Int? // IMAP UID (同一 mailbox 内唯一)
  uidValidity String? // IMAP UIDVALIDITY (用于跨会话 UID 稳定性)
  threadId    String? // 邮件线索 ID (基于 References/In-Reply-To)

  // ─── 日期 ───
  sentAt     String? // 邮件 Date header (YYYY-MM-DD HH:mm:ss)
  receivedAt String? // 实际收到时间 (YYYY-MM-DD HH:mm:ss)

  // ─── 关联（snapshot FK） ───
  relationId    String? // 关联联系人/组织 (sentBy/receivedFrom linkKind)
  relationName  String? // 冗余快照
  orderId       String? // 关联订单 (aboutOrder linkKind)
  orderPo       String? // 冗余快照：订单 PO 号
  invoiceId     String? // 关联发票 (aboutInvoice linkKind)
  invoiceNumber String? // 冗余快照

  // ─── 分类/标签 ───
  labels          String[] // Gmail-style 标签 (如 ["urgent","peerless","quote"])
  aiSummary       String? // AI 生成的邮件摘要 (Phase 4b)
  aiExtractedJson Json? // AI 抽取的结构化数据 (intent/products/quantities/prices/deadlines/customerSignal/language/summary) - Phase 4b
  aiExtractedAt   BigInt? // AI 抽取时间 epoch ms - Phase 4b
  aiModel         String? // 用于抽取的模型名 (如 ark-code-latest) - Phase 4b
  aiExtractError  String? // 上次抽取失败的错误信息（成功后清零）- Phase 4b

  // ─── 附件统计 ───
  hasAttachments  Boolean @default(false)
  attachmentCount Int     @default(0)

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?
  syncedAt  BigInt? // 最后一次 IMAP 同步时间

  attachments EmailAttachment[]
  sendAttempt EmailSendAttempt?

  @@index([direction])
  @@index([status])
  @@index([fromAddress])
  @@index([mailbox])
  @@index([mailboxOwnerUserId, mailbox, createdAt])
  @@index([uid, uidValidity])
  @@index([threadId])
  @@index([relationId])
  @@index([orderId])
  @@index([invoiceId])
  @@index([sentAt])
  @@index([hasAttachments])
}

// Durable SMTP reservation and provider receipt. This is separate from native
// Email Sent and immutable audit facts; a pending/unknown attempt cannot resend.
model EmailSendAttempt {
  id                 String @id
  emailId            String @unique
  actorId            String
  status             String
  contentHash        String
  contentSnapshot    Json
  smtpUser           String
  requestedMessageId String
  smtpMessageId      String?
  smtpReceipt        Json?
  receiptSentAt      String?
  auditId            String? @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  email Email @relation(fields: [emailId], references: [id], onDelete: Restrict)
  actor UserAccount @relation(fields: [actorId], references: [id], onDelete: Restrict)
  audit AuditLog? @relation(fields: [auditId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([actorId])
}

model EmailAttachment {
  id      String @id // 格式：EMLATT__${shortId}
  emailId String // 所属邮件

  // ─── 附件元数据 ───
  filename    String // 原始文件名
  contentType String // MIME 类型 (e.g. "application/pdf")
  fileSize    Int // 文件大小 (bytes)
  contentId   String? // CID (inline 图片引用)

  // ─── 存储 ───
  filePath String? // 私有存储路径（email-attachments/...，相对 private-files 根；只经权限门下载路由读取。旧记录 uploads/email-attachments/... 相对 server 根）
  fileUrl  String? // 可访问 URL (/api/v1/email/attachments/:id/download)
  isInline Boolean @default(false) // 是否内嵌图片

  // ─── 解析后信息 (Phase 4b AI) ───
  extractedText String? // PDF/图片 OCR 提取文本
  aiAnalysis    Json? // AI 分析结果

  // ─── 时间戳 ───
  createdAt BigInt
  updatedAt BigInt

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([contentType])
  @@index([filename])
}

// EmailTemplate：业务场景邮件模板（F5 邮件智能化）
// 报价/催款/交期通知/验货报告/节日问候等标准模板（PRD 12.1）。
// subject/body 支持 {{variable}} 占位符，插入时由前端变量表单填充；
// variables 冗余存储模板中出现的变量名，供 UI 直接生成填写项。
model EmailTemplate {
  id   String @id // 格式：EMTPL__${shortId}
  type String // quote | payment_reminder | delivery_notice | inspection_report | greeting | general

  name      String // 模板名称（如：标准报价函）
  subject   String // 主题模板（支持 {{var}}）
  body      String // 正文模板（支持 {{var}}）
  variables String[] // 变量清单（如 ["customerName","quotationNo"]）

  // ─── C8 模板智能化：使用统计 ───
  usageCount Int     @default(0) // 被插入使用的累计次数
  lastUsedAt BigInt? // 最近一次使用时间 epoch ms

  isActive Boolean @default(true)

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([type])
  @@index([isActive])
}

// ════════════════════════════════════════════════════════════════════
// End of Email Module
// ════════════════════════════════════════════════════════════════════

model AuditLog {
  orderSampleCommandCancellation OrderSampleCommandCancellation?
  orderSampleSource OrderSampleSource? @relation("OrderSampleCreationAudit")
  orderSampleEvent OrderSampleEvent? @relation("OrderSampleEventAudit")
  orderSampleQcEvents OrderSampleEvent[] @relation("OrderSampleQcAudit")
  id            String   @id
  actorId       String
  action        String
  targetType    String?
  targetId      String?
  detail        Json?
  ip            String?
  // Phase 0 Sprint 1: 字段级审计（before/after 单字段追踪）
  operationType String? // create / update / delete / transition / link / unlink
  fieldPath     String? // 如 "status" 或 "lines[0].quantity"
  beforeValue   Json?
  afterValue    Json?
  transactionId String? // 关联 OrderStatusTransition / BusinessEvent id，用于串联同一业务操作
  createdAt     DateTime @default(now())

  actor UserAccount @relation(fields: [actorId], references: [id])
  claimCreditNoteLines ClaimCreditNoteLine[]
  cashRefundDecisions CreditNoteRefund[] @relation("CashRefundDecision")
  cashRefundEvents CreditNoteRefundEvent[] @relation("CashRefundEventAudit")
  orderCostReview OrderCostReview? @relation("OrderCostReviewAudit")
  orderCostReviewEvidence OrderCostReviewEvidence? @relation("OrderCostReviewEvidenceAudit")
  emailSendAttempt EmailSendAttempt?
  cashRefundReturn CreditNoteRefundReturn? @relation("CashRefundReturnAudit")
  fabricUseAuthorizationVersion FabricUseAuthorizationVersion? @relation("FabricUseAuthorizationVersionAudit")
  fabricUseAuthorizationUse FabricUseAuthorizationUse? @relation("FabricUseAuthorizationUseAudit")

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([transactionId])
}

// ════════════════════════════════════════════════════════════════════
// Notification Module (Phase 0 Sprint 1: 通知系统)
// ════════════════════════════════════════════════════════════════════
// 站内/邮件/Push 多通道通知，由 BusinessEventBus 事件触发，
// 用户可通过 NotificationPreference 配置各类型通知的通道偏好。

model Notification {
  id            String    @id @default(cuid())
  userId        String
  type          String // order_confirmed / shipment_completed / invoice_issued / payment_received / stock_low / payment_overdue / agent_message / briefing
  title         String
  body          String
  level         String    @default("info") // info / warning / critical
  link          String? // 前端跳转路由
  metadata      Json?
  readAt        DateTime?
  // PRD 7.1「忽略需填原因」：用于持续优化推送准确率（目标 ≥80%）
  dismissedAt   DateTime?
  dismissReason String?
  createdAt     DateTime  @default(now())

  user UserAccount @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([type])
  @@index([createdAt])
  @@index([level])
}

model NotificationTemplate {
  id             String   @id
  key            String   @unique // e.g. "order_confirmed"
  titleTemplate  String // e.g. "订单 {poNumber} 已确认"
  bodyTemplate   String // e.g. "客户 {customer} 的订单已确认..."
  level          String   @default("info")
  defaultChannel String   @default("in_app") // in_app / email / push
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([key])
  @@index([isActive])
}

model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String
  notificationType String // 与 Notification.type 对应
  channels         Json // ["in_app", "email"] — 用户偏好的通道
  isEnabled        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user UserAccount @relation(fields: [userId], references: [id])

  @@unique([userId, notificationType])
  @@index([userId])
}

// ════════════════════════════════════════════════════════════════════
// Compiled Templates Module (Phase 6)
// ════════════════════════════════════════════════════════════════════
// 模板渲染产物存档：用于 audit + 幂等去重 + 给客户复发同一份发票。
// 不强制每次 render 都写一条；调用方按需选择是否落库。

model RenderedDoc {
  id                 String   @id
  templateId         String // 例如 'invoice.sample.pdas'
  schemaVersion      Int // 模板版本，破坏性变更时 +1
  inputJson          Json // 渲染时传入的 data，用于复现
  htmlSha            String // sha256(html)[:16]
  htmlBytes          Int
  pdfSha             String? // 如生成了 PDF
  pdfBytes           Int?
  pdfPath            String? // 落到 storage/rendered/<id>.pdf
  format             String? // 'A4' | 'A5' | 'Letter'
  landscape          Boolean? @default(false)
  // 业务关联（可空）
  invoiceId          String?
  orderRelationId    String?
  customerRelationId String?
  // 操作者（可空，HTTP 路由 / agent 工具均可写）
  actorId            String?
  actorRoles         Json?
  source             String   @default("api") // 'api' | 'agent' | 'frontend'
  notes              String?
  createdAt          BigInt
  updatedAt          BigInt

  @@index([templateId])
  @@index([htmlSha])
  @@index([invoiceId])
  @@index([orderRelationId])
  @@index([customerRelationId])
  @@index([createdAt])
}

/// Agent checkpoint for crash recovery (checkpoint/resume capability)
model AgentCheckpoint {
  id              String   @id
  conversationId  String   @unique
  step            Int
  message         String
  scratchpad      Json // { thoughts: [], toolCalls: [] }
  iterations      Json // IterationTrace[]
  // 批次 2b：挂起审批持久化——挂起等待审批时记录 { approvalId, step, toolId, toolInput, why, suspendedAt }，
  // 进程重启后 resume 可查 ApprovalRequest 决议状态（真源）补执行或重新等待
  pendingApproval Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([conversationId])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════════
// Workflow Engine (Phase 0 · Sprint 2)
// ════════════════════════════════════════════════════════════════════
// 多步审批 / 会签 / 条件分支的状态机引擎。
// WorkflowDefinition = 模板（哪些步骤、每步谁审批）
// WorkflowInstance   = 一次具体审批流程实例（绑定到某个业务实体）
// WorkflowStep       = 实例中的每一步审批记录

/// 工作流定义模板 — 可复用的审批流程蓝图
model WorkflowDefinition {
  id           String   @id
  name         String
  description  String?
  entityType   String // 'Order' | 'Invoice' | 'Shipment' | 'DevelopmentCase' | etc.
  triggerEvent String? // e.g. 'OrderConfirmed' — 事件总线收到此事件时自动创建实例
  steps        Json // Array<StepDef>: { name, approverRole?, approverUserId?, description? }
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instances WorkflowInstance[]

  @@index([entityType])
  @@index([triggerEvent])
  @@index([isActive])
}

/// 工作流实例 — 一次具体的审批流程，绑定到某个业务实体
model WorkflowInstance {
  id               String             @id
  definitionId     String
  definition       WorkflowDefinition @relation(fields: [definitionId], references: [id])
  entityType       String // 'Order' | 'Invoice' | etc.（冗余存储，便于查询）
  entityId         String // 业务实体 ID
  status           String             @default("running") // running | approved | rejected | cancelled
  currentStepIndex Int                @default(0)
  title            String? // 实例标题（如"订单 #PO-001 审批"）
  initiatedById    String?
  initiator        UserAccount?       @relation("WorkflowInitiator", fields: [initiatedById], references: [id])
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  steps WorkflowStep[]

  @@index([definitionId])
  @@index([entityType, entityId])
  @@index([status])
  @@index([initiatedById])
}

/// 工作流步骤 — 实例中每一步的审批记录
model WorkflowStep {
  id             String           @id
  instanceId     String
  instance       WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepIndex      Int
  stepName       String
  approverRole   String? // 角色审批（如 'manager' | 'finance' | 'production_manager'）
  approverUserId String? // 指定用户审批（可选，优先于角色）
  decision       String? // null(待审批) | approved | rejected | skipped
  decisionNote   String?
  decidedById    String?
  decider        UserAccount?     @relation("WorkflowDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([instanceId])
  @@index([decision])
  @@index([approverRole])
}

// ════════════════════════════════════════════════════════════════
// Phase 2: 报价管理 Quotation Management
// 外贸「接单起点」：询价 → 报价 → 样品 → 订单 → 生产 → 发货 → 发票 → 收款
// 报价单是订单的前置环节，accepted 状态可转为 Order
// ════════════════════════════════════════════════════════════════

model Quotation {
  quotationType String?
  contactName String?
  contactPhone String?
  tradePlace String?
  internalCostBasis Json?
  id              String @id // 格式：QT_${shortId}
  quotationNumber String @unique // 业务报价号（如 QT-20260806-001）

  // ─── 业务字段 ───
  status      String // Draft(草稿) | Sent(已发送) | Accepted(已接受) | Rejected(已拒绝) | Expired(已过期)
  currency    String // USD | CNY | EUR ...
  totalAmount Decimal @db.Decimal(18, 4) // 报价总金额（所有行金额合计）

  // ─── REQ2-19 版本链（DR-060-①）：Draft 编辑金额/行变化自动快照旧版；revise 显式修订 +1 ───
  version Int @default(1) // 当前版本号（1 = 首报；砍价轮次 = version - 1）

  // ─── 汇率快照（外贸场景） ───
  exchangeRate Decimal? @db.Decimal(18, 4) // 报价当日 currency → baseCurrency 汇率
  baseCurrency String   @default("CNY") // 本位币

  // ─── 双轨定价快照（PRD 8.6 双轨联动校验；创建时由编辑器写入，此后为历史快照） ───
  trackAMedianUsd       Decimal? @db.Decimal(18, 4) // 轨道 A 中位估算美元单价
  trackAUnit            String? // PC（件） | M（米）
  trackBFinalUsd        Decimal? @db.Decimal(18, 4) // 轨道 B 终价美元单价
  priceDeviationPercent Float? // 终价偏离估算中位百分比（正 = 高于估算）
  priceDeviationLevel   String? // ok | warn（>15%，已触发审批） | block（>30%，未审批通过禁止发送）
  priceApprovalId       String? // 偏差 >15% 时自动生成的 ApprovalRequest id

  // ─── 关联（snapshot FK，不强制约束） ───
  customerRelationId String? // 结算单位
  customerName       String? // 冗余快照
  customerCode       String? // 客户编码

  // ── G1-3 报价正向关联：报价=关联审批单，指向项目/订单/条目（多粒度；snapshot FK，不强制约束） ──
  developmentCaseId String? // 关联开发案（客户开发/打样报价）
  orderId           String? // 关联订单（大货/样品报价）
  orderLineId       String? // 关联具体订单条目（条目级报价）

  // ─── 报价条款 ───
  issueDate         String // 报价日期 YYYY-MM-DD
  validUntil        String? // 报价有效期至 YYYY-MM-DD
  deliveryTerms     String? // FOB Shanghai | CIF ...
  paymentTerms      String? // T/T 30% deposit ...
  /// 付款方式（结算工具）：T/T | L/C | O/A | D/P | D/A | Other。
  /// ★ 与 `Order.paymentInstrument` **同一份枚举**（真源 `lib/orderSchema.ts:246`，`type:'enum'` + `enumOptions`）
  ///   —— 本仓「多套并行真源」是头号病（§9 B51），不许在报价侧再写一份选项清单。
  /// ★ 可空 = **未录**（不知道），**不是**「非信用证」：L/C 门禁读本列时必须走第三分支
  ///   （`LC_INSTRUMENT_NOT_RECORDED`，不阻断但可见），见 `server/src/customs/lcGate.ts`。
  ///   加列动机：报价转订单原先只拷 `paymentTerms` 不拷本字段 ⇒ 订单该列恒 null
  ///   ⇒ `isLcInstrument(null)=false` ⇒ 门禁对整条报价转单路径 100% 免检（§9 B51 / 拍板件 §2.2 A19）。
  paymentInstrument String?
  salesperson       String? // 业务员
  inquiryRef        String? // 询价参考号

  // ─── 转换 ───
  convertedOrderId String? // accepted → 转换为订单后的 orderId

  // ─── 备注 / 附件 ───
  notes       String?
  attachments Json?

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?
  sentAt    BigInt? // 发送时间（Draft→Sent 时写入；用于「Sent 超 7 天未回复」提醒与账龄分析）

  // ─── Phase 1-03 财务域升级：行级权限 ───
  ownerId      String?
  departmentId String?

  // ============ MOQ 快照（P0-4，writeOnce，同 Order.moqSnapshot）============
  /// JSONB：{ fabricDefaultMoq, garmentDefaultMoq, capsuleMoq, snapshotAt, configId, source }
  /// 服务端在 Quotation.create 时 writeOnce 填充；此后不随系统配置变更
  /// 设计真源：MOQ最小起订量.md §2.1 优先级#5
  moqSnapshot Json @default("{}")

  // ─── 关联行 ───
  lines QuotationLine[]

  @@index([status])
  @@index([customerRelationId])
  @@index([quotationNumber])
  @@index([issueDate])
  @@index([validUntil])
  @@index([ownerId])
  @@index([departmentId])
}

// ============================================================================
// REQ2-19：报价版本快照（砍价画像，生命周期③，DR-060）
// ============================================================================
/// 版本链（append-only）：Draft 编辑金额/行变化时自动快照旧版；revise 显式修订时快照。
/// 砍价画像 = 版本链首版金额 vs 当前金额（降幅）× 客户维度聚合。
/// 设计真源：Quotations-报价/砍价画像与版本对比.md §4
model QuotationVersion {
  id             String  @id // 格式：QTV_${shortId}
  quotationId    String
  version        Int // 被快照的版本号（该快照为保存新版本前的完整旧内容）
  totalAmount    Decimal @db.Decimal(18, 4) // 该版本报价总额
  currency       String?
  headerSnapshot Json? // 报价头快照（条款/客户/状态等关键字段）
  linesSnapshot  Json? // 行快照数组（fabricCode/description/quantity/unit/unitPrice/amount）
  changeReason   String? // 修订原因（砍价/规格变更/汇率等）
  changedBy      String?
  createdAt      BigInt

  @@unique([quotationId, version])
  @@index([quotationId])
}

model QuotationLine {
  productAssetId String?
  productType String?
  specification String?
  moq Decimal? @db.Decimal(18, 4)
  leadTimeDays Int?
  leadTimeStart String?
  priceTiers Json?
  id          String @id
  quotationId String
  lineNumber  Int

  // ─── 商品明细 ───
  fabricCode  String? // 面料编码
  description String // 品名描述
  quantity    Decimal @db.Decimal(18, 4)
  unit        String // YD | M | KG | PC | SET
  unitPrice   Decimal @db.Decimal(18, 4) // 单价（报价币种）
  amount      Decimal @db.Decimal(18, 4) // 行金额 = quantity * unitPrice
  notes       String?

  // ─── REQ2-12 产品图片（DR-053-②：行级快照 URL，档案换图/删图后报价历史不失真） ───
  imageUrl String? // 面料照片/色卡图（/api/uploads/... 绝对路径或外链）

  // ============ MOQ 行级 override（P0-6，同 OrderLine.moqOverride）============
  /// 需审批人备注 + scope: moq:line_override；高于产品档案和客户协议 MOQ
  moqOverride Int?

  createdAt BigInt

  // ─── 关联 ───
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([fabricCode])
}

// ============ Phase 2 B1: 采购管理 Procurement ============
model PurchaseOrder {
  id       String @id // 格式：PO_${shortId}
  poNumber String @unique // 业务采购单号（如 PO-20260806-001）
  status   String // Draft(草稿) | Sent(已发送) | Confirmed(已确认) | PartiallyReceived(部分到货) | Received(全部到货) | Closed(已关闭) | Cancelled(已取消)

  // ─── 供应商 ───
  supplierRelationId String? // 供应商 Relation ID
  supplierName       String? // 供应商名称（冗余快照）
  supplierCode       String? // 供应商编码

  // ─── 金额 ───
  currency     String // USD | CNY | EUR
  totalAmount  Decimal  @db.Decimal(18, 4) // 采购总金额
  exchangeRate Decimal? @db.Decimal(18, 4)
  baseCurrency String   @default("CNY")

  // ─── 日期 ───
  orderDate            String // 下单日期 YYYY-MM-DD
  expectedDeliveryDate String? // 预计交货日期
  actualDeliveryDate   String? // 实际交货日期

  // ─── 条款 ───
  deliveryTerms String? // 交货条款
  paymentTerms  String? // 付款条款
  shipToAddress String? // 收货地址

  // ─── 关联 ───
  orderId     String? // 关联销售订单（从订单/BOM 触发采购）
  quotationId String? // 关联报价单（可选）
  bomId       String? // 关联 BOM（可选）

  // ─── 采购员 ───
  buyer       String? // 采购员
  businessOwnerId String? // 当前真实经办账号；历史未知不回填
  approvedCommitmentRevisionId String? // 已批供应商承诺；历史状态不推定批准
  mainDeliveryLocationKey String?
  mainDeliveryLocation Json?
  notes       String?
  attachments Json?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  lines    PurchaseLine[]
  receipts MaterialReceipt[]
  commitmentRevisions SupplierCommitmentRevision[] @relation("PurchaseCommitmentRevisions")
  approvedCommitmentRevision SupplierCommitmentRevision? @relation("PurchaseApprovedRevision", fields: [approvedCommitmentRevisionId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([supplierRelationId])
  @@index([poNumber])
  @@index([orderDate])
  @@index([orderId])
}

model PurchaseLine {
  kind String @default("Material")
  orderLineId String?
  requestedDeliveryDate String?
  supplierCommittedDeliveryDate String?
  retiredAt BigInt? // 已批修订移除的行保留历史身份
  id              String @id
  purchaseOrderId String
  lineNumber      Int

  // ─── 物料信息 ───
  materialCode  String? // 物料编码（面料编码/辅料编码）
  description   String // 品名描述
  category      String? // Fabric | Trimmings | Accessories | Other
  specification String? // 规格描述

  // ─── 数量价格 ───
  quantity  Decimal @db.Decimal(18, 4) // 订单数量
  unit      String // YD | M | KG | PC | SET
  unitPrice Decimal @db.Decimal(18, 4) // 单价
  amount    Decimal @db.Decimal(18, 4) // 行金额 = quantity * unitPrice

  // ─── 收货跟踪 ───
  receivedQuantity Decimal @default(0) @db.Decimal(18, 4) // 已收数量
  rejectedQuantity Decimal @default(0) @db.Decimal(18, 4) // 不合格数量

  notes String?

  createdAt BigInt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierFulfillmentFacts SupplierFulfillmentFact[]

  @@index([purchaseOrderId])
  @@index([materialCode])
}

model MaterialReceipt {
  id              String @id // 格式：MR_${shortId}
  receiptNumber   String // 收料单号
  purchaseOrderId String
  status          String // Pending(待检) | Inspected(已检验) | Accepted(合格入库) | Rejected(不合格) | PartiallyAccepted(部分合格)

  // ─── 收货信息 ───
  receivedDate   String // 收货日期
  receivedBy     String? // 收货人
  inspectedBy    String? // 检验员
  inspectionDate String? // 检验日期

  // ─── 仓库 ───
  warehouseId   String? // 收货仓库 ID
  warehouseName String? // 仓库名称（冗余）

  // ─── 检验结果 ───
  totalReceived   Decimal @db.Decimal(18, 4) // 总收货数量
  totalAccepted   Decimal @db.Decimal(18, 4) // 合格数量
  totalRejected   Decimal @db.Decimal(18, 4) // 不合格数量
  rejectionReason String? // 不合格原因
  qualityNotes    String? // 质量备注

  notes     String?
  createdAt BigInt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([status])
  @@index([receivedDate])
}

// ════════════════════════════════════════════════════════════════════
// P1-4 物料退换货（缺口 2 · 中度缺失）
// ════════════════════════════════════════════════════════════════════
// 业务语义：来料质检发现色差/克重不符/破洞 → 向供应商退回（return）、
//           要求换货（exchange）或索赔扣款（claim）。
// 设计决策：
//   ① 锚定 MaterialReceipt（PO 级汇总口径）：退货实物上限 =
//     receipt.totalRejected − 同 receipt 非 cancelled 的 return/exchange
//     已占数量（claim 纯金额索赔不占实物额度）；行级收货明细（设计文档
//     7.3 节）为独立债务，不在本模型强行补建。
//   ② 状态机：pending(待退回) → shipped(已退回) → confirmed(供应商确认)
//     → settled(结算完成)；pending → cancelled。库存联动：
//     return/exchange 于 shipped 执行 Outbound 冲减；exchange 于 confirmed
//     Inbound 回冲（供应商确认后换新到货）；claim 不动物料库存。
//   ③ 索赔应付冲减 = 负向 Payable 发票（type=Payable，amount 为负，
//     单号 CLM-YYYY-NNNN，customerRelationId 承载供应商）——复用既有
//     供应商对账单/核销体系自然冲减余额（CreditNote 最小实现，
//     对账文档 §6.3 设计落地）。
//   ④ 绩效联动：confirm 时按拒收率分级评分写入 FactoryEvaluation
//     （kind=inspection，sourceType='materialReturn'，幂等）。
// snapshot FK 风格（与全库一致，不加 @relation），软删。
// 设计真源：docs/design/10-评审与决策/2026-08-25-中度与严重缺失功能开发优先级规划.md P1-4
model MaterialReturn {
  id                 String  @id // 格式：MATRET_${shortId}
  returnNumber       String  @unique // 业务退货单号（RT-YYYY-NNNN，nextBusinessNumber 生成）
  receiptId          String // 来源来料检验单（snapshot FK → MaterialReceipt.id）
  purchaseOrderId    String // 关联采购单（冗余快照，追溯/列表免 join）
  supplierRelationId String? // 供应商（snapshot FK → Relation.id）
  supplierName       String? // 供应商名冗余快照

  // ─── 退换货类型 ───
  type String // return(退货) | exchange(换货) | claim(索赔)

  // ─── 实物（return/exchange；claim 纯金额索赔可为 0）───
  materialCode String? // 退货物料编码（库存 Outbound/回冲锚点；从 PO 行带出）
  materialName String? // 物料名快照
  quantity     Decimal @db.Decimal(18, 4) // 退货/换货数量（claim=0）
  unit         String?

  // ─── 金额（claim 必填；return/exchange 可选折让）───
  amount   Decimal? @db.Decimal(18, 4) // 索赔/折让金额（正数；claim 时生成负向应付发票）
  currency String   @default("CNY")

  // ─── 状态机 ───
  status String @default("pending") // pending | shipped | confirmed | settled | cancelled

  // ─── 库存联动（shipped 时回填；null = 次品未入库跳过联动）───
  stockItemId String? // Outbound 冲减的库存项（snapshot FK → InventoryItem.id；exchange confirmed 回冲同一项保对称）

  // ─── 索赔应付调整（claim confirm 后回填）───
  claimInvoiceId String? // 负向 Payable 发票（snapshot FK → Invoice.id）

  reason String? // 退货/索赔原因（缺省快照自 receipt.rejectionReason）
  notes  String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([receiptId])
  @@index([purchaseOrderId])
  @@index([supplierRelationId])
  @@index([status])
  @@index([type])
}

// ============ 卡点 3 修复：供应商询价比价 Supplier Inquiry（剧本 2.10 验收点补齐） ============
/// 采购询价单（向供应商询价，区别于面向客户的销售报价 Quotation）
/// 生命周期：Open（询价中，收集多供应商报价）→ Compared（已比价决策）→ Closed（已关闭/转采购单）
/// 验收点：① 询价创建可用 ② 多供应商报价记录 ③ 比价决策可记录
model SupplierInquiry {
  id            String @id // 格式：SI_${shortId}
  inquiryNumber String @unique // 业务询价号（如 SI-20260824-001，nextBusinessNumber 生成）

  // ─── 询价内容 ───
  status               String // Open(询价中) | Compared(已比价) | Closed(已关闭)
  description          String // 询价品名描述（面料/辅料/品名规格）
  materialCode         String? // 物料编码（可选，关联面料/辅料档案）
  quantity             Decimal? @db.Decimal(18, 4) // 询价数量
  unit                 String? // YD | M | KG | PC | SET
  currency             String // USD | CNY | EUR（基准币种，用于比价换算）
  expectedDeliveryDate String? // 期望交货日期

  // ─── 关联 ───
  orderId String? // 关联销售订单（可选，从订单触发采购询价）
  bomId   String? // 关联 BOM（可选）
  buyer   String? // 采购员

  // ─── 多供应商报价（Json 数组，变长，不固定供应商数量） ───
  /// supplierQuotes JSONB 结构：[{
  ///   id, supplierId, supplierName, quoteAmount, currency, exchangeRate, baseAmount,
  ///   quoteDate, deliveryTerms, paymentTerms, expectedDeliveryDate, notes, isSelected
  /// }]
  /// baseAmount = quoteAmount × exchangeRate（换算到基准币种，用于横向比价）
  supplierQuotes Json?

  // ─── 比价决策 ───
  selectedSupplierId   String? // 中选供应商 Relation ID
  selectedSupplierName String? // 中选供应商名称（冗余快照）
  decisionNote         String? // 比价决策备注（选型理由/议价结果）

  notes       String?
  attachments Json?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([status])
  @@index([inquiryNumber])
  @@index([materialCode])
  @@index([orderId])
  @@index([selectedSupplierId])
}

// ============ 阶段 H H1: 供应商管理 Supplier Management（PRD 13 / 19.18） ============
// 身份真源在 Relation（category=Supplier），FactoryProfile 1:1 承载工厂属性；
// 评分为事务内重算缓存（真源在 FactoryEvaluation 明细），禁止客户端直改。

// FactoryProfile：工厂档案（PRD 13.1）
model FactoryProfile {
  id         String @id // 格式：FACP__${shortId}
  relationId String @unique // 1:1 挂 Relation（供应商组织身份）

  // ─── 产能 ───
  monthlyCapacity Decimal? @db.Decimal(18, 4) // 月产能
  capacityUnit    String? // PC | M（件/米）
  equipmentList   String? // 设备清单
  workerCount     Int? // 工人数量

  // ─── 专长 ───
  specialties String[] // 擅长品类（西装/大衣/衬衫/针织…）

  // ─── 评分缓存（真源 FactoryEvaluation，事务内重算） ───
  qualityScore  Float   @default(0) // 质量综合分 0-100
  deliveryScore Float   @default(0) // 交期达成率 0-100
  priceLevel    String? // High | Mid | Low

  // ─── 合作历史 ───
  firstOrderAt String? // 首次合作日期 YYYY-MM-DD
  totalOrders  Int     @default(0) // 累计订单数
  totalAmount  Decimal @default(0) @db.Decimal(18, 4) // 累计金额

  // ─── 银行信息 ───
  bankName    String? // 开户行
  bankAccount String? // 收款账户
  bankSwift   String? // SWIFT

  // ─── 黑名单（拉黑后新建采购单禁选） ───
  blacklistedAt   BigInt?
  blacklistReason String?
  blacklistedById String?

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  relation         Relation               @relation(fields: [relationId], references: [id], onDelete: Cascade)
  evaluations      FactoryEvaluation[]
  certifications   FactoryCertification[]
  capacityCalendar FactoryCapacity[]

  @@index([blacklistedAt])
  @@index([qualityScore])
}

// FactoryEvaluation：工厂评估记录（PRD 13.2）——每次验货/交货的评分明细（append-only 真源）
model FactoryEvaluation {
  id        String @id // 格式：FAEV__${shortId}
  factoryId String

  kind        String // inspection（验货） | delivery（交期）
  score       Float // 0-100
  sourceType  String? // inspectionReport | shipment | purchaseOrder | manual
  sourceId    String?
  evaluatedAt String // 评定日期 YYYY-MM-DD
  note        String?
  actorId     String?

  createdAt BigInt
  deletedAt BigInt?

  factory FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@index([factoryId, kind])
  @@index([sourceType, sourceId])
}

// FactoryCertification：工厂认证记录（PRD 13.1/15.3）——有效期为预警扫描对象
model FactoryCertification {
  id        String @id // 格式：FACR__${shortId}
  factoryId String

  type           String // BSCI | SEDEX | WRAP | ISO9001 | ...
  certificateNo  String?
  issuedAt       String? // 签发日期 YYYY-MM-DD
  validUntil     String? // 有效期至 YYYY-MM-DD（null = 长期有效）
  attachmentPath String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  factory FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@index([factoryId])
  @@index([validUntil])
}

// ════════════════════════════════════════════════════════════════════
// REQ2-06 GRS TC 交易证书链 (DR-048)
// ════════════════════════════════════════════════════════════════════
// 设计决策（DR-048，设计文档 §2）：
//   ① TC 与资质认证分轨：FactoryCertification 是工厂年度资质；TcCertificate 是
//     每票交易的证书（三段链挂订单 + 交易对手）——两轨不合并
//   ② 三段链按 stage 枚举 + 段位聚合勾稽（Σ 原料 ≥ Σ 工厂 ≥ Σ 我方），
//     不做逐张 parent 拓扑（parentTcId 预留增强）
//   ③ 一键校验四检查项：链完整性 / 段间吨位 / TC vs 订单用量（KG 行） / 有效期
//     ——只读无副作用，出货门禁消费方调用
// 设计真源：docs/design/04-模块设计/06-资源与支撑/Suppliers-供应商/GRS-TC交易证书链.md
// ════════════════════════════════════════════════════════════════════

/// GRS 订单交易证书：原料 TC → 工厂 TC → 我方 TC 三段链（缺链 = 无法清关）
model TcCertificate {
  id   String @id // 格式：TCC__${shortId}
  tcNo String @unique // 证书编号（TC No.）

  orderId      String // 挂订单（GRS 订单）
  relationId   String? // 交易对手（出具方/接收方，跨模块 snapshot FK → Relation）
  relationName String? // 冗余快照

  // ─── 三段链（DR-048-②） ───
  stage String // material_input(原料TC：上游→工厂) | factory_output(工厂TC：工厂→我方) | our_sale(我方TC：我方→客户)

  // ─── 吨位与效期 ───
  quantityKg Decimal @db.Decimal(18, 3) // 吨位（公斤，GRS TC 计量单位）
  issuedAt   String? // 签发日 YYYY-MM-DD
  validUntil String? // 有效期至（null = 长期有效）

  attachmentPath String? // 证书 PDF（预留）
  notes          String?

  // ─── 可选链上游（增强预留，校验不依赖 DR-048-②） ───
  parentTcId String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([orderId])
  @@index([relationId])
  @@index([stage])
}

// FactoryCapacity：工厂产能日历（PRD 13.3）——capacity 为计划产能；
// 占用量不落地，由服务层按在手采购单（expectedDeliveryDate 落月）实时聚合。
model FactoryCapacity {
  id        String @id // 格式：FACC__${shortId}
  factoryId String

  month    String // YYYY-MM
  capacity Decimal @db.Decimal(18, 4) // 当月计划产能
  unit     String? // PC | M
  note     String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  factory FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@unique([factoryId, month])
  @@index([month])
}

// ============ 阶段 H H2: 季节性与趋势管理 Season & Trend Management（PRD 14） ============
// 季度标签口径：Order.season / ProductAsset.season 为自由文本，Season.code 为注册真源，
// 关联匹配按字符串等值（如 "SS26"），季度回顾按 code 等值聚合订单。

// Season：季度/系列管理（PRD 14.1）——开发日历 + 季度回顾
model Season {
  id   String @id // 格式：SEAS__${shortId}
  code String @unique // SS26 | AW26 | SS27（与 Order.season / ProductAsset.season 等值匹配）
  name String // 显示名（如 2026 春夏）

  startDate String // YYYY-MM-DD
  endDate   String // YYYY-MM-DD

  // 开发日历里程碑：开发→打样→确认→下单→生产→出货
  calendar Json? // [{ key, label, startDate, endDate, note? }]

  status String @default("Planning") // Planning | Active | Closed

  // 季度回顾快照（PRD 14.1：季度结束后生成 接单量/出货量/毛利/客户分析）
  // 真源为订单实时聚合，此字段为生成时点快照，可重生成
  reviewJson Json? // { orderCount, shippedCount, revenue, cost, grossProfit, topCustomers, generatedAt }
  reviewedAt BigInt?

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  trendTags  TrendTag[]
  tradeShows TradeShow[]

  @@index([status])
  @@index([startDate])
}

// TrendTag：面料趋势标签（PRD 14.2）——类型封闭集 fabric|color|craft|composition
model TrendTag {
  id       String  @id // 格式：TRDT__${shortId}
  seasonId String? // 关联季度（null = 跨季趋势）

  type        String // fabric | color | craft | composition
  name        String
  description String?
  source      String? // manual | trade_show
  tradeShowId String? // 展会采集来源

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  season      Season?          @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  tradeShow   TradeShow?       @relation(fields: [tradeShowId], references: [id], onDelete: SetNull)
  fabricLinks TrendTagFabric[]

  @@index([seasonId])
  @@index([type])
}

// TrendTagFabric：趋势 ↔ 面料档案关联（PRD 14.2：推荐时优先展示当季趋势面料）
model TrendTagFabric {
  id         String @id // 格式：TRTF__${shortId}
  trendTagId String
  fabricId   String

  note      String?
  createdAt BigInt

  trendTag TrendTag      @relation(fields: [trendTagId], references: [id], onDelete: Cascade)
  fabric   FabricProfile @relation(fields: [fabricId], references: [id], onDelete: Cascade)

  @@unique([trendTagId, fabricId])
  @@index([fabricId])
}

// TradeShow：展会记录（PRD 14.3）
model TradeShow {
  id       String  @id // 格式：TRDS__${shortId}
  seasonId String? // 归属季度（可空）

  name      String
  location  String?
  startDate String // YYYY-MM-DD
  endDate   String?
  boothNo   String? // 展位号
  attendees String[] // 参展人员

  cost     Decimal? @db.Decimal(18, 4) // 展会费用（ROI 分母）
  currency String?  @default("CNY")

  status String @default("Planned") // Planned | Ongoing | Completed | Cancelled

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  season    Season?         @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  leads     TradeShowLead[]
  trendTags TrendTag[]

  @@index([seasonId])
  @@index([startDate])
  @@index([status])
}

// TradeShowLead：展会线索（PRD 14.3）——转化为 Relation 后订单归入展会 ROI
model TradeShowLead {
  id          String @id // 格式：TRDL__${shortId}
  tradeShowId String

  customerName String // 客户姓名
  company      String?
  country      String?
  email        String?
  phone        String?
  demand       String? // 需求描述

  status String @default("New") // New | Following | Converted | Lost

  // 转化路径：线索 → Relation（客户）→ 订单（ROI 归因）
  convertedRelationId String?
  convertedAt         BigInt?

  nextFollowUpAt String? // 下次跟进日期 YYYY-MM-DD

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  tradeShow TradeShow @relation(fields: [tradeShowId], references: [id], onDelete: Cascade)

  @@index([tradeShowId])
  @@index([status])
  @@index([convertedRelationId])
}

// ============ 阶段 H H3: 风险管理与合规 Risk Management（PRD 15） ============
// 设计口径：
//   - 逾期天数沿用 receivableOverdueDetector 口径：effectiveDue = dueDate ?? issueDate + 30 天
//   - RiskAlert.dedupKey @unique 为幂等真源：同键重复预警在 DB 层拒绝，不产生重复告警
//   - 关联（Order/Relation/CustomsDeclaration）均为 snapshot FK 风格，不加 @relation

// ExchangeRate：汇率档案（PRD 15.1）——currency → CNY 本位币，按 effectiveDate 取最新
model ExchangeRate {
  id            String  @id // 格式：FXR__${shortId}
  currency      String // USD | EUR | HKD ...（归一化大写）
  rate          Decimal @db.Decimal(18, 8) // 1 单位外币兑 CNY
  effectiveDate String // 生效日期 YYYY-MM-DD
  source        String  @default("manual") // manual | api
  note          String?
  createdAt     BigInt

  @@index([currency, effectiveDate])
}

// FxRateLock：大额订单汇率锁定（PRD 15.1）——锁定期间不受波动影响
model FxRateLock {
  id         String  @id // 格式：FXL__${shortId}
  orderId    String // 关联订单（snapshot FK）
  currency   String // 锁定币种（归一化大写）
  rate       Decimal @db.Decimal(18, 8) // 锁定汇率（外币 → CNY）
  lockedAt   BigInt
  lockedById String?
  note       String?
  createdAt  BigInt
  deletedAt  BigInt?

  @@index([orderId])
}

// CreditRating：信用评级（PRD 15.2）——append-only 评估历史，最新一条为当前评级
// factors 记录评估因子快照：{ onTimeRate, overdueCount, maxDaysOverdue, cooperationYears, settledCount }
/// ════════════════════════════════════════════════════════════════════
/// ★ D6（2026-09-18）远期结汇：与**银行**签的远期结汇合约
///
/// 为什么需要：本仓已有 `FxRateLock`（订单级锁汇：orderId+currency+rate，解决"这笔生意按什么汇率算成本/利润"）
/// 和 `FxSettlement`（每笔结汇水单：voucherId+foreignAmount+fxRate，解决"实际结了多少"）。
/// 但**与银行的远期合约**这一层没有 —— 于是：
///   · 到期日没人管（远期合约到期必须交割，晚了会有展期成本/罚息）
///   · 合约汇率 vs 实际结汇汇率的**损益**算不出来（这正是远期结汇的意义：锁汇率）。
///
/// 口径：**一笔合约可覆盖多笔结汇水单；一笔水单只能用一张合约（唯一键）**。
/// 已交割金额（`settledForeignAmount`）是派生值，由 `ForwardFxSettlementLink` 累计维护（同事务）。
/// ⓘ 不往 `FxRateLock` 里塞银行字段 —— `FxRateLock` 是订单侧的锁汇口径，两者语义不同（一个是内部定价锚，一个是外部金融合约）。
/// ════════════════════════════════════════════════════════════════════
model ForwardFxContract {
  id                   String  @id // 格式：FFX__${shortId}
  contractNumber       String  @unique // 银行合约号（对账口径）
  bankRelationId       String? // 银行（snapshot FK → Relation）
  bankName             String? // 银行名称快照
  currency             String // 外币币种（USD | EUR ...）
  /// 合约金额（外币）
  foreignAmount        Decimal @db.Decimal(18, 4)
  /// 约定汇率（外币 → CNY）
  contractRate         Decimal @db.Decimal(18, 8)
  signedDate           String // 签约日 YYYY-MM-DD
  maturityDate         String // 到期（交割）日 YYYY-MM-DD
  /// 已交割外币金额（累计；由 link 维护）。实际结汇汇率与合约汇率不同 → 损益在 link 上算并汇总。
  settledForeignAmount Decimal @default(0) @db.Decimal(18, 4)
  /// Open | PartiallySettled | Settled | Cancelled（派生，服务端维护；Cancelled 后不可再交割）
  status               String  @default("Open")
  notes                String?
  createdAt            BigInt
  updatedAt            BigInt
  deletedAt            BigInt?

  @@index([currency, status])
  @@index([maturityDate])
  @@index([bankRelationId])
}

/// 远期合约 ↔ 实际结汇水单（一笔合约可分次交割；一笔水单只能挂一张合约）
model ForwardFxSettlementLink {
  id            String  @id // 格式：FFSL__${shortId}
  contractId    String
  settlementId  String // FxSettlement.id（实际结汇水单）
  /// 本次用该合约交割的外币金额（≤ 合约剩余、≤ 水单剩余）
  foreignAmount Decimal @db.Decimal(18, 4)
  /// 实际结汇汇率（外币 → CNY；与合约汇率之差 × foreignAmount = 本次损益（CNY）
  actualRate    Decimal @db.Decimal(18, 8)
  settleDate    String // 交割日 YYYY-MM-DD
  operatorId    String?
  createdAt     BigInt
  deletedAt     BigInt?

  @@unique([contractId, settlementId]) // 一笔水单只能用一张合约
  @@index([contractId])
  @@index([settlementId])
}

model CreditRating {
  id          String  @id // 格式：CDR__${shortId}
  relationId  String // 关联客户（snapshot FK）
  grade       String // A | B | C | D
  score       Float // 0-100
  factors     Json
  evaluatedAt BigInt
  evaluatedBy String? // null = 系统自动评估
  createdAt   BigInt

  @@index([relationId, evaluatedAt])
}

// ComplianceCheck：合规检查记录（PRD 15.3）——HS Code / 出口管制 / 原产地规则
model ComplianceCheck {
  id          String  @id // 格式：CPC__${shortId}
  type        String // hs_code | export_control | origin_rule
  targetType  String // CustomsDeclaration | Order | ProductAsset
  targetId    String
  result      String // pass | warn | fail
  summary     String
  details     Json?
  checkedById String? // null = 系统自动
  checkedAt   BigInt
  createdAt   BigInt

  @@index([type])
  @@index([targetType, targetId])
  @@index([result])
}

// RiskAlert：统一风险预警中心（PRD 15.5）——各维度预警统一落地此处
model RiskAlert {
  id          String  @id // 格式：RSKA__${shortId}
  type        String // fx_volatility | credit_frozen | bad_debt | compliance_fail | quality_repeat
  level       String // info | warning | critical
  title       String
  content     String
  relatedType String?
  relatedId   String?
  dedupKey    String  @unique // 幂等真源：如 bad_debt:${invoiceId} / fx_volatility:${currency}:${date}
  status      String  @default("Open") // Open | Acknowledged | Resolved
  createdAt   BigInt
  updatedAt   BigInt
  resolvedAt  BigInt?

  @@index([type])
  @@index([status])
  @@index([level])
}

// ============ 阶段 P0 回补: 业务线 / QC 工作台（PRD 6.2 / 4.2 / 5.2） ============
// 设计口径：
//   - Order.businessLine 为 BusinessLine.code 的 snapshot 引用（不加 @relation，与全库一致）
//   - 船样/匹头样追踪字段已在 Order（sampleSentDate/fabricSampleSentDate 等），
//     本批次只补「Exmill 前未确认」预警层，不重复建样品模型
//   - QC 人员身份用 UserAccount snapshot FK；QC 任务完成态关联 InspectionReport

// BusinessLine：业务线注册表（PRD 6.2 P0）——影响 MOQ 校验 / 生产流程 / 报表
model BusinessLine {
  id   String @id // 格式：BL__${shortId}
  code String @unique // fabric | garment | capsule
  name String // 面料大货 | 成衣大货 | 成衣 Capsule

  description String?

  // ─── 业务规则基准 ───
  moqValue            Float? // MOQ 校验基准（软校验，产出警示不阻断）
  moqUnit             String? // M | PC
  productionCycleDays Int? // 生产周期天数（面料 70 天）
  paymentTermsHint    String? // 付款条件提示（T/T 30 天 / T/T 60 天）

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([isActive])
}

// QCLocation：QC 驻地管理（PRD 6.2 P0）——温州（服装）/ 苏州（面料）
model QCLocation {
  id   String @id // 格式：QCL__${shortId}
  code String @unique // wenzhou | suzhou
  name String // 温州驻场 | 苏州驻场

  region  String? // 区域
  focus   String? // 驻地主攻业务线：garment | fabric
  address String?

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  assignments QCAssignment[]
}

// QCAssignment：QC 验货任务分配（PRD 6.2 P0 / 4.2 QC 工作台）
model QCAssignment {
  id      String @id // 格式：QCA__${shortId}
  orderId String // 关联订单（snapshot FK）

  inspectionType String // midline（中期验货） | final（终期验货）
  scopeType               String @default("whole_order")
  scopeKey                String @default("whole_order")
  productionBatchId       String?
  productionBatchRevision Int?
  scopeSnapshot           Json?
  scopeFingerprint        String?
  requestKey              String?
  commandHash             String?

  qcUserId          String? // 执行 QC（UserAccount snapshot FK）；null 表示尚未认领
  locationId        String? // 所属驻地
  factoryRelationId String? // 验货工厂（Relation snapshot FK，冗余自 Order.millRelationId）

  status String @default("Assigned") // Assigned | InProgress | Completed | Cancelled

  dueDate      String? // 要求完成日期 YYYY-MM-DD
  assignedAt   BigInt
  assignedById String?
  completedAt  BigInt?
  reportId     String? // 完成后关联 InspectionReport

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  location QCLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([qcUserId, status])
  @@index([orderId])
  @@index([status])
  @@index([dueDate])
  @@index([orderId, inspectionType, scopeKey])
  @@index([productionBatchId])
  @@unique([assignedById, requestKey])
}

// ============ 阶段 P1：定价与利润（PRD 8 双轨制 / 6.2 P1 缺口） ============
// 设计口径：
//   - 轨道 A 估算载体为既有 CostEstimate（BOM 模块），本批次不重复建模
//   - 轨道 B 派生值（netUsdCost/profit/commission/finalUnitPrice）一律服务端重算，不接受客户端传入
//   - 汇率/退税率默认值分别取自 ExchangeRate（H3 getLatestRates）与 TaxRefundRate 最长前缀命中
//   - OrderProfitSheet 一单一张（orderId @unique），重生成=覆盖更新，幂等真源为 orderId

// TaxRefundRate：出口退税率表（PRD 8.5 P1）——HS Code → 退税率映射，查询按最长前缀命中
model TaxRefundRate {
  id     String  @id // 格式：TRR__${shortId}
  hsCode String  @unique // 支持 2/4/6/8/10 位编码
  rate   Decimal @db.Decimal(8, 4) // 退税率百分比（13 = 13%）

  description String?
  isActive    Boolean @default(true)

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([isActive])
}

// PricingCalculation：退税美元定价记录（轨道 B，PRD 8.2/8.6）
model PricingCalculation {
  id String @id // 格式：PRC__${shortId}

  // ─── 输入项 ───
  purchaseCostCny Decimal @db.Decimal(18, 4) // 人民币成本单价（工厂采购价）
  refundRate      Decimal @db.Decimal(8, 4) // 退税率百分比（0-16）
  exchangeRate    Decimal @db.Decimal(18, 8) // CNY per USD（¥/$）
  profitMargin    Decimal @db.Decimal(8, 4) // 利润率百分比
  commissionRate  Decimal @default(0) @db.Decimal(8, 4) // 中间人佣金率（0=无 / 5=E5 / 10=E10）

  // ─── 派生项（服务端重算） ───
  netUsdCost       Decimal @db.Decimal(18, 4) // 退税后美元成本 = purchaseCostCny × (1 - refundRate%) ÷ exchangeRate
  profitAmount     Decimal @db.Decimal(18, 4) // = netUsdCost × profitMargin%
  commissionAmount Decimal @db.Decimal(18, 4) // = netUsdCost × commissionRate%
  finalUnitPrice   Decimal @db.Decimal(18, 4) // 终价美元单价 = netUsdCost + profit + commission

  // ─── 关联（snapshot FK，不强制约束） ───
  orderId          String?
  quotationId      String?
  productAssetId   String?
  hsCode           String? // 退税率来源 HS Code（追溯）
  fxLockId         String? // 使用锁定汇率时关联 FxRateLock
  commissionRuleId String? // 佣金率来源 CommissionRule（追溯；rate 已落库为快照）

  quantity Decimal? @db.Decimal(18, 4) // 数量（前端算总额用，不参与单价推导）

  status    String  @default("Draft") // Draft | Confirmed | Archived
  notes     String?
  createdBy String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([orderId])
  @@index([quotationId])
  @@index([status])
}

// OrderProfitSheet：订单级利润表（PRD 6.2 P1 / 8.3 订单利润分析）
// 聚合口径（归一化至 baseCurrency=CNY）：
//   销售收入 = Σ 应收发票（type=Receivable，非 Cancelled）amount × 汇率快照
//   采购成本 = Σ 采购单（非 Cancelled）totalAmount × 汇率快照
//   运费     = Σ 运单（非 Cancelled）freight+insurance+customs+otherCharges（按最新汇率折算）
//   杂费     = Σ 付款凭证（type=Disbursement，orderId 匹配，未核销发票）amount × 汇率快照
//   无可用汇率的外币行不计入合计，列入 details.unconverted 透明披露
/// Immutable whole-order actual-cost confirmation, including current source and private evidence fingerprints.
model OrderCostReview {
  id String @id
  orderId String
  revision Int
  requestKey String @unique
  requestFingerprint String
  sourceFingerprint String
  scopeSnapshot Json
  linesSnapshot Json
  coverageSnapshot Json
  evidenceSnapshot Json
  actualCostCny Decimal @db.Decimal(18, 4)
  actualRevenueCny Decimal @db.Decimal(18, 4)
  confirmedBy String
  confirmedAt BigInt
  supersedesId String? @unique
  auditId String @unique

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  confirmer UserAccount @relation("OrderCostReviewConfirmer", fields: [confirmedBy], references: [id], onDelete: Restrict)
  audit AuditLog @relation("OrderCostReviewAudit", fields: [auditId], references: [id], onDelete: Restrict)
  supersedes OrderCostReview? @relation("OrderCostReviewRevision", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy OrderCostReview? @relation("OrderCostReviewRevision")

  @@unique([orderId, revision])
  @@index([orderId, confirmedAt])
}

/// Private immutable evidence metadata; original bytes remain outside public uploads.
model OrderCostReviewEvidence {
  id String @id
  orderId String
  requestKey String @unique
  requestFingerprint String
  originalName String
  storageKey String @unique
  mimeType String
  byteSize Int
  sha256 String
  note String
  createdBy String
  createdAt BigInt
  auditId String @unique

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  uploader UserAccount @relation("OrderCostReviewEvidenceUploader", fields: [createdBy], references: [id], onDelete: Restrict)
  audit AuditLog @relation("OrderCostReviewEvidenceAudit", fields: [auditId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model OrderProfitSheet {
  id      String @id // 格式：OPS__${shortId}
  orderId String @unique // 一单一张，重生成=覆盖更新（幂等真源）

  baseCurrency  String   @default("CNY")
  salesRevenue  Decimal  @default(0) @db.Decimal(18, 4)
  purchaseCost  Decimal  @default(0) @db.Decimal(18, 4)
  freightCost   Decimal  @default(0) @db.Decimal(18, 4)
  miscCost      Decimal  @default(0) @db.Decimal(18, 4)
  /// ★ 银行手续费成本（口径 D7-①）：收款凭证(Receipt) bankFee 折算本位币合计。
  ///   「收款侧手续费此前全仓零消费」⇒ 利润虚高；现单列，不改核销额（不动账龄/授信/批次结清）
  bankFeeCost   Decimal  @default(0) @db.Decimal(18, 4)
  /// ★ 折让/索赔成本（口径 D7-②）：抵扣到本单应收票的 CreditNoteAllocation 折算本位币合计。
  ///   单列成本项，**不改既有收入口径**（收入仍 = Σ应收发票面额）
  allowanceCost Decimal  @default(0) @db.Decimal(18, 4)
  grossProfit   Decimal  @default(0) @db.Decimal(18, 4)
  grossMargin   Decimal? @db.Decimal(8, 4) // 毛利率 %（salesRevenue=0 时 null）

  details Json // { sales: [...], purchases: [...], freight: [...], misc: [...], bankFees: [...], allowances: [...], unconverted: [...] }

  version     Int    @default(1) // 每次重生成 +1
  generatedAt BigInt

  createdAt BigInt
  updatedAt BigInt

  @@index([generatedAt])
}

// MaterialPriceHistory：原材料价格历史（PRD 8.5 P1，轨道 A 估算校准数据源）
model MaterialPriceHistory {
  id            String  @id // 格式：MPH__${shortId}
  materialType  String // yarn | fabric | trimming
  materialCode  String? // 物料编码（面料/辅料编码，可空=通用行情）
  name          String // 物料名称
  specification String? // 规格描述

  price    Decimal @db.Decimal(18, 4)
  unit     String // M | YD | KG | PC
  currency String  @default("CNY")

  priceDate String // 价格生效日 YYYY-MM-DD
  source    String @default("manual") // manual | purchase-order | quotation

  supplierRelationId String?
  supplierName       String?

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([materialType, materialCode, priceDate])
  @@index([priceDate])
}

// ============ 阶段 P2：佣金规则 / 电子画册 / 面料推荐（PRD 6.2 P2 缺口） ============
// 设计口径：
//   - CommissionRule 是佣金率的配置真源；PricingCalculation.commissionRate 仍落库为数值快照
//     （规则后续调整不回溯历史定价记录），commissionRuleId 记录来源规则以便追溯
//   - LookbookCatalog.items 为 JSON 快照数组：服务端在写操作时从 ProductAsset 重取名称/图片/成本，
//     客户端传入仅作选择依据——画册内容口径以档案真源为准
//   - FabricRecommendation 持久化推荐请求与结果（criteria/results JSON），可审计可复用；
//     打分为服务端确定性算法（非 LLM），同一 criteria 结果可重现

// CommissionRule：中间人佣金规则（PRD 8.5 P2，E5/E10）
// 匹配口径：intermediaryRelationId 精确命中优先；intermediaryRelationId 为空的记录为默认规则兜底
model CommissionRule {
  id   String  @id // 格式：CR__${shortId}
  name String // 规则名（如 "E5-某代理"）
  rate Decimal @db.Decimal(8, 4) // 佣金率百分比（5 = E5 / 10 = E10）

  intermediaryRelationId String? // 中间人 Relation snapshot FK（空 = 默认规则）
  intermediaryName       String? // 中间人名称快照（列表展示用）

  isActive Boolean @default(true)
  notes    String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([intermediaryRelationId, isActive])
  @@index([isActive])
}

// LookbookCatalog：电子画册（PRD 6.2 P2）——产品图片 + 描述 + 价格 → Web 预览/打印 PDF
model LookbookCatalog {
  id          String  @id // 格式：LB__${shortId}
  title       String
  description String?

  status      String  @default("Draft") // Draft | Published | Archived
  items       Json    @default("[]") // [{ productAssetId, sku, name, description?, price?, currency?, imageUrl?, sortOrder }]
  publishedAt BigInt?

  createdBy String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([status])
  @@index([createdAt])
}

// FabricRecommendation：面料推荐记录（PRD 6.2 P2）
// criteria: { composition?, weightMin?, weightMax?, pattern?, priceMin?, priceMax?, quantity?, targetLeadDays?, limit? }
// results:  [{ productAssetId, sku, name, score, breakdown: { composition, weight, pattern, price, moq, leadTime } }]
model FabricRecommendation {
  id       String @id // 格式：FR__${shortId}
  criteria Json
  results  Json

  createdBy String?
  createdAt BigInt
  deletedAt BigInt?

  @@index([createdAt])
}

// ============ 阶段 P3a: 单据模板与版本（PRD 11.3） ============
// 设计决策：
//   - DocumentTemplate 为每类单据的标准模板（公司抬头/条款/格式），content 为 HTML，支持 {{var}} 占位符；
//     variables 创建/更新时自动从 content 解析（与邮件模板同口径，共享 lib/templateVariables）
//   - isDefault 同 type+language 下唯一（service 事务内清除其他默认），供自动生成草稿时选真源
//   - DocumentVersion 为 TradeDocument 内容变更留痕：版本号按 documentId 单调递增（max+1），
//     content 为变更后整行字段快照（Json），可审计可回溯；版本只增不删（随主单软删隐藏）

// DocumentTemplate：单据模板（PRD 11.3 P1）
model DocumentTemplate {
  id   String @id // 格式：DTPL__${shortId}
  type String // Quotation | SalesConfirmation | ProformaInvoice | CommercialInvoice | PackingList | BillOfLading | AirWaybill | CertificateOfOrigin | InsuranceCert | InspectionCert | InspectionReport | Statement | Other

  name     String // 模板名称（如 "商业发票标准模板-中英"）
  language String @default("bilingual") // zh | en | bilingual

  content   String // HTML 模板（支持 {{variable}} 占位符）
  variables String[] // 变量清单（自动从 content 解析，冗余存储供 UI 生成填写项）

  isDefault Boolean @default(false) // 同 type+language 下仅一个默认模板
  isActive  Boolean @default(true)

  notes     String?
  createdBy String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([type, language])
  @@index([isDefault])
  @@index([isActive])
}

// DocumentVersion：单据版本留痕（PRD 11.3 P2）
model DocumentVersion {
  id         String @id // 格式：DVER__${shortId}
  documentId String // 关联 TradeDocument（snapshot FK）
  version    Int // 按 documentId 单调递增（1 起）

  content      Json // 变更后单据字段快照
  changeReason String? // 变更原因
  changedBy    String? // 修改人

  createdAt BigInt

  @@unique([documentId, version])
  @@index([documentId])
}

// ============ 阶段 P3b: 品牌线 / 沟通日志 / 邮件签名（PRD 6.2 / 12.1 / 12.3） ============
// 设计决策：
//   - BrandLine 挂 Relation（snapshot FK，不对 Relation 加反向字段，与 CommissionRule 同口径）；
//     同客户下品牌线名称唯一（含软删记录占位，防复活冲突——与 CommissionRule 启用占位同思路）
//   - CommunicationLog 与 FollowUpRecord 分工：FollowUpRecord 是跟进动作（含下次跟进计划/可转任务），
//     CommunicationLog 是全渠道沟通流水（方向 Inbound/Outbound + 渠道 + 摘要 + 邮件/订单/报价关联），
//     客户 360° 时间线由两者共同构成
//   - EmailSignature 同 language 下 isDefault 唯一（service 事务内清除其他默认），
//     content 支持 {{variable}}（共享 lib/templateVariables，与邮件/单据模板同口径）

// BrandLine：客户品牌下的产品线（PRD 6.2 P1）——如某品牌 → 正装线/休闲线/设计师线
model BrandLine {
  id         String @id // 格式：BL__${shortId}
  relationId String // 所属客户 Relation snapshot FK

  name        String // 品牌线名称（同客户下唯一）
  code        String? // 品牌线编码
  description String?

  isActive Boolean @default(true)
  notes    String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([relationId])
  @@index([isActive])
}

// CommunicationLog：沟通日志（PRD 12.3 P1）——全渠道沟通流水
model CommunicationLog {
  id         String  @id // 格式：CL__${shortId}
  relationId String // 关联客户 Relation snapshot FK
  contactId  String? // 关联联系人

  type       String // Email | Call | WeChat | Visit | Meeting | Other
  direction  String  @default("Outbound") // Inbound | Outbound
  subject    String? // 主题
  summary    String // 沟通摘要
  occurredAt String // 沟通日期 YYYY-MM-DD

  emailMessageId String? // 关联邮件消息（邮件渠道时）
  orderId        String? // 关联订单
  quotationId    String? // 关联报价

  loggedBy  String? // 记录人
  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([relationId])
  @@index([contactId])
  @@index([type])
  @@index([occurredAt])
}

// EmailSignature：邮件签名（PRD 12.1 P2）——统一公司签名格式，含联系方式/地址/银行信息
model EmailSignature {
  id   String @id // 格式：ESIG__${shortId}
  name String // 签名名称（如 "默认英文签名"）

  language  String   @default("bilingual") // zh | en | bilingual
  content   String // 签名内容（HTML/文本，支持 {{variable}} 如 {{senderName}}）
  variables String[] // 自动从 content 解析（冗余存储供 UI 生成填写项）

  isDefault Boolean @default(false) // 同 language 下仅一个默认签名
  isActive  Boolean @default(true)

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([language])
  @@index([isDefault])
  @@index([isActive])
}

// ============ §10.3-9 电子签·印章库 Seal（签章管理） ============
model Seal {
  id           String @id // 格式：SEAL__${shortId}
  name         String // 印章名称（如 "公司公章" / "老板私章" / "财务专用章"）
  type         String @default("company_seal") // company_seal | legal_rep_seal | finance_seal | other
  imageDataUrl String // 公章图（base64 data URL，PNG；服务端限长）

  ownerRoleId String? // 适用角色（如 role-super-admin 用老板私章）；null = 不限定角色
  ownerUserId String? // 适用具体用户；null = 不限定用户
  isDefault   Boolean @default(false) // 无角色/用户匹配时的兜底章（全局唯一）
  isActive    Boolean @default(true)

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([type])
  @@index([isDefault])
  @@index([isActive])
  @@index([ownerRoleId])
  @@index([ownerUserId])
}

// ============ Phase 2 B2: 库存管理 Inventory Management ============

model Warehouse {
  inboundTransfers InventoryTransfer[] @relation("TransferDestination")

  profile Json? // 仓库地域、保管关联、租赁及计费档案；不含库存货权

  id        String  @id // 格式：WH_${shortId}
  code      String  @unique // 仓库编码（如 WH-001 / SH-MAIN）
  name      String // 仓库名称
  type      String // Main(主仓) | Auxiliary(辅仓) | Temporary(临时仓) | Virtual(虚拟仓)
  address   String? // 仓库地址
  manager   String? // 仓库管理员
  phone     String? // 联系电话
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
  notes     String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  items InventoryItem[]

  @@index([type])
  @@index([isActive])
}

model InventoryItem {
  ownerRelationId String? // 已转移货权的真实组织 ID；我方货权为空
  ownershipDate String?
  ownershipEvidence String?
  outboundTransfers InventoryTransfer[]

  details Json? // 面料卷号、色缸及成衣尺码等实物批次明细

  id             String  @id // 格式：INV_${shortId}
  warehouseId    String
  productAssetId String? // 关联产品档案（面料/辅料/成衣）
  materialCode   String? // 物料编码（可独立于产品档案，如临时编码）
  description    String // 品名描述
  category       String? // Fabric | Trimmings | Accessories | Garment | Other
  specification  String? // 规格描述
  batchNumber    String? // 批次号（可追溯）
  locationCode   String? // 库位编码（如 A-01-03）

  // ─── 数量 ───
  quantity       Decimal @db.Decimal(18, 4) // 当前库存数量
  lockedQuantity Decimal @default(0) @db.Decimal(18, 4) // 锁定/预留数量（已分配未出库）
  unit           String // YD | M | KG | PC | SET

  // ─── 成本 ───
  unitCost Decimal? @db.Decimal(18, 4) // 单位成本
  currency String   @default("CNY")

  // ─── D7-② 货权（2026-09-16）─────────────────────────────────────────
  // 货权是**「这批货」的属性，不是「这个仓」的属性** —— 同一个第三方仓里可能同时存在
  // 我方货权（Owned）与货权已转移（Transferred）的货，挂在 Warehouse 上表达不了这种混合。
  // 口径：**资产/存货报表按货权汇总，不按物理位置**（货权已转移的货不得计入我方存货）；
  //       与 D2-Q4「CIF 垫付运费改开应收」同属一处原则：账按权利义务记，不按物理位置记。
  ownership String @default("Owned") // Owned(我方货权) | Transferred(货权已转移)

  // ─── ★ C4 订单锚点（2026-09-18）────────────────────────────────────
  // 背景：备货（无单先产）在面料行业很常见 —— 工厂按预测先做，等订单来了再归属。
  // 此前 InventoryItem **完全没有订单锚点**（`StockMovement.referenceType/Id` 只记流水，
  // 表达不了「这批货现在挂在谁头上」）⇒ 备货无法归属、A 单货挪 B 单**无留痕**。
  // 口径：`orderId = null` + `stockPrep = true` ⇒ 备货；`orderId = null` + `stockPrep = false`
  //       ⇒ 通用库存（未归属，如常备料）；归属变更一律走 `InventoryOwnershipChange` 留痕。
  orderId   String? // 归属订单（snapshot FK → Order.id；null = 未归属）
  stockPrep Boolean @default(false) // 备货（无单先产）：已生产但尚未接到订单

  // ─── 预警 ───
  minStock Decimal? @db.Decimal(18, 4) // 最低库存预警线
  maxStock Decimal? @db.Decimal(18, 4) // 最高库存预警线

  // ─── 日期 ───
  lastInDate  String? // 最后入库日期
  lastOutDate String? // 最后出库日期

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  productionStockReceipt ProductionStockReceipt?
  movements StockMovement[]

  @@index([warehouseId])
  @@index([ownership])
  @@index([productAssetId])
  @@index([orderId]) // ★ C4：按订单查该单占用的货
  @@index([stockPrep]) // ★ C4：备货筛选
  @@index([materialCode])
  @@index([category])
  @@index([batchNumber])
  @@index([ownerRelationId])
}

// ════════════════════════════════════════════════════════════════════
// InventoryOwnershipChange — ★ C4 库存归属变更留痕（2026-09-18）
// ════════════════════════════════════════════════════════════════════
// 为什么单独一张表，而不是复用 StockMovement：
//   归属变更**不改变数量**（A 单货挪 B 单，件数没动），而 `StockMovement.quantity` 是必填的
//   数量字段 —— 塞 0 会让流水看起来像「数量 0 的调整」（脏数据，且污染数量口径统计）。
//   语义也不同：流水记「货动了多少」，本表记「这批货归谁」。
//
// 口径：**append-only**（归属变更历史不可改；当前态看 `InventoryItem.orderId/stockPrep`）。
//   action ∈ mark_stock_prep（标记备货）| attribute（备货→订单）| reassign（订单→订单，即「挪货」）
//           | release（退回未归属/备货）
// ════════════════════════════════════════════════════════════════════
model InventoryOwnershipChange {
  id String @id // 格式：IOC_${shortId}

  itemId      String // 关联 InventoryItem
  /// 变更前归属（null = 未归属）
  fromOrderId String?
  /// 变更后归属（null = 未归属）
  toOrderId   String?
  /// 变更类型（封闭集，见文件头）
  action      String

  /// 事由（必填 —— 「A 单货挪 B 单」必须说清为什么）
  reason     String
  operatorId String?
  createdAt  BigInt

  @@index([itemId])
  @@index([toOrderId])
  @@index([fromOrderId])
  @@index([action])
}

model InventoryTransfer {
  id String @id
  requestKey String @unique
  requestHash String
  sourceItemId String
  targetWarehouseId String
  quantity Decimal @db.Decimal(18,4)
  receivedQuantity Decimal @default(0) @db.Decimal(18,4)
  unit String
  status String @default("pending")
  note String
  createdBy String
  dispatchedAt String?
  completedAt String?
  history Json @default("[]")
  createdAt BigInt
  updatedAt BigInt
  sourceItem InventoryItem @relation(fields:[sourceItemId],references:[id])
  targetWarehouse Warehouse @relation("TransferDestination",fields:[targetWarehouseId],references:[id])
  @@index([status])
  @@index([sourceItemId])
}

model StockMovement {
  id             String @id // 格式：SM_${shortId}
  movementNumber String // 流水单号（如 SM-20260806-001）
  type           String // Inbound(入库) | Outbound(出库) | Transfer(调拨) | Adjustment(盘点调整) | Lock(锁定) | Unlock(解锁)

  // ─── 关联库存项 ───
  itemId            String // 关联 InventoryItem
  warehouseId       String // 操作仓库（源仓库）
  targetWarehouseId String? // 调拨目标仓库（仅 Transfer 类型）

  // ─── 数量 ───
  /// ★ 口径（2026-09-17 校正，口径 E1）：本字段恒为**绝对值（正数）**，方向由 `type` 表达
  ///   （Inbound / Outbound / Transfer …）。
  ///   ⚠️ 原注释写「Outbound 负」是**错的** —— `inventoryService` 写的是 `moveQty`（恒正，
  ///      出库方向体现在 `InventoryItem.quantity` 的 `increment: -moveQty`）。
  ///   两者是**不同字段、不同语义**，不是"同表两种口径"：
  ///     · `StockMovement.quantity` = 本次**变动量的绝对值**（恒正，用于流水展示/审计）
  ///     · `InventoryItem.quantity` = **带符号的当前余额**（出库递减）
  quantity      Decimal  @db.Decimal(18, 4)
  unit          String
  unitCost      Decimal? @db.Decimal(18, 4) // 变动时的单位成本
  balanceBefore Decimal  @db.Decimal(18, 4) // 变动前余额
  balanceAfter  Decimal  @db.Decimal(18, 4) // 变动后余额

  // ─── 来源追溯 ───
  reason        String? // 变动原因
  referenceType String? // PurchaseOrder | Order | Shipment | ProductionStage | Adjustment | Manual
  referenceId   String? // 关联单据 ID

  // ─── 操作人 ───
  operator     String? // 操作人
  movementDate String // 变动日期 YYYY-MM-DD

  notes     String?
  createdAt BigInt

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  productionStockReceipt ProductionStockReceipt?

  @@index([itemId])
  @@index([type])
  @@index([warehouseId])
  @@index([movementDate])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

// ============ Phase 2 B4: BOM / 成本核算 Bill of Materials ============
model BOM {
  id        String @id // 格式：BOM_${shortId}
  bomNumber String @unique // 业务 BOM 号（如 BOM-20260806-001）

  // ─── 业务字段 ───
  status      String // Draft(草稿) | Confirmed(已确认) | Archived(已归档)
  description String // BOM 描述（如：男款西装外套 - 款号 M2026-001）

  // ─── 关联（snapshot FK，不强制约束） ───
  productAssetId String? // 关联产品档案（成衣款式）
  orderId        String? // 关联订单（订单确认后自动生成 BOM）
  quotationId    String? // 关联报价单

  // ─── 版本 ───
  version     Int     @default(1) // BOM 版本号（修订递增）
  parentBomId String? // 上一版本 BOM ID（版本追溯）

  // ─── 成本汇总（料/工/费） ───
  totalMaterialCost Decimal @default(0) @db.Decimal(18, 4) // 物料成本合计
  totalLaborCost    Decimal @default(0) @db.Decimal(18, 4) // 人工成本合计
  totalOverheadCost Decimal @default(0) @db.Decimal(18, 4) // 制造费用合计
  totalCost         Decimal @default(0) @db.Decimal(18, 4) // 总成本 = 物料 + 人工 + 费用
  currency          String  @default("CNY")

  // ─── 利润分析 ───
  sellingPrice Decimal? @db.Decimal(18, 4) // 销售单价
  profitMargin Decimal? @db.Decimal(8, 4) // 利润率（%）
  profitAmount Decimal? @db.Decimal(18, 4) // 利润额 = sellingPrice - totalCost

  // ─── 备注 ───
  notes       String?
  attachments Json?

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  // ─── 关联行 ───
  lines         BOMLine[]
  costEstimates CostEstimate[]

  @@index([status])
  @@index([productAssetId])
  @@index([orderId])
  @@index([quotationId])
  @@index([bomNumber])
}

model BOMLine {
  id         String @id
  bomId      String
  lineNumber Int

  // ─── 物料明细 ───
  materialType  String // Main(主料) | Contrast(对比料) | Lining(里布) | Pocketing(口袋布) | Trimmings(辅料) | Thread(缝纫线) | Packaging(包装) | Other
  materialCode  String? // 物料编码
  description   String // 品名描述
  category      String? // Fabric | Trimmings | Accessories | Garment | Other
  specification String? // 规格描述
  supplierId    String? // 供应商 ID（snapshot）

  // ─── 用量 + 成本 ───
  quantity       Decimal @db.Decimal(18, 4) // 单件用量
  unit           String // YD | M | KG | PC | SET
  wastagePercent Decimal @default(0) @db.Decimal(8, 4) // 损耗率（%）
  effectiveQty   Decimal @db.Decimal(18, 4) // 实际用量 = quantity * (1 + wastage%)
  unitCost       Decimal @db.Decimal(18, 4) // 单价
  amount         Decimal @db.Decimal(18, 4) // 行金额 = effectiveQty * unitCost
  currency       String  @default("CNY")

  notes     String?
  createdAt BigInt
  updatedAt BigInt

  // ─── 关联 ───
  bom BOM @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@index([materialCode])
  @@index([materialType])
  @@index([category])
}

model CostEstimate {
  id    String @id
  bomId String

  // ─── 成本类型 ───
  costType    String // Material(物料) | Labor(人工) | Overhead(制造费用) | Other(其他)
  description String // 成本项描述（如：裁剪人工 / 缝纫人工 / 厂房折旧 / 检验费）

  // ─── 金额 ───
  amount   Decimal @db.Decimal(18, 4)
  currency String  @default("CNY")

  // ─── 备注 ───
  notes     String?
  createdAt BigInt
  updatedAt BigInt

  // ─── 关联 ───
  bom BOM @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@index([costType])
}

// ════════════════════════════════════════════════════════════════════
// Production MES Module — 生产制造执行系统深化 (Phase 3 C2)
// ════════════════════════════════════════════════════════════════════
// 设计决策：
//   - WorkStation: 物理生产资源（缝纫线/裁剪台/印花机等），独立于订单
//   - ProductionPlan: 排产单，将订单工序分配到工位并安排时间
//   - WorkHour: 工时记录，按员工+排产单维度记录
//   - PieceRateRule/Record: 计件工资规则与记录（单价快照防回溯）
//   - OutsourcingOrder/Line: 外协订单管理
//   - 跨模块关联用 snapshot FK 风格（orderId/employeeId/supplierId），不加 @relation
//   - 日期用 String YYYY-MM-DD，时间戳用 BigInt epoch ms
// ════════════════════════════════════════════════════════════════════

model WorkStation {
  id   String @id // 格式：WS_${shortId}
  code String @unique // 工位编码（如 WS-001 / SEW-LINE-A）
  name String // 工位名称
  type String // Sewing(缝纫) | Cutting(裁剪) | Printing(印花) | Embroidery(绣花) | Packing(包装) | QC(质检) | Other(其他)

  // ─── 产能 ───
  capacityPerDay Decimal? @db.Decimal(18, 4) // 日产能（单位/天）
  capacityUnit   String? // 产能单位（PC / SET / DZ）

  // ─── 状态 ───
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // ─── 其他 ───
  location String? // 工位位置（车间/楼层）
  manager  String? // 工位负责人
  notes    String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  productionPlans ProductionPlan[]

  @@index([type])
  @@index([isActive])
}

model ProductionPlan {
  id         String @id // 格式：PP_${shortId}
  planNumber String @unique // 排产单号（如 PP-20260807-001）

  // ─── 关联 ───
  orderId       String? // 关联订单（跨模块 snapshot FK）
  workStationId String

  // ─── 工序类型 ───
  processType String // Sewing | Cutting | Printing | Embroidery | Packing | QC | Other
  processSeq  Int    @default(0) // 工序顺序号

  // ─── 数量 ───
  plannedQuantity Decimal @db.Decimal(18, 4) // 计划数量
  actualQuantity  Decimal @default(0) @db.Decimal(18, 4) // 实际完成数量
  unit            String // PC | SET | DZ

  // ─── 日期 ───
  plannedStartDate String // YYYY-MM-DD
  plannedEndDate   String // YYYY-MM-DD
  actualStartDate  String? // YYYY-MM-DD
  actualEndDate    String? // YYYY-MM-DD

  // ─── 状态 ───
  status   String @default("Draft") // Draft | Confirmed | InProgress | Completed | Cancelled
  priority String @default("Normal") // High | Normal | Low

  // ─── 人员 ───
  assignedTo String? // 负责人

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  workStation WorkStation @relation(fields: [workStationId], references: [id])
  workHours   WorkHour[]

  @@index([orderId])
  @@index([workStationId])
  @@index([status])
  @@index([processType])
}

model WorkHour {
  id               String  @id // 格式：WHR_${shortId}
  productionPlanId String
  employeeId       String? // 员工 ID（跨模块 snapshot FK）
  employeeName     String? // 员工姓名快照

  // ─── 工时 ───
  workDate      String // YYYY-MM-DD
  hours         Decimal @db.Decimal(8, 2) // 正常工时
  overtimeHours Decimal @default(0) @db.Decimal(8, 2) // 加班工时

  // ─── 备注 ───
  notes     String?
  createdAt BigInt
  updatedAt BigInt

  productionPlan ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)

  @@index([productionPlanId])
  @@index([employeeId])
  @@index([workDate])
}

model PieceRateRule {
  id   String @id // 格式：PRR_${shortId}
  code String @unique // 规则编码（如 PRR-001）
  name String // 规则名称

  // ─── 适用范围 ───
  processType    String // Sewing | Cutting | Printing | Embroidery | Packing | QC | Other
  productAssetId String? // 关联产品档案（跨模块 snapshot FK）

  // ─── 计件标准 ───
  unit        String // PC | SET | DZ | KG | YD
  ratePerUnit Decimal @db.Decimal(18, 4) // 单价

  // ─── 生效期 ───
  effectiveFrom String // YYYY-MM-DD
  effectiveTo   String? // YYYY-MM-DD（null 表示长期有效）

  // ─── 状态 ───
  isActive Boolean @default(true)

  // ─── 其他 ───
  description String?
  notes       String?
  createdAt   BigInt
  updatedAt   BigInt
  deletedAt   BigInt?

  records PieceRateRecord[]

  @@index([processType])
  @@index([productAssetId])
  @@index([isActive])
}

model PieceRateRecord {
  id String @id // 格式：PRC_${shortId}

  // ─── 关联 ───
  pieceRateRuleId  String
  productionPlanId String? // 关联排产单（可选）
  employeeId       String? // 员工 ID（跨模块 snapshot FK）
  employeeName     String? // 员工姓名快照

  // ─── 计件数据 ───
  workDate String // YYYY-MM-DD
  quantity Decimal @db.Decimal(18, 4) // 完成数量
  unit     String // PC | SET | DZ

  // ─── 金额 ───
  ratePerUnit Decimal @db.Decimal(18, 4) // 单价快照（记录时点的单价）
  amount      Decimal @db.Decimal(18, 4) // 金额 = quantity × ratePerUnit
  currency    String  @default("CNY")

  // ─── 状态 ───
  status String @default("Pending") // Pending | Confirmed | Paid

  // ─── 其他 ───
  notes     String?
  createdAt BigInt
  updatedAt BigInt

  pieceRateRule PieceRateRule @relation(fields: [pieceRateRuleId], references: [id])

  @@index([pieceRateRuleId])
  @@index([productionPlanId])
  @@index([employeeId])
  @@index([workDate])
  @@index([status])
}

model OutsourcingOrder {
  id          String @id // 格式：OSO_${shortId}
  orderNumber String @unique // 外协单号（如 OSO-20260807-001）

  // ─── 关联 ───
  supplierId String? // 供应商 ID（跨模块 snapshot FK → Relation）
  businessOwnerId String?
  approvedCommitmentRevisionId String?
  paymentTerms String?
  mainDeliveryLocationKey String?
  mainDeliveryLocation Json?
  orderId    String? // 关联订单（跨模块 snapshot FK）
  bomId      String? // 关联 BOM（跨模块 snapshot FK）

  // ─── 外协内容 ───
  processType String // Sewing | Cutting | Washing | Printing | Embroidery | Dyeing | Other
  description String? // 外协内容描述

  // ─── 数量 ───
  quantity Decimal @db.Decimal(18, 4)
  unit     String // PC | SET | DZ | KG

  // ─── 价格 ───
  unitPrice   Decimal @db.Decimal(18, 4)
  currency    String  @default("CNY")
  totalAmount Decimal @default(0) @db.Decimal(18, 4) // = quantity × unitPrice

  // ─── 日期 ───
  orderDate           String? // YYYY-MM-DD
  plannedDeliveryDate String? // YYYY-MM-DD
  actualDeliveryDate  String? // YYYY-MM-DD

  // ─── 质量验收 ───
  qualityAcceptedQty Decimal @default(0) @db.Decimal(18, 4) // 合格数量
  qualityRejectedQty Decimal @default(0) @db.Decimal(18, 4) // 不合格数量

  // ─── 状态 ───
  status String @default("Draft") // Draft | Sent | Confirmed | InProduction | Received | Cancelled

  // ─── 其他 ───
  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  lines OutsourcingLine[]
  commitmentRevisions SupplierCommitmentRevision[] @relation("ProcessingCommitmentRevisions")
  approvedCommitmentRevision SupplierCommitmentRevision? @relation("ProcessingApprovedRevision", fields: [approvedCommitmentRevisionId], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([orderId])
  @@index([bomId])
  @@index([status])
  @@index([processType])
}

model OutsourcingLine {
  id                 String @id // 格式：OSL_${shortId}
  outsourcingOrderId String
  orderLineId String?
  requestedDeliveryDate String?
  supplierCommittedDeliveryDate String?
  specification String?
  retiredAt BigInt?

  // ─── 物料/工序 ───
  processType  String // Sewing | Cutting | Washing | Printing | Other
  description  String
  materialCode String? // 物料编码（跨模块 snapshot FK）

  // ─── 数量 ───
  quantity Decimal @db.Decimal(18, 4)
  unit     String

  // ─── 价格 ───
  unitPrice Decimal @db.Decimal(18, 4)
  amount    Decimal @db.Decimal(18, 4) // = quantity × unitPrice

  // ─── 备注 ───
  notes     String?
  createdAt BigInt
  updatedAt BigInt

  outsourcingOrder OutsourcingOrder @relation(fields: [outsourcingOrderId], references: [id], onDelete: Cascade)
  supplierFulfillmentFacts SupplierFulfillmentFact[]

  @@index([outsourcingOrderId])
}

// ════════════════════════════════════════════════════════════════════
// REQ2-05 面料工序级委外链 (Order Process Chain, DR-047)
// ════════════════════════════════════════════════════════════════════
// 设计决策（DR-047，设计文档 §2）：
//   ① 工序链 = 计划与成本核算层（订单视角）；OutsourcingOrder = 执行单据层
//     （供应商视角）—— outsourcingOrderId 可选关联，状态机不耦合（MES 零侵入扩展）
//   ② 加工费为成本口径（供 BOM/利润表消费），不生成应付——应付走既有采购域
//   ③ 按产出量计费（染厂出缸量行业惯例）：amount = outputQty × unitPrice；
//     未完工按投入量预估（estimate 口径）
// 设计真源：docs/design/04-模块设计/03-订单与生产/ProductionBoard-生产看板/面料工序级委外链.md
// ════════════════════════════════════════════════════════════════════

/// 面料订单工序链节点：坯布→染整→后整理（→涂层）各环节投入产出/损耗/加工费
model OrderProcessNode {
  id      String @id // 格式：OPN__${shortId}
  orderId String // 挂订单（面料域）

  seq          Int // 工序序号（展示排序；同订单唯一；不强制顺序推进——面料有平行工序）
  processType  String // gray_fabric(坯布织造) | dyeing(染整) | finishing(后整理) | coating(涂层) | other
  supplierId   String? // 承接工厂（跨模块 snapshot FK → Relation）
  supplierName String? // 冗余快照

  // ─── 数量（按产出计费 DR-047-③） ───
  inputQty  Decimal  @db.Decimal(18, 4) // 投入量
  outputQty Decimal? @db.Decimal(18, 4) // 产出量（完工登记后落值）
  unit      String   @default("M") // M | YD | KG

  // ─── 加工费（成本口径 DR-047-②：不生成应付） ───
  unitPrice Decimal @db.Decimal(18, 4) // 加工费单价（按产出量）
  currency  String  @default("CNY")
  amount    Decimal @default(0) @db.Decimal(18, 4) // 完工 = outputQty×unitPrice；未完工 = inputQty×unitPrice（预估）

  // ─── 状态：planned → in_progress → done（完工登记产出量→损耗+金额重算） ───
  status      String  @default("planned")
  completedAt BigInt?
  notes       String?

  // ─── 可选关联外协单（DR-047-① 执行载体，不耦合状态机） ───
  outsourcingOrderId String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  // seq 唯一性由服务层校验（deletedAt: null 过滤）——DB 层 @@unique 会让软删行
  // 占用唯一键阻止 seq 复用（验收实测 P2002：删 903 后重建 903 被拒）
  @@index([orderId])
}

// ══════════════════════════════════════════════════════════════════════════════
// Phase 5 B5 + Phase 3 C6: 外贸与报关（CustomsDeclaration / HsCode /
// LetterOfCredit / TaxRefund / TradeDocument / CustomsDeclarationLine）
// 服装外贸出口合规闭环：发货 → 报关 → 退税 → 外汇结算 → 信用证
// ══════════════════════════════════════════════════════════════════════════════

model CustomsDeclaration {
  id                String @id // 格式：CD_${shortId}
  declarationNumber String @unique // 报关单号（海关统一编号）

  // ─── 关联（snapshot FK，无 Prisma relation） ───
  shipmentId String? // 关联 Shipment
  orderId    String? // 关联 Order
  relationId String? // 关联 Relation（客户/供应商）

  // ─── 报关类型 ───
  type   String // Export(出口) | Import(进口)
  status String @default("Draft") // Draft | Submitted | Declared | Inspecting | Released | Exception | Cancelled

  // ─── 申报信息 ───
  declarationDate String? // 申报日期 YYYY-MM-DD
  customsCode     String? // 海关编码（申报地海关代码）
  declarationPort String? // 申报口岸
  tradeTerms      String? // 贸易条款 FOB | CIF | EXW | DDP | FCA | CPT | CIP | DAP | DPU

  // ─── 金额 ───
  totalValue Decimal? @db.Decimal(18, 4) // 申报总额
  currency   String? // 币种

  // ─── 运保费（对应真实报关单的「运费 / 保费 / 杂费」栏，2026-09-17 加）───
  // 为什么要单独登记而不复用运单上的 freightAmount：
  //   退税是**报给税务局**的数，税务认的是**报关单上填的**运费保费；
  //   运单上记的是实际付给货代的钱，两者常不一致（报关时可能按预估填）。
  //   所以报关单自己有一份，算退税时以它为准。
  // 币种一律沿用本单 currency（与运单侧「币种不一致则不参与」的既有口径自然兼容）。
  freightAmount   Decimal? @db.Decimal(18, 4) // 运费（成交方式含运费时必填，否则算不出 FOB）
  insuranceAmount Decimal? @db.Decimal(18, 4) // 保费（CIF/CIP 必填）

  // ─── 包装/重量 ───
  totalPackages Int? // 总件数
  grossWeight   Decimal? @db.Decimal(18, 4) // 毛重(kg)
  netWeight     Decimal? @db.Decimal(18, 4) // 净重(kg)

  // ─── 贸易方 ───
  originCountry      String? // 原产国
  destinationCountry String? // 目的国
  consignee          String? // 收货人
  consignor          String? // 发货人
  declarant          String? // 报关员
  agent              String? // 报关行

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  lines CustomsDeclarationLine[]

  @@index([shipmentId])
  @@index([orderId])
  @@index([relationId])
  @@index([status])
  @@index([type])
}

model CustomsDeclarationLine {
  id            String @id // 格式：CDL_${shortId}
  declarationId String

  lineNumber Int

  // ─── 商品信息 ───
  productCode   String?
  productName   String
  hsCode        String? // HS 编码（关联 HsCode.code）
  brandName     String? // 品牌
  specification String? // 规格型号

  // ─── 数量/价格 ───
  quantity    Decimal  @db.Decimal(18, 4)
  unit        String
  unitPrice   Decimal? @db.Decimal(18, 4)
  totalAmount Decimal? @db.Decimal(18, 4)
  currency    String?

  // ─── 重量 ───
  grossWeight Decimal? @db.Decimal(18, 4)
  netWeight   Decimal? @db.Decimal(18, 4)

  // ─── 产地 ───
  originCountry String?

  notes     String?
  createdAt BigInt
  updatedAt BigInt

  declaration CustomsDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  @@index([declarationId])
  @@index([hsCode])
}

model HsCode {
  id   String @id // 格式：HS_${shortId}
  code String @unique // HS 编码（如 5208.52.00.00）

  description String // 商品描述
  category    String // Textile(纺织品) | Garment(服装) | Accessory(辅料) | Material(原料) | Yarn(纱线) | Other

  // ─── 税率 ───
  exportTaxRebateRate Decimal? @db.Decimal(6, 4) // 出口退税率(%)
  importTariffRate    Decimal? @db.Decimal(6, 4) // 进口关税率(%)
  vatRate             Decimal? @db.Decimal(6, 4) // 增值税率(%)

  // ─── 海关监管 ───
  unit                 String? // 法定计量单位
  supervisionCondition String? // 监管条件代码
  inspectionQuarantine String? // 检验检疫类别
  additionalDuty       String? // 附加关税说明

  notes    String?
  isActive Boolean @default(true)

  createdAt BigInt
  updatedAt BigInt

  @@index([code])
  @@index([category])
  @@index([isActive])
}

model LetterOfCredit {
  id       String @id // 格式：LC_${shortId}
  lcNumber String @unique // 信用证号

  // ─── 关联（snapshot FK） ───
  relationId String? // 关联客户
  orderId    String? // 关联订单

  // ─── 类型/状态 ───
  type   String // Irrevocable(不可撤销) | Revocable(可撤销) | Standby(备用) | Transferable(可转让)
  status String @default("Issued") // Issued | Presented | Accepted | Discrepant | Settled | Expired | Cancelled

  // ─── 银行 ───
  issueDate       String? // 开证日期
  issueBank       String? // 开证行
  advisingBank    String? // 通知行
  negotiatingBank String? // 议付行
  confirmingBank  String? // 保兑行

  // ─── 贸易方 ───
  applicant   String? // 申请人（进口方）
  beneficiary String? // 受益人（出口方）

  // ─── 金额 ───
  amount          Decimal  @db.Decimal(18, 4) // 信用证金额
  currency        String   @default("USD")
  availableAmount Decimal? @db.Decimal(18, 4) // 可用余额

  // ─── 期限 ───
  expiryDate           String? // 有效期
  expiryPlace          String? // 到期地
  presentationDeadline String? // 交单期限
  shipmentDeadline     String? // 最迟装运期

  // ─── 贸易条款 ───
  tradeTerms      String? // FOB | CIF | ...
  portOfLoading   String? // 装运港
  portOfDischarge String? // 卸货港

  // ─── 单据/条款 ───
  documentsRequired Json? // 要求单据列表（JSON array）
  specialConditions String? // 特殊条款
  discrepancies     String? // 不符点记录

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([relationId])
  @@index([orderId])
  @@index([status])
  @@index([lcNumber])
}

// LcEvent：信用证节点事件（F1 lifecycle 深化）
// 每次状态机转换在事务内追加一条节点事件，形成可回溯的
// 开证→交单→承兑/不符点→结清/过期/作废 业务时间轴（独立于通用 auditLog，
// 面向业务查询与前端时间轴渲染；append-only，无软删）。
model LcEvent {
  id   String @id // 格式：LCE__${shortId}
  lcId String // 关联信用证

  // ─── 节点信息 ───
  fromNode String? // 上一节点（首节点为 null）
  toNode   String // 到达节点（取值与信用证状态一致：Issued | Presented | Accepted | Discrepant | Settled | Expired | Cancelled）

  eventDate String // 节点业务日期 YYYY-MM-DD（默认当日，可按银行实际日期回填）
  note      String? // 节点备注（不符点内容 / 银行参考号等）
  actorId   String? // 操作人

  createdAt BigInt

  @@index([lcId])
  @@index([toNode])
}

model TaxRefund {
  id           String @id // 格式：TR_${shortId}
  refundNumber String @unique // 退税申报编号

  // ─── 关联（snapshot FK） ───
  declarationId String? // 关联报关单
  orderId       String? // 关联订单
  relationId    String? // 关联客户

  status String @default("Draft") // Draft | Submitted | Reviewing | Approved | Rejected | Refunded | Cancelled

  // ─── 出口信息 ───
  exportDate      String? // 出口日期
  declarationDate String? // 申报日期

  // ─── 金额计算 ───
  fxRate                  Decimal? @db.Decimal(18, 8) // 外汇汇率
  exportAmountFob         Decimal? @db.Decimal(18, 4) // 出口FOB金额（原币）
  exportAmountFobCurrency String? // 出口金额币种
  exportAmountCny         Decimal? @db.Decimal(18, 4) // 折人民币金额
  refundableVat           Decimal? @db.Decimal(18, 4) // 可退增值税额
  refundableRate          Decimal? @db.Decimal(6, 4) // 退税率(%)
  refundAmount            Decimal? @db.Decimal(18, 4) // 实际退税额
  refundDate              String? // 退税到账日期

  // ─── 审核 ───
  reviewedBy  String? // 审核人
  reviewedAt  BigInt? // 审核时间
  reviewNotes String? // 审核意见

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([declarationId])
  @@index([orderId])
  @@index([relationId])
  @@index([status])
}

model TradeDocument {
  developmentBillingClaims DevelopmentCiBillingClaim[]
  id             String @id // 格式：TD_${shortId}
  documentNumber String @unique // 单据编号

  /// 业务域（2026-08-22 全系统单据枢纽裁决：单据中心从贸易单据台账升级为全系统
  /// 文件枢纽——各业务域单据就地生成后统一登记归档于此，domain 决定编号前缀与状态机）。
  /// customs=外贸单据（交单状态机）| procurement=采购 | qc=质检 | contract=合同 | finance=财务 | quotation=报价
  domain String @default("customs")

  type   String // CommercialInvoice | PackingList | CertificateOfOrigin | BillOfLading | AirWaybill | InsuranceCert | InspectionCert | PhytosanitaryCert | Other | PurchaseOrder | InspectionReport | Contract ...
  status String @default("Draft") // Draft | Issued | Submitted | Accepted | Rejected | Cancelled（customs 交单状态机；其他 domain 状态映射见 DOC_DOMAIN_STATUS_TRANSITIONS）

  // ─── 关联（snapshot FK） ───
  shipmentId      String? // 关联货运单
  declarationId   String? // 关联报关单
  orderId         String? // 关联订单
  relationId      String? // 关联客户
  /// 财务发票回链（2026-08-21 架构裁决：财务 Invoice 为商业发票唯一真源，
  /// 单据中心 CommercialInvoice 引用不复制——交单号=财务发票号，改金额只改财务侧）
  sourceInvoiceId String?

  /// 业务真源外链（2026-08-22 B2 运营域单据：各业务域单据实时引用各自真源渲染，
  /// 不复制内容——procurement=PurchaseOrder.id，qc=InspectionReport.id，与 sourceInvoiceId 同语义）
  sourceRef String?

  // ─── 单据信息 ───
  issueDate       String? // 签发日期
  expiryDate      String? // 有效期
  issuedBy        String? // 签发方
  consignee       String? // 收货人
  consignor       String? // 发货人
  portOfLoading   String?
  portOfDischarge String?

  // ─── 金额 ───
  totalAmount Decimal? @db.Decimal(18, 4) // 单据金额
  currency    String?

  // ─── 附件 ───
  filePath String? // 文件路径
  fileName String? // 文件名

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([shipmentId])
  @@index([declarationId])
  @@index([orderId])
  @@index([relationId])
  @@index([type])
  @@index([status])
  @@index([sourceInvoiceId])
  @@index([sourceRef])
  @@index([domain])
}

// ════════════════════════════════════════════════════════════════════
// A5 报表引擎 — ReportDefinition / ReportRun
// ════════════════════════════════════════════════════════════════════
// 设计决策：
//   - 数据集白名单在服务端注册表（reporting/datasets.ts），definition 只存
//     datasetKey + 维度/指标/过滤的字段名，执行时由引擎校验白名单（fail closed），
//     杜绝客户端注入任意 Prisma 查询。
//   - dimensions: string[]（字段名）；metrics: [{field, agg}]（agg ∈ sum|avg|min|max|count）；
//     filters: [{field, op, value}]（op ∈ eq|ne|in|gte|lte|contains）。
//   - 定时调度：schedule ∈ daily|weekly|monthly|null，幂等键 = definitionId:periodKey
//     Format: daily YYYY-MM-DD / weekly YYYY-Www / monthly YYYY-MM. Duplicates fail closed.
//     靠 ReportRun.idempotencyKey unique 约束 fail closed。
//   - 结果快照直接存 ReportRun.rows（上限 5000 行），导出 CSV 重放快照而非重查，
//     保证导出内容与运行时刻一致（可审计）。
//   - 软删（deletedAt）；定义删除后历史运行记录保留。
// ════════════════════════════════════════════════════════════════════
model ReportDefinition {
  id          String  @id // 格式：RPD__${shortId}
  name        String
  description String?

  // ─── 查询定义（白名单字段名，执行时由引擎校验） ───
  datasetKey String // orders|invoices|paymentVouchers|shipments|vatInvoices|outwardRemittances|taxRefunds
  dimensions Json // string[]
  metrics    Json // Array<{ field: string; agg: 'sum'|'avg'|'min'|'max'|'count' }>
  filters    Json? // Array<{ field: string; op: 'eq'|'ne'|'in'|'gte'|'lte'|'contains'; value: unknown }>

  // ─── 定时调度 ───
  schedule  String? // daily | weekly | monthly | null（null=仅手动）
  enabled   Boolean @default(true)
  lastRunAt BigInt?

  createdBy String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([datasetKey])
  @@index([enabled])
}

model ReportRun {
  id             String @id // 格式：RPR__${shortId}
  definitionId   String // 关联定义（snapshot FK，定义可软删）
  definitionName String // 冗余快照：定义改名后历史运行仍可读

  status  String // Running | Success | Failed
  trigger String // manual | schedule

  // ─── 调度幂等键（definitionId:periodKey），手动运行为 null ───
  idempotencyKey String? @unique

  // ─── 结果快照 ───
  rowCount     Int?
  columns      Json? // string[]（列键）
  columnLabels Json? // string[]（展示表头，与 columns 同序，导出 CSV 直接用）
  rows         Json? // Array<Record<string, unknown>>（上限 5000 行快照）
  error        String?

  startedAt  BigInt
  finishedAt BigInt?
  createdAt  BigInt

  @@index([definitionId])
  @@index([status])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════════
// 业务编号序列 — PRD 5.6 按年递增规则
// ════════════════════════════════════════════════════════════════════
model BusinessSequence {
  id     String @id // 格式：SEQ_${prefix}_${year}
  prefix String // 编号前缀：QT | ORD | PO | INV | SH | CD | PV | IR | SM | BOM
  year   Int // 年份：2026
  seq    Int // 当前序号（已分配的最大序号）

  updatedAt BigInt

  @@unique([prefix, year])
}

// ════════════════════════════════════════════════════════════════════
// Phase 0-03 统一编号发号器 SequenceRegister（11 类业务单据独立序列）
//   vs BusinessSequence：支持按年/月/永不重置，format 模板可配置，显式作废追踪
//   真源：每次 nextNumber 调用在事务内 upsert + atomic increment
// ════════════════════════════════════════════════════════════════════
model SequenceRegister {
  id             String  @id // 格式：SEQREG_${seqType}_${periodKey}
  seqType        String // 11 类枚举：order | pi | quotation | purchase | invoice | voucher | shipment | customs | customer | supplier | material
  period         String // 重置周期：year | month | day | none
  periodKey      String // 周期键值：2026 | 2026-08 | 2026-08-15 | __global__
  prefix         String // 编号前缀：如 SO、PI、QT、PO、INV、PAY、SHP、CD、CUS、SUP、MAT
  formatTemplate String // 格式模板，支持 {prefix} {year} {month} {day} {seq:Npad}
  padding        Int     @default(4) // 默认 seq 数字补零位数（按模板 override）
  startSeq       Int     @default(1) // 重置时起始值（通常 1）
  currentSeq     Int     @default(0) // 已分配的最大序号（next=currentSeq+1）
  description    String?

  updatedAt BigInt

  @@unique([seqType, periodKey])
  @@index([seqType])
  @@index([periodKey])
}

// ════════════════════════════════════════════════════════════════════
// Phase 0-03 VoidedNumber — 作废单号占坑表（显式追踪，不复用）
//   语义：只要进入本表，该编号永久不会被 sequenceService 再次分配（即使是正常单调递增也不会重复
//         — 因为序号只增不减；本表的作用主要是审计追踪 + 防止极端情况下 rollback 后手工回填触发重复）
// ════════════════════════════════════════════════════════════════════
model VoidedNumber {
  id            String   @id // VOID_${seqType}_${number}
  seqType       String // 同 SequenceRegister.seqType
  number        String // 完整编号（例：INV-2026-0003）
  periodKey     String? // 同 SequenceRegister.periodKey（便于按周期过滤）
  reason        String? // 作废原因（用户填写或系统自动，如草稿撤销、打印作废、重号）
  voidedBy      String? // 操作人 userId / 系统 'system'
  voidedAt      DateTime @default(now())
  sourceDocId   String? // 关联单据 ID（如有）
  sourceDocType String? // 关联单据类型（如有，如 Order、Invoice、PurchaseOrder）
  metadata      Json? // 扩展上下文（操作人 IP、客户端、请求 ID 等）

  @@unique([seqType, number])
  @@index([seqType])
  @@index([voidedAt])
  @@index([sourceDocType, sourceDocId])
}

// ════════════════════════════════════════════════════════════════════
// Phase 0-05 DirtyCacheMarker — 缓存脏标记表（最终一致性计算管线的"待重算"真源）
//
// 语义：
//   当 Order / Invoice / Payment 等实体变更时，对应的衍生指标（Dashboard 汇总、
//   ReportCenter 报表、客户账龄、库存毛利预估 等）不立即重算（避免写请求
//   响应变慢），而是先在本表写一行"脏标记"。后台调度器（scheduler tasks/
//   refresh-cache）周期性扫描 dirty=true 的行，按 cacheKey 调对应重算函数，
//   成功后将 dirty=false + resolvedAt=now。若实体再次变更则覆盖重置为脏。
//
// cacheKey 规则：`{scope}:{entityType}[:{entityId}]`
//   scope: 'dashboard' | 'report' | 'accounting' | 'crm' | 'forecast' | 'custom'
//   例：dashboard:Order  → 全量订单看板
//       report:AR_by_customer  → 客户账龄报表
//       accounting:PaymentAllocation:PV_123  → 单笔分配对应总账条目
// ════════════════════════════════════════════════════════════════════
model DirtyCacheMarker {
  id         String  @id // DCM_${cacheKey}（一对一：每个 cacheKey 只有一行状态）
  cacheKey   String  @unique
  /// 分类域：dashboard / report / accounting / crm / forecast / custom
  scope      String
  /// 触发变脏的实体：Order / Invoice / PaymentAllocation / Shipment / *（全部）
  entityType String?
  /// 精确到单条实体时填；跨实体聚合（如 dashboard）留空
  entityId   String?

  /// 是否脏：true=需要重算；false=已完成或未脏
  dirty   Boolean @default(true)
  /// 变脏原因（可选，面向人读）：'order_confirmed' / 'payment_allocated' / 'manual_refresh'
  reason  String?
  /// 触发人（或 'system'/'scheduler'）
  actorId String?

  dirtyAt    DateTime  @default(now())
  /// 最近一次被标记脏的次数（用于调度器优先处理高频脏项）
  dirtyCount Int       @default(1)
  /// 最近一次重算完成时间
  resolvedAt DateTime?
  /// 上次重算耗时 ms（监控用）
  resolvedMs Int?
  /// 上次重算失败次数（连续失败告警阈值 >3）
  failCount  Int       @default(0)
  lastError  String?

  updatedAt BigInt

  @@index([scope])
  @@index([entityType, entityId])
  @@index([dirty])
  @@index([dirtyAt])
}

// ════════════════════════════════════════════════════════════════════
// Phase 0-07 DataDictionary — 统一数据字典真源（枚举 / 标签 / 下拉选项）
//
// 设计意图：
//   现有 MaterialType / CostType / OrderStatus / Incoterms / Currency / PaymentTerms
//   等 21 类常用枚举都散落在 TS union type（代码里）。管理员要新增一个 MaterialType
//   （如 "印花衬里 PrintedInterlining"）就要改代码+重新发布，非常不灵活。
//   建立 DataDictionary 后：
//     · DB 是真源（可通过 OPS Panel 修改）；TS 类型继续保留作为"静态校验+IDE 提示"基线
//     · entries JSON 存所有枚举项：[{ key, label, value, order, color, tags, disabled }]
//     · isSystem=true 的字典项（系统内置）不允许删除，但允许改 label/颜色
//
// 每条 DataDictionary 对应"一个枚举域"：
//   code= bom_material_type       → 8 项 MaterialType
//   code= incoterms               → FOB / CIF / EXW / FCA / CPT / CIP / DAP / DPU / DDP
//   code= currency                → CNY / USD / EUR / HKD / JPY / GBP
//   code= order_status            → Draft / Confirmed / InProduction / Shipped / Invoiced / Paid / Completed / Cancelled
//   …共 21 类（见 seed-datadict.ts）
// ════════════════════════════════════════════════════════════════════
model DataDictionary {
  id       String  @id
  /// 枚举域编码，全局唯一（前端通过此编码 getEntries(code)）
  code     String  @unique
  /// 中文名（面向 OPS Panel 展示）
  name     String
  /// 分类：'bom' / 'order' / 'finance' / 'crm' / 'product' / 'hr' / 'logistics' / 'system' / 'custom'
  category String
  /// 生效范围：'global' / 部门ID（为未来多租户/部门自定义字典预留），默认 global
  scope    String  @default("global")
  /// 系统内置字典：系统内置的 TS 类型枚举有代码引用，OPS Panel 不得删除（可编辑 label/颜色）
  isSystem Boolean @default(false)
  /// 版本号：每次 entries 修改 version+1（前端做缓存失效）
  version  Int     @default(1)
  /// 字典条目 JSON，结构：
  ///   Array<{
  ///     key: string;          // 前端下拉 value（如 'FOB' / 'Main'）
  ///     label: string;        // 展示中文：'离岸价（FOB）'
  ///     value?: any;          // 可选：key !== value 时填入（如 currency 对应数字代码）
  ///     order: number;        // 排序，asc（0 排最前）
  ///     color?: string;       // 如 status 对应颜色 token
  ///     tags?: string[];      // 前端分组用
  ///     disabled?: boolean;   // 已禁用（不再出现在新建选项，但老数据引用仍有效）
  ///     description?: string; // 长描述，如 tooltip
  ///   }>
  entries  Json

  /// 可选：labels JSON —— 其他翻译/别名，结构：{ "zh-CN": {...}, "en-US": {...} }
  labels Json?

  /// 备注（运维/产品变更说明）
  description String?

  createdAt DateTime @default(now())
  updatedAt BigInt

  @@index([category])
  @@index([scope])
  @@index([isSystem])
}

model DataDictionaryHistory {
  id          String   @id
  dictCode    String // 关联 DataDictionary.code
  versionFrom Int
  versionTo   Int
  diffEntries Json // 变更前后 entries 快照（diff 结果）
  actorId     String?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([dictCode, createdAt])
}

// ════════════════════════════════════════════════════════════════════
// Phase 0-08 SystemConfig — 统一系统配置 DB 真源（替代散落 .env 硬编码）
//
// 设计意图：
//   现有配置分散在 process.env（BAMBOOK_COMPANY_NAME_EN / DEFAULT_*_RATE …）、
//   以及代码里硬编码默认值（退税率 13%、佣金 3%、USD/CNY 汇率…），管理员想改得
//   改代码+重启。SystemConfig 把常用 37+ 项配置抽到 DB：
//     · key 唯一（scope::key 做主键；scope 默认 global；为未来按部门/用户自定义预留）
//     · valueType=string/number/boolean/json/enum，服务端做类型断言
//     · encrypted=true 时 value 存 AES-GCM 密文（hex iv.ciphertext.authTag），
//       用于 API_KEY / AWS_SES_PASSWORD / DB_URL / LLM_API_KEY 等敏感值
//     · version 自增 + SystemConfigHistory 每次变更留痕
//     · 前端/路由每次 get 走 30 秒 TTL cache；set 后自动失效
//
// 7 类分组（group field）：
//   company    公司信息：名称/中/英/地址/Logo URL/电话/邮箱/税务登记号/营业执照号
//   finance    财务相关：默认币种/默认汇率/利润默认比例/佣金率/账期阈值
//   tax        税务相关：默认 VAT 率/默认退税率/开票限额提示/开票抬头默认值
//   logistics  物流相关：默认 Incoterm/默认起运港/默认货代联系人
//   ui         界面主题：主题色/Logo/默认 Dashboard 布局/默认语言
//   rbac       权限与安全：密码最小长度/会话 TTL/登录失败锁定阈值
//   ops        运维：通知邮件 SMTP/OPS_TOKEN 过期阈值/备份策略/LLM 网关参数
// ════════════════════════════════════════════════════════════════════
model SystemConfig {
  id        String  @id /// 主键格式：`${scope}::${key}`（global::company.name / dept_xxx::commission.rate）
  scope     String  @default("global")
  /// 配置 key（同 scope 唯一）
  key       String
  /// 分组：company / finance / tax / logistics / ui / rbac / ops / custom
  group     String
  /// 展示标签（OPS Panel 展示用）
  label     String
  /// 值类型：get 时按此类型 parse JSON/number/boolean
  valueType String /// 'string' | 'number' | 'boolean' | 'json' | 'enum'
  /// 值：未加密则直接 JSON 存字符串/数字/布尔；加密则存 `"${iv.hex}.${cipher.hex}.${tag.hex}"`
  value     Json?
  /// 是否加密（AES-GCM）：sensitive 配置（API_KEY / DB_URL / SMTP_PASSWORD / LLM_KEY …）
  encrypted Boolean @default(false)
  /// 版本号：每次变更 +1
  version   Int     @default(1)

  /// 枚举/描述：可选的提示、示例、可选值列表（UI 用）
  description String?
  meta        Json? /// e.g. { options?: string[], min?: number, max?: number, placeholder?: string }

  /// 审计：谁最后改的 + 原因（用于 History）
  updatedBy   String?
  auditReason String?

  createdAt DateTime @default(now())
  updatedAt BigInt

  @@unique([scope, key])
  @@index([group])
  @@index([scope])
  @@index([encrypted])
}

model SystemConfigHistory {
  id              String   @id
  configId        String /// 关联 SystemConfig.id（"scope::key"）
  versionFrom     Int
  versionTo       Int
  valueFrom       Json?
  valueTo         Json?
  actorId         String?
  reason          String?
  sensitiveMasked Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([configId, createdAt])
  @@index([actorId])
}

// ─── Phase 1-06 营销活动管理 ───
model MarketingCampaign {
  id            String   @id @default(cuid())
  /// 活动编号（SequenceRegister: MKT-2026-001）
  code          String?  @unique
  name          String
  description   String?
  /// 活动类型：exhibition | digitalAd | email | socialMedia | printAd | referral | other
  type          String   @default("other")
  /// 状态：Draft | Active | Paused | Completed | Cancelled
  status        String   @default("Draft")
  startDate     String?
  endDate       String?
  /// 预算（Decimal）
  budget        Decimal?
  /// 实际花费
  actualCost    Decimal?
  /// 目标客户群（JSON: 可含 tier/category/region 等筛选条件）
  targetSegment Json?
  /// 关联季节
  seasonId      String?
  /// 关联展会
  tradeShowId   String?
  /// 归属人 / 部门（行级权限）
  ownerId       String?
  departmentId  String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  /// 关联线索
  leads MarketingLead[]

  @@index([status])
  @@index([type])
  @@index([seasonId])
  @@index([ownerId])
  @@index([departmentId])
}

model MarketingLead {
  id             String   @id @default(cuid())
  campaignId     String
  /// 关联客户（可为空，表示新线索未转化）
  relationId     String?
  /// 线索来源
  source         String?
  /// 联系人信息
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  /// 线索状态：New | Contacted | Qualified | Converted | Lost
  status         String   @default("New")
  /// 预期价值
  estimatedValue Decimal?
  /// 实际转化价值
  actualValue    Decimal?
  /// 转化时间
  convertedAt    BigInt?
  /// 备注
  notes          String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([relationId])
  @@index([status])
}

// ============================================================================
// Migration 1 — MOQ 阈值配置（P0-1 / P0-2）
// ============================================================================

/// MOQ 阈值配置（Admin 可调，非写死常量；取数优先级第 5 级）
/// 设计真源：MOQ最小起订量.md §2.1 / §2.3
/// 兜底代码常量（面料800/成衣200/Capsule20）仅为第 6 级 last resort
model MoqThresholdConfig {
  id                String    @id // 格式：MOQCFG__${shortId}
  fabricDefaultMoq  Int // 面料档 MOQ（seed 默认 800，单位米）
  garmentDefaultMoq Int // 成衣档 MOQ（seed 默认 200，单位件）
  capsuleMoq        Int // Capsule 档 MOQ（seed 默认 20，单位件；勾选 capsuleExemption 后降级使用）
  isActive          Boolean   @default(true) // 当前生效配置（DB 层仅允许 1 条 isActive=true，见部分唯一索引 moq_threshold_config_only_one_active）
  effectiveFrom     DateTime  @default(now()) // 生效时间（支持定时生效）
  effectiveTo       DateTime? // 失效时间（被新配置替代时写入）

  // 审计（≥5字 fail-closed）
  changedBy    String // 变更人 userId
  changeReason String // 变更理由

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([effectiveFrom])
}

/// MOQ 变更历史（append-only，无软删，不可篡改）
model MoqThresholdConfigHistory {
  id       String @id // 格式：MOQHIST__${shortId}
  configId String // 关联 MoqThresholdConfig.id

  // 变更前快照
  beforeFabricDefaultMoq  Int
  beforeGarmentDefaultMoq Int
  beforeCapsuleMoq        Int

  // 变更后快照
  afterFabricDefaultMoq  Int
  afterGarmentDefaultMoq Int
  afterCapsuleMoq        Int

  // 审计
  changedBy    String // 变更人 userId
  changeReason String // 变更理由
  changedAt    DateTime @default(now())

  @@index([configId])
  @@index([changedAt])
}

// ============================================================================
// Migration 3 — 订单变更申请（P0-17，DR-010 已批准订单变更控制）
// ============================================================================

/// 设计真源：订单变更规则.md §2-§7 / 订单状态机.md §14 OSM-010-C1
/// 触发路径：Order.status=Confirmed/Production 时业务员直改 → 后端 ORDER_ALREADY_CONFIRMED 拒绝 → 引导提交本单 → DR-007 路由部门主管审批 → 通过后写 OrderStatusTransition
model OrderChangeRequest {
  id            String @id // 格式：OCR__${shortId}
  orderId       String // 关联 Order.id（必须 status=Confirmed/Production 以上）
  requestNumber String @unique // 业务号：OCR-YYYYMMDD-001

  // ─── 变更前快照（writeOnce） ───
  /// JSONB：{ quantity, unitPrice, deliveryDate, customer, shipToAddress, ... 所有允许变更字段的旧值 }
  beforeSnapshot Json
  /// JSONB：{ quantity, unitPrice, deliveryDate, ... 所有允许变更字段的新值 }
  afterDelta     Json

  // ─── 变更类型 & 影响评估 ───
  /// 枚举：quantity | unitPrice | deliveryDate | customer | ship_to | product_spec | payment_terms | other
  changeTypes  String[]
  /// low / medium / high（服务端自动评估：涉及价格/交期/数量≥10%=high）
  impactLevel  String   @default("medium")
  /// 变更理由（≥15字必填 fail-closed）
  changeReason String   @db.Text

  // ─── 申请人 & 审批（DR-007 组织归属解析）───
  requesterId       String // 申请人 userId（业务员）
  reviewerId        String // NOT NULL，DR-007 resolveReviewerByDepartment 解析
  approvalRequestId String? // 关联 ApprovalRequest.id（通用审批复用）
  /// 当前内部批准版本的不可变最终内容摘要；由服务端根据批准快照生成，不信任浏览器写值。
  finalContentFingerprint String? @db.VarChar(64)
  /// 被本次申请修订的历史申请；驳回记录保留，修订始终新建下一条。
  revisionOfId String?
  revisionOf OrderChangeRequest? @relation("OrderChangeRequestRevision", fields: [revisionOfId], references: [id], onDelete: Restrict)
  revisions OrderChangeRequest[] @relation("OrderChangeRequestRevision")

  // ─── 状态机 ───
  /// Draft → Pending → Approved → Applied / Rejected(退回Draft) / Cancelled
  status String @default("Draft")

  // ─── 执行结果 ───
  appliedAt DateTime? // Approved 后实际回写 Order 的时间
  appliedBy String? // 回写操作者（system_change_apply 或申请人Apply按钮）

  notes       String?
  attachments Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orderId])
  @@index([status])
  @@index([requesterId])
  @@index([reviewerId])
  @@index([requestNumber])
  @@index([impactLevel])
  @@index([revisionOfId])
  @@index([finalContentFingerprint])
}

// Append-only customer confirmation and evidence source snapshots. Every new
// source must be linked to its first confirmation in the same transaction;
// evidence is never created as an unattached pool item.
model BusinessConfirmation {
  id String @id
  targetType String
  targetId String
  finalContentFingerprint String @db.VarChar(64)
  internalApprovalId String?
  scopeFingerprint String @db.VarChar(64)
  scope Json
  decisionScope Json?
  outcome String // accepted | rejected | partial
  customerName String?
  customerAddress String?
  confirmedAt BigInt
  channel String // email | screenshot | phone | meeting | other
  recordedBy String
  recordedAt BigInt
  requestKey String
  requestFingerprint String @db.VarChar(64)
  revision Int @default(1)
  supersedesId String? @unique
  correctionReason String? @db.Text
  auditId String @unique

  recorder UserAccount @relation("BusinessConfirmationRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  supersedes BusinessConfirmation? @relation("BusinessConfirmationCorrection", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy BusinessConfirmation? @relation("BusinessConfirmationCorrection")
  evidence BusinessConfirmationEvidence[]
  originEvidence CustomerEvidence[] @relation("CustomerEvidenceOrigin")
  fabricUseAuthorizationVersion FabricUseAuthorizationVersion? @relation("FabricUseAuthorizationVersionConfirmation")

  @@unique([recordedBy, requestKey], map: "BusinessConfirmation_recordedBy_requestKey_key")
  @@unique([targetType, targetId, finalContentFingerprint, scopeFingerprint, revision], map: "BusinessConfirmation_target_version_scope_revision_key")
  @@index([targetType, targetId, finalContentFingerprint, scopeFingerprint], map: "BusinessConfirmation_target_scope_idx")
  @@index([internalApprovalId])
  @@index([recordedBy, recordedAt])
}

/// Immutable source snapshot. Email records capture the full body and metadata;
/// per-confirmation selection offsets and attachment versions live on the join.
model CustomerEvidence {
  id String @id
  sourceType String // email_selection | screenshot
  sourceFingerprint String @unique @db.VarChar(64)
  sourceSnapshot Json
  originTargetType String
  originTargetId String
  originConfirmationId String
  createdBy String
  createdAt BigInt

  creator UserAccount @relation("CustomerEvidenceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  originConfirmation BusinessConfirmation @relation("CustomerEvidenceOrigin", fields: [originConfirmationId], references: [id], onDelete: Restrict)
  confirmations BusinessConfirmationEvidence[]
  files CustomerEvidenceFileLink[]

  @@index([originTargetType, originTargetId])
  @@index([createdBy, createdAt])
}

/// Content-addressed private original. Identical bytes are stored once and can
/// be referenced by multiple source snapshots without duplicating the original.
model CustomerEvidenceFile {
  id String @id
  sha256 String @unique @db.VarChar(64)
  storageKey String @unique
  byteSize Int
  createdBy String
  createdAt BigInt

  creator UserAccount @relation("CustomerEvidenceFileCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  sourceLinks CustomerEvidenceFileLink[]

  @@index([createdBy, createdAt])
}

model CustomerEvidenceFileLink {
  id String @id
  evidenceId String
  fileId String
  purpose String // screenshot | email_attachment
  sourceAttachmentId String?
  fileName String
  mimeType String
  metadataSnapshot Json

  evidence CustomerEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  file CustomerEvidenceFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([evidenceId])
  @@index([fileId])
}

model BusinessConfirmationEvidence {
  id String @id
  confirmationId String
  evidenceId String
  selectionSnapshot Json

  confirmation BusinessConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Restrict)
  evidence CustomerEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([confirmationId, evidenceId])
  @@index([evidenceId])
}

// A pending customer-confirmation target. The target's content and scope are
// immutable; the shared CustomerConfirmation adapter appends the resulting
// grant/revoke version only after exact customer evidence is saved.
model FabricUseAuthorizationRequest {
  id String @id
  productAssetId String
  ownerRelationId String
  granteeRelationId String
  operation String // grant | replace | revoke
  expectedVersionId String?
  allowedActions Json
  effectiveFrom BigInt?
  effectiveUntil BigInt?
  finalContentFingerprint String @db.VarChar(64)
  scopeFingerprint String @db.VarChar(64)
  productSnapshot Json
  requestKey String
  requestFingerprint String @db.VarChar(64)
  recordedBy String
  recordedAt BigInt

  product ProductAsset @relation(fields: [productAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner Relation @relation("FabricUseAuthorizationRequestOwner", fields: [ownerRelationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantee Relation @relation("FabricUseAuthorizationRequestGrantee", fields: [granteeRelationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  expectedVersion FabricUseAuthorizationVersion? @relation("FabricUseAuthorizationExpectedVersion", fields: [expectedVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recorder UserAccount @relation("FabricUseAuthorizationRequestRecorder", fields: [recordedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resultingVersion FabricUseAuthorizationVersion? @relation("FabricUseAuthorizationRequestResult")

  @@unique([recordedBy, requestKey], map: "FabricUseAuthRequest_actor_request_uq")
  @@index([productAssetId, ownerRelationId, granteeRelationId, recordedAt], map: "FabricUseAuthRequest_product_owner_grantee_time_idx")
  @@index([expectedVersionId], map: "FabricUseAuthRequest_expected_version_idx")
}

// Append-only facts of customer-authorized use. A revocation is a new version;
// earlier versions remain linked to the proof and to historic business uses.
model FabricUseAuthorizationVersion {
  id String @id
  productAssetId String
  ownerRelationId String
  granteeRelationId String
  revision Int
  state String // active | revoked
  allowedActions Json
  effectiveFrom BigInt?
  effectiveUntil BigInt?
  requestId String @unique(map: "FabricUseAuthVersion_request_key")
  confirmationId String @unique(map: "FabricUseAuthVersion_confirmation_key")
  supersedesVersionId String? @unique(map: "FabricUseAuthVersion_supersedes_key")
  recordedBy String
  recordedAt BigInt
  auditId String @unique(map: "FabricUseAuthVersion_auditId_key")

  product ProductAsset @relation(fields: [productAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner Relation @relation("FabricUseAuthorizationVersionOwner", fields: [ownerRelationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantee Relation @relation("FabricUseAuthorizationVersionGrantee", fields: [granteeRelationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  request FabricUseAuthorizationRequest @relation("FabricUseAuthorizationRequestResult", fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  expectedByRequests FabricUseAuthorizationRequest[] @relation("FabricUseAuthorizationExpectedVersion")
  confirmation BusinessConfirmation @relation("FabricUseAuthorizationVersionConfirmation", fields: [confirmationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersedes FabricUseAuthorizationVersion? @relation("FabricUseAuthorizationVersionRevision", fields: [supersedesVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersededBy FabricUseAuthorizationVersion? @relation("FabricUseAuthorizationVersionRevision")
  recorder UserAccount @relation("FabricUseAuthorizationVersionRecorder", fields: [recordedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  audit AuditLog @relation("FabricUseAuthorizationVersionAudit", fields: [auditId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uses FabricUseAuthorizationUse[]

  @@unique([productAssetId, ownerRelationId, granteeRelationId, revision], map: "FabricUseAuthVersion_identity_revision_uq")
}

// Immutable provenance for each authorized business reference. The native
// target is polymorphic, while product/customer/action/version remain typed.
model FabricUseAuthorizationUse {
  id String @id
  useKey String @unique(map: "FabricUseAuthUse_use_key_key") @db.VarChar(64)
  basisKind String // owner | grant
  authorizationVersionId String?
  productAssetId String
  ownerRelationId String
  granteeRelationId String
  action String
  businessTargetType String
  businessTargetId String
  businessLineId String?
  businessVersionFingerprint String @db.VarChar(64)
  recordedBy String
  recordedAt BigInt
  auditId String @unique(map: "FabricUseAuthUse_auditId_key")

  authorizationVersion FabricUseAuthorizationVersion? @relation(fields: [authorizationVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product ProductAsset @relation(fields: [productAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner Relation @relation("FabricUseAuthorizationUseOwner", fields: [ownerRelationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantee Relation @relation("FabricUseAuthorizationUseGrantee", fields: [granteeRelationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recorder UserAccount @relation("FabricUseAuthorizationUseRecorder", fields: [recordedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  audit AuditLog @relation("FabricUseAuthorizationUseAudit", fields: [auditId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([businessTargetType, businessTargetId, businessLineId], map: "FabricUseAuthUse_target_idx")
  @@index([authorizationVersionId, recordedAt], map: "FabricUseAuthUse_version_time_idx")
  @@index([productAssetId, granteeRelationId, action, recordedAt], map: "FabricUseAuthUse_product_customer_action_idx")
}

// ============================================================================
// Migration 4 — 面料 S/S 船样（P0-18，DR-014/016 出运条件 3 并行之一）
// ============================================================================

/// 设计真源：QC模块概述.md §16 QC-014 / 订单与生产模型组.md §14 样品 × QC 强边界
/// 业务语义：面料链大货生产后出运前，截取大货样=S/S船样寄客户确认；样品与QC内部门禁弱关联（业务登记为主，客户不通过才转QC，DR-029）；与 Shipment 绑定 1:N。
model FabricShipmentSample {
  id         String @id // 格式：FSS__${shortId}
  sampleCode String @unique // 业务号：FSS-YYYYMMDD-001

  // ─── 业务归属（1张 Shipment 可有多个 S/S 样；同 Shipment 可多批次） ───
  shipmentId      String // 关联 Shipment.id（出运单；若 Shipment 还未建则先空后绑定）
  orderId         String // 关联 Order.id（业务归属订单；便于未建Shipment时溯源）
  fabricProfileId String? // 关联 FabricProfile.id（冗余快照）

  // ─── 样品基础信息 ───
  sampleQuantity Decimal  @db.Decimal(10, 2) // 取样长度（米）
  sampleUnit     String   @default("meter")
  batchNo        String? // 对应大货生产批次号
  rollNos        String[] @default([]) // 取样卷号（便于追溯）
  cuttingDate    String // 取样日期 YYYY-MM-DD

  // ─── 寄送信息 ───
  sentToCustomer   Boolean @default(false)
  sentDate         String? // 寄出日期 YYYY-MM-DD
  courier          String? // 快递商（DHL/FedEx/SF 等）
  trackingNumber   String? // 快递单号
  recipientName    String? // 收件人
  recipientContact String?
  shippingFee      Float? // 寄样邮寄费（DR-057 v2.1：费用留痕，币种随客户合同）

  // ─── 客户确认（3 并行条件 2/3：S/S 确认；Shipment.releaseReady 校验此条件之一） ───
  /// pending | approved | rejected | needs_revision
  customerStatus       String  @default("pending")
  customerFeedbackDate String?
  customerFeedbackNote String? @db.Text

  // ─── QC 责任（DR-029 面料链：QC 不做第一门禁，customerStatus=rejected 或业务员主动请求才转QC） ───
  qcInspectionReportId String? // 关联 InspectionReport.id（type=FabricSS 或 EarlyProduction；面料QC评审结果）
  qcRequestedBy        String? // 业务员 userId（主动请求 QC 介入）
  qcRequestedAt        DateTime?

  notes       String?
  attachments Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([shipmentId])
  @@index([orderId])
  @@index([customerStatus])
  @@index([sampleCode])
  @@index([qcInspectionReportId])
}

// ============================================================================
// REQ2-01 — SampleColorBatch 打色批次（色差管理体系）
// ============================================================================
/// 设计真源：Development-开发/色差管理体系.md §4（IND-01 L0 → L3）
/// 业务语义：缸号级色差证据链。两态挂载：lab_dip 挂开发案（打色阶段），
/// bulk 挂订单（大货缸差）。批色通过即封样基准；客户判定时疵点原因结构化
/// 自动追加供应商 FactoryEvaluation(inspection) 质量分（append-only 真源）。
model SampleColorBatch {
  id        String @id // 格式：SCB__${shortId}
  batchCode String @unique // 业务号：SCB-YYYYMMDD-001

  // ─── 两态挂载（lab_dip 必填 developmentCaseId；bulk 必填 orderId） ───
  stage             String // lab_dip(开发打色) | bulk(大货缸差)
  developmentCaseId String? // 打色阶段挂开发案
  roundNo           Int? // 开发案轮次快照（登记时 currentRound）
  orderId           String? // 大货阶段挂订单

  // ─── 色号关联（REQ2-09，DR-051-③：可选 FK + 快照，色卡变更/删除后历史不失真） ───
  colorCardId String? // 关联 ColorCard
  colorCode   String? // 冗余快照（如 "19-4052 TCX"）

  // ─── 缸号 / 批次 / 卷号（追溯三键） ───
  dyeLotNo String // 缸号（染厂染色缸次）
  batchNo  String? // 批次号
  rollNos  String[] @default([]) // 取样卷号

  // ─── 色差评级（4-5 级制） ───
  colorRating Int // 主评级 1-5（5=与标样一致…1=完全不符）
  sideDiff    Int? // 左右色差 1-5（null=未评）
  endDiff     Int? // 前后色差 1-5

  // ─── 疵点原因（结构化枚举，多选；供应商质量分趋势聚合维度） ───
  defectCauses String[] @default([]) // red_cast | blue_cast | lighter | darker

  // ─── 客户判定 / 封样衔接 ───
  customerStatus       String  @default("pending") // pending | approved | rejected | needs_recast
  approvedAsSealed     Boolean @default(false) // 批色通过即封样基准（同 scope 同色唯一）
  customerFeedbackNote String?
  customerFeedbackDate String? // YYYY-MM-DD

  // ─── 供应商（染厂，质量分联动目标） ───
  supplierRelationId String?
  supplierName       String?

  photos Json? // 照片附件 [{name,url,uploadedAt}]
  notes  String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([developmentCaseId])
  @@index([orderId])
  @@index([supplierRelationId])
  @@index([dyeLotNo])
  @@index([stage])
  @@index([colorCardId])
}

// ============================================================================
// REQ2-09 Pantone 色号库（DR-051，IND-02 L0 → L3）
// ============================================================================
/// 设计真源：Development-开发/Pantone色号库.md §4
/// 业务语义：标准色卡参照库（Pantone TCX seed 起步 + 客户自定义），打色选色号
/// 即带出 RGB 参考与相近历史打色。RGB 为公开近似值口径，对色以实物色卡为准。
model ColorCard {
  id        String  @id // 格式：CLR__${shortId}
  code      String  @unique // 色号（"19-4052 TCX" / 客户自定义）
  name      String? // 色名（"Classic Blue"）
  family    String? // 色系（Blue / Red / ... 用于筛选）
  r         Int // sRGB 0-255（公开近似值）
  g         Int
  b         Int
  source    String  @default("seed") // seed | custom
  deletedAt BigInt?
  createdAt BigInt
  updatedAt BigInt

  @@index([family])
}

// ============================================================================
// REQ2-10 工厂延迟链路影响计算（DR-052，X-02 L0 → L3）
// ============================================================================
/// 设计真源：Suppliers-供应商/工厂延迟链路影响计算.md §4
/// 业务语义：工厂延迟事实登记 + 受影响聚合快照（缓冲侵蚀三级分级）。
/// 登记即联动 FactoryEvaluation(delivery) 交期分下调（recordAutoEvaluation 幂等）。
/// 订单交期变更走既有 OrderChangeRequest 审批（DR-052-① 两域分离）。
model FactoryDelayRecord {
  id                 String   @id // 格式：FDR__${shortId}
  recordNumber       String   @unique // 业务号：FDR-YYYYMMDD-001
  supplierRelationId String? // 工厂 Relation（快照 FK）
  supplierName       String // 冗余快照
  delayDays          Int // 延迟天数（正整数）
  reason             String? // capacity | material | quality_rework | weather | other
  reasonNote         String? // 自由备注
  affectedOrderIds   String[] @default([]) // 登记时受影响订单快照
  impactSummary      Json? // 分级快照 {critical, warning, info, criticalOrderIds}
  registeredBy       String? // 登记人
  createdAt          BigInt
  deletedAt          BigInt?

  @@index([supplierRelationId])
  @@index([createdAt])
}

// ============================================================================
// REQ2-15 客户破产货权处置（DR-055，X-10 L0 → L3）
// ============================================================================
/// 设计真源：财务与结算/客户破产货权处置.md §4
/// 业务语义：客户破产案件（状态机 processing→closed）+ 处置动作流（append-only 全程留痕）。
/// 开案即调用既有 creditService freeze（DR-055-③）；发票作废走既有 void 通道不双轨（DR-055-②）。
model BankruptcyProceeding {
  id                 String  @id // 格式：BKP__${shortId}
  proceedingNumber   String  @unique // 业务号：BKP-YYYYMMDD-001
  relationId         String // 破产客户 Relation
  relationName       String // 冗余快照
  status             String  @default("processing") // processing | closed
  declaredAt         String // 宣告日 YYYY-MM-DD
  totalClaimedAmount Decimal @default(0) @db.Decimal(18, 4) // 申报债权总额（开案登记）
  closeNote          String? // 闭案备注（含净损失结论）
  closedAt           BigInt?
  createdAt          BigInt
  updatedAt          BigInt
  deletedAt          BigInt?

  @@index([relationId])
  @@index([status])
}

/// 处置动作（append-only；declare 首动作开案，close 终动作闭案）
model BankruptcyAction {
  id           String  @id // 格式：BKA__${shortId}
  proceedingId String
  actionType   String // declare | resale | return_shipment | bad_debt | recover | close
  amount       Decimal @default(0) @db.Decimal(18, 4) // 金额（转卖回收/坏账/回款/退运成本；declare/close 为 0）
  payload      Json? // 快照：买家/运单号/发票号/订单号/币种等
  note         String?
  actor        String? // 操作人
  createdAt    BigInt
  deletedAt    BigInt?

  @@index([proceedingId])
}

// ============================================================================
// Migration 5 — P1-1：PaymentRequest 付款申请单（DR-017 先申请后付款）
// ============================================================================
/// 设计真源：财务域模型组.md §2.1
/// 审批与执行分离：PaymentRequest(Approved) → 生成 PaymentVoucher(Disbursement)
model PaymentRequest {
  id            String @id // 格式：PAYR__${shortId}
  requestNumber String @unique // 业务申请号：PAYR-YYYYMMDD-001

  // ─── 业务字段 ───
  supplierId          String? // 供应商 Relation ID（snapshot FK）
  supplierName        String? // 冗余快照
  /// Customer is only created by the CN refund domain; supplier fields stay empty.
  payeeType           String @default("Supplier")
  customerRelationId  String?
  customerName        String?
  requestDate         String // 申请日期 YYYY-MM-DD
  expectedPaymentDate String? // 预期付款日期 YYYY-MM-DD
  totalAmount         Decimal @db.Decimal(18, 4) // 申请金额
  currency            String  @default("CNY")

  // ─── 申请人 & 审批人（DR-007 组织归属解析）───
  applicantId String // 申请人 userId
  reviewerId  String // NOT NULL，服务端 resolveReviewerByDepartment 解析

  // ─── 状态机 ───
  /// Draft(编辑中) → Pending(提交申请，生成 ApprovalRequest)
  /// → Approved(审批通过，可生成 PaymentVoucher) / Rejected(驳回退回 Draft)
  /// 供应商沿既有 VoucherIssued 凭证链；Customer CN退款 Approved → Executing
  /// → Paid(财务实际日期/方式/流水/私有证据同事务确认)，不可把生成凭证冒充实付。
  /// Cancelled 只适用尚未实际执行的申请；已实付实际返款另走专用流程。
  status String @default("Draft")

  // ─── 关联审批 & 付款凭证 ───
  approvalRequestId String? // 关联 ApprovalRequest.id（Approved 时必有）
  paymentVoucherId  String? // 关联 PaymentVoucher.id（Paid 时必有）

  // ─── 费用分类（同 PaymentVoucher.voucherCategory）───
  /// normal | advance | deposit | sample_express | customer_reimburse | business_cost
  paymentCategory String @default("normal")

  // ─── 归属（dataScope）───
  ownerId      String?
  departmentId String?

  // ─── 备注 / 附件 ───
  remark      String?
  attachments Json?

  // ─── 时间戳 + 软删 ───
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cashRefund CreditNoteRefund?

  @@index([status])
  @@index([supplierId])
  @@index([applicantId])
  @@index([reviewerId])
  @@index([requestNumber])
  @@index([requestDate])
  @@index([ownerId])
  @@index([departmentId])
}

// ============================================================================
// Migration 5 — P1-3：CreditLimitHistory 额度变更历史（append-only）
// ============================================================================
/// 设计真源：信用控制规则.md §2.2.1 额度释放闭环触发链路
model CreditLimitHistory {
  id            String @id // 格式：CLHIST__${shortId}
  creditLimitId String // 关联 CreditLimit.id
  relationId    String // 冗余：关联 Relation.id（便于按客户查历史）

  // ─── 变更前后 ───
  beforeUsedAmount Decimal @db.Decimal(18, 4)
  afterUsedAmount  Decimal @db.Decimal(18, 4)
  delta            Decimal @db.Decimal(18, 4) // after - before（负=释放，正=占用）

  // ─── 触发来源 ───
  /// payment_allocate | order_confirm | order_cancel | manual_adjust | credit_freeze | credit_thaw
  triggerType String
  triggerId   String? // 触发源 ID（InvoiceAllocation.id / Order.id / ApprovalRequest.id 等）
  triggerBy   String? // 触发人 userId（系统自动则为 'system_*'）

  remark    String?
  createdAt DateTime @default(now())

  @@index([creditLimitId])
  @@index([relationId])
  @@index([triggerType])
  @@index([createdAt])
}

// ============================================================================
// Migration 5 — P1-4：OrderInternalTransfer 内部面料交易核算（DR-005）
// ============================================================================
/// 设计真源：订单与生产模型组.md §2B.4
model OrderInternalTransfer {
  id      String @id // 格式：OIT__${shortId}
  orderId String // 关联 Order.id（isInternalFabricTrade=true 的订单）

  // ─── 交易方向 ───
  transferDirection String // outgoing(我方卖出) | incoming(我方买入)
  counterpartyId    String // 关联方 ID（内部公司/关联方）
  ourDepartmentId   String? // 我方归属部门

  // ─── 核算快照 ───
  transferAmount   Decimal @db.Decimal(18, 4) // 内部交易金额
  transferCurrency String  @default("CNY")
  transferDate     String // 交易日期 YYYY-MM-DD

  // ─── 认账 ───
  recognizedBy String? // 认账人 userId
  recognizedAt DateTime?

  memo String?

  // ─── 时间戳 + 软删 ───
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([orderId, transferDirection]) // 一张订单每个方向仅 1 条
  @@index([orderId])
  @@index([counterpartyId])
  @@index([transferDirection])
}

// ============================================================================
// Migration 5 — P1-8：UserPermissionOverrides 临时权限授权
// ============================================================================
/// 设计真源：HR模块概述.md §10.6 / 薪酬与工资条.md §10
/// SuperAdmin 可通过此表给指定人员追加敏感 scope（如 hr:salary:read）
model UserPermissionOverrides {
  id     String @id // 格式：UPO__${shortId}
  userId String // 被授权用户 userId
  scope  String // 权限 scope（如 'hr:salary:read' / 'sensitive:salary' / 'settings:moq:write'）

  // ─── 授权信息 ───
  grantedBy String // 授权人 userId（必须为 SuperAdmin）
  grantedAt DateTime  @default(now())
  reason    String // 授权理由
  expiresAt DateTime? // 过期时间（null = 长期有效）

  // ─── 状态 ───
  isActive Boolean @default(true) // false = 已撤销

  // ─── 时间戳 + 软删 ───
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, scope]) // 同一用户同一 scope 仅 1 条 active
  @@index([userId])
  @@index([scope])
  @@index([isActive])
}

// ============================================================================
// Migration 6 — P1-13：EarlyProductionSample 面料早期生产样（DR-015）
// ============================================================================
/// 设计真源：订单与生产模型组.md §14 样品类型表 / QC模块概述.md §16 QC-015
/// 业务语义：面料大货开机后早期（例：第 500 米出缸时）先送 2~5 米样品=早期生产样；
/// 客户提前评估颜色/手感/幅宽；与 QC 可选关联（DR-029 面料链业务登记为主）。
/// 与 FabricShipmentSample(S/S) 的关系：EarlyProductionSample → 客户反馈 → 大货继续/调整
/// → FabricShipmentSample(S/S) → 大货QC → 出运（3 条件并行）。
model EarlyProductionSample {
  id         String @id // 格式：EPS__${shortId}
  sampleCode String @unique // 业务号：EPS-YYYYMMDD-001

  orderId         String // 关联 Order.id（面料订单，业务归属）
  fabricProfileId String? // FabricProfile.id
  millName        String? // 冗余：生产工厂

  // ─── 样品基础 ───
  sampleQuantity   Decimal  @db.Decimal(10, 2)
  sampleUnit       String   @default("meter")
  productionStage  String? // 取样阶段（greige_out_of_loom / after_dyeing / after_finishing）
  producedMeterage Decimal? @db.Decimal(12, 2) // 取样时已生产米数（判断是否足够早期）
  cuttingDate      String // 取样日期 YYYY-MM-DD

  // ─── 业务寄送 & 客户确认 ───
  sentToCustomer       Boolean @default(false)
  sentDate             String?
  trackingNumber       String?
  /// pending | approved | rejected | adjust_and_resend
  customerStatus       String  @default("pending")
  customerFeedbackDate String?
  customerFeedbackNote String? @db.Text

  // ─── QC（DR-029：仅 customerStatus=rejected 或业务主动转QC时调用） ───
  qcInspectionReportId String?
  qcRequestedBy        String?
  qcRequestedAt        DateTime?

  // ─── 调整 & 重发（customerStatus=adjust_and_resend 时链到下次 EarlyProductionSample） ───
  previousSampleId String? // 反向关联 EarlyProductionSample.id（第 N 轮→第 N+1 轮调整链）

  notes       String?
  attachments Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orderId])
  @@index([customerStatus])
  @@index([previousSampleId])
  @@index([qcInspectionReportId])
}

// ============================================================================
// Migration 6 — P1-15：Dr013ExceptionRequest DR-013 受控例外申请
// ============================================================================
/// 设计真源：审批与human-in-the-loop.md §14 DR7-B4 / 底座域模型组.md §39 BASE-39-B3
/// 业务语义：某审批单（MOQ/价格/变更/出运/样品等）被 Rejected 后，业务认为必须破例
/// → 发起 Dr013ExceptionRequest → 仍走 DR-007 组织归属（主管自申请→Z→BOSS 兜底）。
/// 1 张 Dr013ExceptionRequest 绑定 1~N 张被拒 ApprovalRequest（bypassedApprovalIds 数组）。
model Dr013ExceptionRequest {
  id              String @id // 格式：EXC__${shortId}
  exceptionNumber String @unique // 业务号：EXC-YYYYMMDD-001

  // ─── 例外分类（与 5 类豁免端到端对齐，DEV-11-A1~A4） ───
  /// moq_exemption | price_deviation | order_change | shipment_release | qc_fault | payment_term | sample_skip | other
  exceptionCategory String
  subCategory       String? // 细分（例：shipment_release 的 "without_ss_confirmed"）

  // ─── 被绕过的被拒审批链（≥1 张 ApprovalRequest.status=REJECTED） ───
  bypassedApprovalIds String[] // 绑定的 ApprovalRequest.id 列表

  // ─── 核心理由 & 客户承诺（最终 BOSS 兜底用） ───
  exceptionReason    String  @db.Text // 例外理由（≥30字，fail-closed）
  customerCommitment String? @db.Text // 客户书面承诺（例：额外补偿 + 次年 3 倍增量订单）
  riskMitigationPlan String? @db.Text // 风险应对措施（例：冻结客户 20% 尾款作为保证金）

  // ─── 申请人 & 审批（仍走 DR-007 组织归属解析） ───
  requesterId       String
  reviewerId        String // NOT NULL，DR-007 resolveReviewerByDepartment
  approvalRequestId String? // 关联 ApprovalRequest.id（本 EXC 请求的审批链）

  // ─── 状态机 ───
  /// Draft → Pending → ReviewerApproved / ReviewerRejected → BossFinalBypass → Approved / Cancelled
  status String @default("Draft")

  // ─── BOSS 最终兜底（与 ApprovalRequest.bossFinalBypass* 对齐） ───
  bossFinalBypassBy     String?
  bossFinalBypassAt     DateTime?
  bossFinalBypassReason String?   @db.Text // ≥30字，同 ApprovalRequest 校验

  notes       String?
  attachments Json? // 客户承诺邮件截图、合同扫描件等

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([exceptionCategory])
  @@index([status])
  @@index([requesterId])
  @@index([reviewerId])
  @@index([exceptionNumber])
}

// ============================================================================
// REQ2-16：样品间管理（IND-05 实体流程数字化，DR-057）
// ============================================================================
/// 设计真源：Development-开发/样品间管理.md §4
/// 业务语义：实物样卡登记（二维码编号=载荷）→ 借出/归还状态机 → 看样记录挂客户。
/// 实体样卡与逻辑色卡（ColorCard，REQ2-09）分轨：colorCardCode 可选关联不带库存。
model SampleCardItem {
  id            String  @id // 格式：SCI__${shortId}
  code          String  @unique // 样卡编号：SC-YYYYMMDD-NNN（二维码载荷）
  name          String // 样卡名称（面料名/色卡名/成衣款名）
  cardType      String  @default("fabric") // fabric | garment | colorcard | trim | other
  colorCardCode String? // 关联逻辑色卡 ColorCard.code（可选）
  location      String? // 样品间架位（仓库内架位文本，与 warehouseId 配合）
  /// Structured physical address within a sample room; full custody projection only.
  locationDetail Json? // { zone, shelf, level, bin }
  status        String  @default("in_stock") // in_stock | borrowed | shipped | retired
  notes         String?
  /// Immutable initial batch receipt fact; Decimal length strings and explicitly
  /// counted physical Int units stay separate. Null is legacy/manual, never verified by inference.
  receiptSnapshot Json?
  /// Private sample-room photo metadata only; image bytes live under private-files.
  photos        Json?
  createdAt     BigInt
  updatedAt     BigInt
  deletedAt     BigInt?

  /// Descriptive library metadata; never replaces exact source receipt evidence.
  libraryMetadata Json?
  customerRelationId String?
  /// Only genuinely standalone manual internal records have a creator custodian.
  custodianUserId String?
  registrationKey String? @unique
  registrationFingerprint String?

  // DR-054 阶段 C：封样 = 实物级 tag（从确认批次选一实物基准，记录标准批次 reference）
  sealedStatus    String  @default("unsealed") // unsealed | sealed
  sealedAt        BigInt?
  sealedBy        String?
  standardBatchNo String? // 封样标准批次 reference（面料=工厂 batch no；换 batch 不换档案）

  // ─── 库存管理字段（与 InventoryManager 联动；DR-057 v2 升级） ───
  quantity     Int     @default(1) // 总数量
  availableQty Int     @default(1) // 可用数量（quantity - 在借未归还）
  /// Decimal meter stock for yardage. Count stock above remains for physical cards/pieces.
  physicalLengthQty Decimal? @db.Decimal(18, 4)
  availableLengthQty Decimal? @db.Decimal(18, 4)
  minStock     Int? // 低库存预警阈值
  maxStock     Int? // 高库存上限
  unit         String? @default("张") // 单位

  // ─── 软关联（与 DevelopmentCase.linkedOrderId 一致风格，无 FK 约束） ───
  warehouseId    String? // 关联 Warehouse.id（仓库体系联动）
  devCaseId      String? // 关联 DevelopmentCase.id（开发管理联动）
  batchId        String? // 关联 SampleBatch.id（打样批次；DR-054 实物登记归属）
  orderId        String? // 关联 Order.id（大货订单联动）
  productAssetId String? // 关联 ProductAsset.id（数字档案联动：面料档案/服装档案）
  // DR-052 §10#3 迁入对齐：实物样卡 ↔ 统一样品对象（Sample）软关联
  // 样品库存保留独立库存行（数量/位置/借还），此处仅建立统一呈现的样品归属
  sampleId       String? // 关联 Sample.id（样品管理域统一样品对象；DR-052）

  @@index([status])
  @@index([cardType])
  @@index([warehouseId])
  @@index([devCaseId])
  @@index([batchId])
  @@index([orderId])
  @@index([productAssetId])
  @@index([sampleId])
}

/// 借还/看样/出样流水（append-only：归还只补 returnedAt/conditionNote，不删不改历史）。
/// borrow=内部借出（borrowerUserId）；viewing=客户看样（relationId 快照，即看即还不占借出状态）；
/// ship=寄出（客户/外部，扣减数量+终态归档，不可归还；DR-054 出样语义）。
model SampleCardLoan {
  id             String  @id // 格式：SCL__${shortId}
  itemId         String
  loanType       String // borrow | viewing | ship
  loanQuantity   Int     @default(1) // 借出/寄出数量（DR-057 v2：支持一次借多张）
  loanLength     Decimal? @db.Decimal(18, 4) // 米样借出/寄出长度；与件数流水互斥
  returnedLengthQty Decimal? @db.Decimal(18, 4) // 米样累计已归还；旧件数流水为空
  lengthReturnHistory Json? // append-only: requestKey, commandHash, length, operatorId, returnedAt, conditionNote
  meterRequestKey String? // actor-scoped stable borrow/ship request
  meterCommandHash String?
  borrowerName   String // 借用人/看样联系人
  borrowerUserId String? // borrow 时关联用户
  relationId     String? // viewing 时关联客户 Relation
  relationName   String? // 冗余快照
  loanedAt       BigInt
  dueAt          BigInt? // 预计归还（borrow 必填，viewing 可空）
  returnedAt     BigInt?
  conditionNote  String? // 归还状态备注（损坏/缺失留痕）
  operatorId     String? // 登记人
  createdAt      BigInt

  @@index([itemId])
  @@index([loanType, returnedAt])
  @@unique([operatorId, meterRequestKey])
}

// ============================================================================
// REQ2-13：业务员离职一键交接（X-07 资产安全类，DR-056）
// ============================================================================
/// 交接单（append-only 留痕）：一次离职交接的完整快照——谁在何时把哪些
/// 客户资产移交给谁、是否停用账号、各类资产计数。历史不可篡改。
/// 设计真源：docs/design/04-模块设计/02-客户与开拓/业务员离职一键交接.md
model HandoverRecord {
  id             String  @id // 格式：HO_${shortId}
  fromUserId     String // 离职者
  toUserId       String // 接收人
  operatedBy     String // 操作人（管理员）
  fromUserName   String // 冗余快照：离职者显示名
  toUserName     String // 冗余快照：接收人显示名
  /// 交接时是否同步停用离职者账号（默认 true）
  disableAccount Boolean @default(true)
  note           String? // 交接备注
  /// 五类资产计数快照：{ relationsOwned, relationsCoFollowed, opportunities, followUpRecords, unanchoredOrders }
  detail         Json?

  createdAt DateTime @default(now())

  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdAt])
}

// ============================================================================
// 客户门户 (Customer Portal) —— 外部客户登录后查看本公司订单/出运/发票
// ============================================================================
/// 客户账号：登录后只能读取「relationId 对应客户公司」名下的业务数据。
/// 与内部 UserAccount（RBAC/角色）完全解耦——客户没有角色，只有「看哪家公司的数据」。
/// H16-② 客户对账确认回执（对账函回签的电子化，2026-09-16）
///
/// 行业口径：企业与客户定期（通常按月）核对往来余额，客户确认后双方账目锁定。
/// 电子化 = 客户在门户看到对账单 → 点「确认无异议」或「有异议（附说明）」。
///
/// 口径（业务方授权按专业判断）：
///   - **按期间**（月度对账函），不是逐张发票确认 —— 与客户财务的对账习惯一致；
///   - 确认后**记录 + 通知内部**，但**不锁定数据**（对账后仍可能有新业务，锁定会卡死开票）；
///   - 快照按**币种分组**存储（跨币种不合并 —— T7-① 口径）。
model CustomerReconciliationAck {
  id                 String  @id // 格式：CRA__${shortId}
  customerRelationId String // 客户（数据作用域真源，与客户门户同口径）
  customerUserId     String? // 提交人（CustomerUser.id）
  customerUserName   String? // 冗余快照（改档/停用后仍可追溯）

  periodStart String // 期间起 YYYY-MM-DD（含）
  periodEnd   String // 期间止 YYYY-MM-DD（含）

  status String @default("confirmed") // confirmed(确认无异议) | disputed(有异议)

  /// 确认时的对账快照（按币种分组：期初余额 / 本期开票 / 本期收款 / 期末余额）
  snapshot Json

  disputeNote String? // 异议说明（status=disputed 时必填）
  ip          String? // 提交来源 IP（留痕）

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([customerRelationId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

model CustomerUser {
  id           String    @id // 格式：CUSU__${shortId}
  email        String    @unique
  passwordHash String
  displayName  String
  relationId   String // 绑定的客户公司 Relation.id（数据作用域真源）
  relationName String? // 冗余快照
  contactPhone String?
  status       String    @default("active") // active | disabled
  lastLoginAt  DateTime?
  lastLoginIp  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    BigInt?

  @@index([relationId])
  @@index([status])
}

// ============================================================================
// 账号验证码（B5-1 持久化）：注册/重置密码验证码落库，替代进程内存 Map——
// 重启不再失效、多实例可用。codeHash=sha256(6位码)，原码不落库。
// ============================================================================
model UserVerificationCode {
  id         String    @id // vcode__${shortId}
  email      String // 归一小写
  purpose    String // register | reset_password
  codeHash   String
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  @@unique([email, purpose]) // 同邮箱同用途仅一条活跃码（重发覆盖）
  @@index([expiresAt])
}

// ════════════════════════════════════════════════════════════════════
// A 组 · 售后索赔模型（客户投诉/索赔）
//
// 口径依据：docs/业务口径决策单-2026-09-17.md A1 · A1-附 · A2–A6
// 实施方案：docs/A组售后索赔模型-实施方案-2026-09-17.md
//
// 设计骨架（业务方 2026-09-17 拍板，四条不可动）：
//   ① 一次客诉 = 一个「售后案件」ClaimCase，案件下**可同时有多条处置**
//      （真实客诉常是"100 件里 30 件退货、70 件折让"，**不是一种客诉对应一种处理**）
//   ② **钱只有一条线**：所有该退客户的钱 → 一张「退款单」CreditNote（客户拿到的正式单据）
//   ③ **货只有一条线**：所有要退回来的货 → 一张「退货入库单」ReturnReceipt（去向必记）
//   ④ 退款单**有独立状态**（未核销 → 部分核销 → 已结清），**不复用发票的 Paid**
//      —— 现状卡死点：Invoice.amount ≤ 0 的票永远到不了 Paid
// ════════════════════════════════════════════════════════════════════

/// 售后案件（一次客诉一条）
/// 生命周期：Registered（已登记）→ Processing（处理中）→ PendingApproval（待审批）
///          → Handled（已处理）→ Closed（已关闭）/ Cancelled（已撤销）
model ClaimCase {
  logicalCreditNote CreditNote? @relation("ClaimLogicalCN")
  id                 String  @id // 格式：CLMCASE_${shortId}
  caseNumber         String  @unique // 业务案件号（CLM-YYYY-NNNN，nextBusinessNumber 生成）
  customerRelationId String? // 客户（snapshot FK → Relation.id）
  customerName       String? // 客户名冗余快照
  sourceOrderId      String? // 关联订单（可空：客户可能只投诉、不指订单）
  sourceInvoiceId    String? // 关联发票（可空）

  status            String  @default("Registered") // Registered | Processing | PendingApproval | Handled | Closed | Cancelled
  /// 客诉类型（业务分类，便于统计）：Quality(质量) | ShortShip(短装) | WrongItem(错发)
  /// | Delay(延期) | Packing(包装) | Other
  category          String?
  problemDesc       String // 问题描述（客户原话/要点）
  attachments       Json? // 照片/文件引用列表
  reportedAt        String // 客户报诉日 YYYY-MM-DD（业务日）
  reportedBy        String // 登记人 userId
  /// 处置汇总（执行后回填，供列表展示免 join）：退客户金额合计（正数）
  totalCreditAmount Decimal @default(0) @db.Decimal(18, 4)
  creditCurrency    String? // 金额币种
  /// 退货数量合计（动货的处置合计）
  totalReturnQty    Decimal @default(0) @db.Decimal(18, 4)

  closedAt  String? // 关闭日 YYYY-MM-DD
  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([customerRelationId])
  @@index([sourceOrderId])
  @@index([status])
  @@index([reportedAt])
}

/// 案件下的一条处置（一个案件可多条；钱/货两条腿由此展开）
model ClaimDisposition {
  id          String @id // 格式：CLMDISP_${shortId}
  claimCaseId String // snapshot FK → ClaimCase.id

  /// Allowance(折让，只动钱) | ReturnRefund(退货退款，钱+货)
  /// | Replace(换货补发，只动货) | Repair(返修，只动货)
  /// ★ 四种 kind 全部支持（A-3 二期已解除一期的两档限制）：Allowance · ReturnRefund · Replace · Repair
  kind String

  // ─── 实物（动货的三种必填）───
  materialCode String? // 物料编码（库存联动锚点）
  quantity     Decimal? @db.Decimal(18, 4) // 退货/换货/返修数量
  unit         String?

  // ─── 金额（动钱的两种必填）───
  /// **正数**语义 = 应退客户多少；落库到 CreditNote 时同样用正数（方向由单据类型表达）
  amount   Decimal? @db.Decimal(18, 4)
  currency String?

  /// 退货去向（**动货的三种必填**）：Scrap(报废) | Replace(换货补发) | Repair(返修)
  /// ★ 不记清 ⇒ 货在账上凭空消失（口径 A1-附 ③）
  returnDisposition String?

  // ─── 执行产出（execute 时回填）───
  creditNoteId          String? // snapshot FK → CreditNote.id
  returnReceiptId       String? // snapshot FK → ReturnReceipt.id
  replacementShipmentId String? // 二期：补发出运单（snapshot FK → Shipment.id）
  repairWorkOrderId     String? // 二期：返修工单

  status       String  @default("Draft") // Draft | Approved | Executed | Cancelled
  /// 审批人（口径 A7：**任何金额都汇总领导批**）
  approverId   String?
  approvedAt   String?
  /// 撤销留痕（口径 A5：能撤销，且要留痕）
  cancelledAt  String?
  cancelledBy  String?
  cancelReason String?
  notes        String?
  createdAt    BigInt
  updatedAt    BigInt
  deletedAt    BigInt?

  returnLines ReturnReceiptLine[]
  claimCreditNoteLines ClaimCreditNoteLine[]

  @@index([claimCaseId])
  @@index([kind])
  @@index([status])
}

/// 退款单（贷项通知单 Credit Note，CN）—— 客户拿到的正式单据
/// ★ 口径 A2：**独立单据 + 可被核销**（抵扣下张发票 / 现金退款）—— 「一张凭证 + 一次结算」
/// ★ 口径 A3：**独立状态** Open → PartiallyApplied → Closed；**不复用 Invoice 的 Paid**
model CreditNote {
  id                 String  @id // 格式：CN_${shortId}
  creditNoteNumber   String  @unique // 业务单号（CLM-YYYY-NNNN，nextBusinessNumber 生成）
  customerRelationId String? // 客户（snapshot FK → Relation.id）
  customerName       String? // 客户名冗余快照
  claimCaseId        String? // 来源案件（可空：也支持非客诉的纯折让）
  /// New complete claim accounts use this unique link. Legacy multiple CNs stay untouched.
  logicalClaimCaseId String? @unique
  logicalClaimCase ClaimCase? @relation("ClaimLogicalCN", fields: [logicalClaimCaseId], references: [id])
  sourceInvoiceId    String? // 关联原发票（可空）

  currency   String // 币种
  /// 原始金额（**正数**，语义 = 应退客户）
  amount     Decimal @db.Decimal(18, 4)
  /// Current liability after approved appended versions; legacy standalone CNs use amount.
  currentAmount Decimal? @db.Decimal(18, 4)
  /// Snapshot reference, validated against this CN by the version service.
  currentVersionId String? @unique
  /// ★ 未核销余额 = amount − Σ已核销。**结清判据 = 余额为 0**
  openAmount Decimal @db.Decimal(18, 4)

  status    String @default("Open") // Open(未核销) | PartiallyApplied(部分核销) | Closed(已结清) | Cancelled(已作废)
  issueDate String // 开单日 YYYY-MM-DD

  /// 核销出口一：抵扣到某张发票（口径 A2）
  appliedToInvoiceId String?
  /// 核销出口二：现金退款（一期**暂不实现**，字段先留位；见实施方案 §六.2）
  refundedAt         String?
  refundedBy         String?

  reason       String? // 事由（如"客诉 CLM-2026-0001 色差折让"）
  notes        String?
  /// 作废留痕（口径 A5）
  cancelledAt  String?
  cancelledBy  String?
  cancelReason String?
  createdAt    BigInt
  updatedAt    BigInt
  deletedAt    BigInt?

  lines ClaimCreditNoteLine[]
  versions CreditNoteDocumentVersion[]
  settlementEvents CreditNoteSettlementEvent[]
  cashRefunds CreditNoteRefund[]
  cashRefundReturns CreditNoteRefundReturn[]

  @@index([customerRelationId])
  @@index([claimCaseId])
  @@index([status])
  @@index([issueDate])
}

