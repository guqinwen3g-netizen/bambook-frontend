generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProjectMemory {
  id          String   @id
  type        String
  layer       String
  content     String
  description String?
  timestamp   BigInt
  deletedAt   BigInt?
  source      String?  @default("ARCHITECT")
  status      String?  @default("STABLE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([layer])
  @@index([type])
}

model BusinessProfile {
  id        String  @id
  kind      String
  name      String
  payload   Json
  assets    Json?
  isActive  Boolean @default(true)
  updatedAt BigInt
  deletedAt BigInt?

  @@index([kind])
  @@index([isActive])
}

model KnowledgeItem {
  id        String  @id
  title     String
  content   String
  category  String
  sourceUrl String?
  updatedAt BigInt
  deletedAt BigInt?

  @@index([category])
}

model Order {
  orderSampleCommandCancellations OrderSampleCommandCancellation[]
  orderSampleSources OrderSampleSource[]
  customerPoEvidence CustomerPoEvidence[]
  id          String  @id
  customer    String
  product     String
  type        String
  quantity    Decimal? @db.Decimal(18, 4)
  unit        String?
  status      String
  dueDate     String // 出厂交期 Ex-mill 的旧兼容字段，与 clientDate 同源
  quoteAmount Decimal @db.Decimal(18, 4)
  updatedAt   BigInt?
  deletedAt   BigInt?

  // --- Imported PO header (nullable for legacy rows) ---
  /// 外部客户 PO/合同引用；同一 PO 的面料和成衣分别建单，不能作内部唯一身份。
  poNumber          String?
  customerCode      String?
  season            String?
  poDate            String?
  contactPerson     String?
  contactPhone      String?
  currency          String?
  deliveryTerms     String?
  contractDeliveryDate String? // 合同交货节点日期，不与 Ex-mill 混用
  deliveryPlace     String? // 贸易条款对应的指定地点/港口
  expectedArrivalDate String? // 运输预计到达；不是合同承诺
  agreedArrivalDate String? // 合同明确约定送达；不替代 Ex-mill
  paymentTerms      String?
  // ★ 2026-09-29：合同条款区的三个「未录」字段（使用方逐条拍板，见 docs/inventory/待使用方判清单.md §八/§十一）。
  // ★ 全部可空、刻意不给默认值 —— NULL 的语义是「未录」（= 不知道），
  //   填默认值会把「不知道」伪造成一个合法值（与 A19 同一条纪律）。
  insuranceMode     String? // 保险方式：出卖人投保110% / 买受人自理（J-6 决定：订单上能选）
  claimPeriodDays   Int? // 索赔期（天）：货到目的口岸后 N 天内可提异议（J-7 决定：能填+到期提醒）
  disputeResolution String? // 争议解决方式：仲裁 / 诉讼（使用方决定：加二选一）
  shipToName        String?
  shipToAddress1    String?
  shipToAddress2    String?
  shipToCountry     String?
  shipToPhone       String?
  deliverTo         String?
  totalNet          Decimal? @db.Decimal(18, 4)
  totalActual       Decimal? @db.Decimal(18, 4)
  source            String? // historical provenance, e.g. "legacy-import" or "manual"
  importedAt        BigInt?

  // ============ Phase 2: per-field provenance + currency split ============
  /// JSONB map retained for historical parsed-import provenance; customer PO files
  /// are evidence only and are never parsed into order fields in the current MVP.
  fieldSources     Json?
  purchaseCurrency String? // default 'CNY' for purchase-side amounts
  salesCurrency    String? // default 'USD' for sales-side amounts

  // ============ REQ2-18：Tech Pack 结构化解析（DR-059） ============
  /// 解析快照：{ styleNo?, season?, fabricComposition?, colors?, sizeBreakdown?,
  /// totalQty?, deliveryDate?, confidence, pages, textLength, uploadedAt }
  /// 设计真源：Orders-订单管理/TechPack解析.md §2 DR-059-②（覆盖式单快照，历史经审计可溯）
  techPack         Json?
  techPackFileName String? // 规格书附件名（uploads/techpacks/{orderId}/ 下回读）

  // ============ Phase 2: Role snapshots + Relation FKs ============
  // FKs are *snapshot* references — we do NOT enforce a foreign-key constraint
  // because Relation rows can be archived independently of orders.
  customerAddress    String?
  customerRelationId String?

  // Mill / 面料工厂 / supplier (应付侧)
  millName       String?
  millAddress    String?
  millContact    String?
  millPhone      String?
  millRelationId String?

  // Consignee / 服装厂收货方 (物流目的地)
  consigneeName       String?
  consigneeAddress    String?
  consigneeContact    String?
  consigneeRelationId String?

  // Bill-to / 结款方 (服装厂或其代理)
  billToName       String?
  billToAddress    String?
  billToContact    String?
  billToIsAgent    Boolean?
  billToRelationId String?

  // ============ Internal Team ============
  salesPerson            String?
  salesPersonRelationId  String?
  merchandiser           String?
  merchandiserRelationId String?
  supervisor             String?
  supervisorRelationId   String?

  // ============ Phase 2: Contracts ============
  salesContractNumber String? // 早期销售合同号 (出给客户)
  finalContractNumber String? // 最终销售合同号 (出给 Bill-to)

  // ============ Phase 2: Detail-card rich fields (lifted from localStorage) ============
  // Production / OTS basic
  productionBatch  String?
  productColorCode String?
  clientCode       String? // ZROH 客户编码 (sticky overlay on top of firstLine.materialCode)
  referenceBatch   String?
  productionDate   String? // 生产交期
  clientDate       String? // 出厂交期 (Exmill)

  // Fabric specs (sticky overlay on top of firstLine; PDF supplies fallback)
  fabricCode    String?
  fabricContent String?
  width         String?
  gsm           String?

  // A/S contact (跟单/售后)
  asPerson String?

  // Sales / collection
  salesPrice          Decimal? @db.Decimal(18, 4)
  contractAmount      Decimal? @db.Decimal(18, 4)
  paymentInstrument   String? // T/T, L/C, O/A, D/P, D/A
  expectedPaymentDate String?
  /// ★ D3 定金（2026-09-30 拍板）：T/T 定金比例结构化，**未收足定金不得进生产、不得发运**。
  ///   两列都**可空 = 未录**（不是 0）：0 会被读成「零定金 ⇒ 免检」，那是与风险相反的方向。
  ///   ⚠️ **已收定金不落库**：由收款侧（PaymentVoucher）归集计算 ⇒ 不在此造第二份真源（防两套账）。
  depositRatio        Decimal? @db.Decimal(5, 2) // 百分比，30.00 = 30%
  depositCurrency     String?
  actualPaymentDate   String?
  actualPaymentAmount Decimal? @db.Decimal(18, 4)

  // Shipment & invoice (我方开给 Bill-to)
  invoiceNumber    String?
  invoiceDate      String?
  shipmentDate     String?
  shipmentMethod   String?
  shipmentQuantity Float?
  shipmentAmount   Decimal? @db.Decimal(18, 4)

  // Shipment sample (大货船样)
  sampleSentDate         String?
  sampleConfirmedDate    String?
  sampleTrackingNumber   String?
  shipmentSampleComments String?

  // Fabric sample (匹头样)
  fabricSampleSentDate       String?
  fabricSampleConfirmedDate  String?
  fabricSampleTrackingNumber String?
  paidSampleQuantity         Float?

  // 客户实地验厂（PRD 5.1 中期验货附加门禁；PRD 7.1 到期提醒）
  factoryVisitDate String? // YYYY-MM-DD 客户计划实地验厂日

  // Purchase / supplier invoice (我方付给 Mill)
  purchasePrice         Decimal? @db.Decimal(18, 4)
  purchasePaymentDate   String?
  supplierInvoiceNumber String?
  supplierInvoiceDate   String?
  supplierInvoiceAmount Decimal? @db.Decimal(18, 4)

  // Misc
  specialInstructions String?
  ocDays              Int?

  // ============ 阶段 P0：业务线标记（BusinessLine.code 快照引用，见 H3 后 P0 块） ============
  // P0-7 补 other 值：fabric | garment | capsule | other（4值业务线标签；capsule仅对type=Garment生效的子类型透镜；other对应DR-028其他贸易）
  businessLine String? // fabric | garment | capsule | other（snapshot，不强制外键）

  // ============ MOQ 快照（writeOnce，创建时写入，不随配置变更追溯）—— P0-3 ============
  /// JSONB：{ fabricDefaultMoq, garmentDefaultMoq, capsuleMoq, snapshotAt, configId, source: 'moq_config' | 'fallback_constant' }
  /// 服务端在 Order.create 时 writeOnce 填充；后续不可更新（service 层强制）
  /// 设计真源：MOQ最小起订量.md §2.1-§2.3
  moqSnapshot Json @default("{}")

  // ============ Capsule MOQ 豁免标记（DR-003）—— P0-3 ============
  /// Capsule 勾选后 MOQ_effective 从 garmentDefaultMoq 降级为 capsuleMoq（不是完全无 MOQ）
  capsuleExemption   Boolean   @default(false)
  capsuleExemptionBy String? // 勾选操作者 userId（需 scope: moq:capsule_exemption:write）
  capsuleExemptionAt DateTime? // 勾选时间

  // ============ DR-005 内部面料交易标记 —— P0-3 ============
  /// true = 内部关联方交易，不进入对外营收，财务报表独立归集抵销
  /// 设计真源：订单与生产模型组.md §2B.4
  isInternalFabricTrade  Boolean @default(false)
  /// isInternalFabricTrade=true 时必填，关联内部公司/关联方 ID
  internalCounterpartyId String?

  /// Current internal demand facts; NULL legacy facts are never inferred.
  orderPurpose String? // external | internal_stock | internal_fabric_supply
  internalPurpose String?
  internalDemandTeamId String?
  internalReceiverId String?

  // ============ Production pipeline deadlines (业务十条规则) ============
  productionPlanDeadline String? // 下单后7天内需出生产计划（createdAt + 7d），超时触发预警
  delayNoticeDeadline    String? // 交货期前15天需发延期通知（dueDate - 15d），超时升级

  // ─── Phase 1-02 订单/履约域升级：接入平台域（权限/编号/字典） ───
  /// 订单编号（由 SequenceRegister 分配：SO-202608-001），与 id 独立
  code         String?  @unique
  /// 归属人 userId（行级权限 dataScope 用：Sales 仅看自己的订单）
  ownerId      String?
  /// 归属部门 departmentId（行级权限 dataScope 用：同部门互相可见，跨部门隔离）
  departmentId String?
  /// 创建时间（Order 原本只有 updatedAt BigInt，补 createdAt 便于排序和审计）
  createdAt    DateTime @default(now())

  // ─── DR-053 阶段 1：多订单关系 + 请求幂等（版本引用在 OrderLine） ───
  /// 来源开发案 ID（冗余快照：开发案→订单列表直接反查；DevelopmentCase.linkedOrderId 降级为最近一次快照）
  sourceCaseId    String?
  /// 调用方幂等键（UUID：每次真实操作生成一次，重试复用同值）——防重复提交重复建单；
  /// 合法返单 = 新 clientRequestId；重复提交 = 同 clientRequestId → 幂等恢复返回已有订单
  clientRequestId String?

  // ─── G3-4 订单结案（绿）：业务员手动"确认结清"（复用现有核销，进度满后确认）留痕 ───
  settledAt BigInt? // 结清时间（非空=已结案/绿）
  settledBy String? // 结清确认人

  lines             OrderLine[]
  statusTransitions OrderStatusTransition[]
  costReviews       OrderCostReview[]
  costReviewEvidence OrderCostReviewEvidence[]

  @@unique([clientRequestId])
  @@index([status])
  @@index([customerCode])
  @@index([millName])
  @@index([consigneeName])
  @@index([billToName])
  @@index([businessLine])
  @@index([poNumber])
  @@index([code])
  @@index([ownerId])
  @@index([departmentId])
  @@index([createdAt])
  @@index([dueDate])
  @@index([updatedAt])
  @@index([sourceCaseId])
}

/// Customer-issued PO originals retained as order evidence. Files are appended
/// as immutable versions and are never parsed into order fields.
model CustomerPoEvidence {
  id           String @id
  orderId      String
  version      Int
  requestKey   String
  originalName String
  mimeType     String
  byteSize     Int
  sha256       String
  storageKey   String
  uploadedBy   String
  uploadedAt   BigInt
  createdAt    BigInt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, version])
  @@unique([orderId, requestKey])
  @@index([orderId, createdAt])
}

model OrderLine {
  orderSampleCoverages OrderSampleCoverage[]
  id                  String   @id
  /// 创建时间（A1 补列，2026-09-25）：整链演练用 createdAt 做「本次窗口造了几行」的窗口计数。
  /// 本表原先没有任何创建时间列 ⇒ 链按 id 删过它的行却「没被问过」⇒ 残留判决只能报 unproven。
  /// ⚠️ 存量行由迁移填**哨兵 1970-01-01**（绝不能是 now()：那会被窗口计数算成「本次演练自造」= 假残留）。
  createdAt           DateTime @default(now())
  orderId             String
  lineNumber          Int
  itemNo              String?
  materialCode        String?
  millQuality         String?
  description         String?
  width               String?
  agreedDeliveryDate  String? // 客户单独约定的条目交货节点日期；空值继承主单
  deliveryAgreementBasis String? // 条目单独交期的真实客户约定依据
  exMillDate          String?
  deliveryDate        String?
  quantity            Decimal  @db.Decimal(18, 4)
  unit                String?
  unitPrice           Decimal? @db.Decimal(18, 4)
  netValue            Decimal? @db.Decimal(18, 4)
  via                 String?
  cloth               String?
  weight              String?
  category            String?
  notes               String?
  status              String?  @default("Pending")
  productionBatch     String?
  /// Immutable order-row shipment sample requirements. New rows write an
  /// explicit family array; null/empty legacy rows remain unknown and fail closed.
  requiredSampleFamilies Json?
  shippingDate        String?
  shippingMethod      String?
  invoiceNumber       String?
  invoiceDate         String?
  shipmentQuantity    Float?
  shipmentAmount      Decimal? @db.Decimal(18, 4)
  actualPaymentDate   String?
  actualPaymentAmount Decimal? @db.Decimal(18, 4)
  specialInstructions String?
  fieldSources        Json?

  // ============ MOQ 行级 override（P0-6，取数优先级第1级，高于产品档案/系统配置）============
  /// 用户手工填写的行级 MOQ 覆盖值（需审批人备注 + scope: moq:line_override）
  /// 设计真源：MOQ最小起订量.md §2.1 优先级#1
  moqOverride Int?

  // ============ REQ2-03 溢短装条款（数量公差）============
  /// 溢短装容差百分比（对称条款 ±N%）：发货/开票数量允许偏离合同量的上限；0 = 不允许溢短装。
  /// ★ 2026-09-29 更正：原注释写「默认 5（**行业惯例** ±5%）」—— ★ 那是**系统自造的业务事实**。
  ///   5 只是本列的 @default 值；真实合同里容差是**逐客户 / 逐数量档**约定的。
  /// ★ 取数优先级（2026-09-29 起）：本列**只作为行级 override**；无 override 时由
  ///   toleranceStandardService 按「客户标准(P0) → 我方标准(辅助) → 未判定」取数。
  /// 设计真源：需求池 REQ2-03 · toleranceService 校验单一真源 ·
  ///   docs/inventory/公差标准机制-设计-2026-09-29.md
  tolerancePercent Decimal @default(5) @db.Decimal(5, 2)
  /// ★ 2026-09-29：本行 tolerancePercent 的**来源**。
  ///   · 只有 `'line_override'`（人明确改过）才进取数第 ① 层；
  ///   · `NULL` = **不是人定的**（系统默认填的）⇒ 不进 override 层，交给标准链取数。
  ///   ★ 存量 106 行留 NULL、一行都不翻（NULL 天然就是「不是人定的」）⇒ 零数据迁移。
  ///   ★ 白名单式判定：**不做「非空即覆盖」**（那会把 106 行全变成覆盖值 ⇒ 新机制永不生效）。
  toleranceSource  String?

  // ============ DR-005 内部交易结算价（P0-6 补充）============
  /// isInternalFabricTrade=true 时启用，替代 unitPrice 做内部核算；内部订单利润表以此为准
  internalTransferPrice Decimal? @db.Decimal(18, 4)

  // Garment-specific extension fields
  sizeBreakdown       Json? // { S: 100, M: 200, L: 200, XL: 100, XXL: 50 }
  productionSteps     Json? // [ { step: "cutting", status: "done", date: "..." }, ... ]
  styleNo             String? // 款式号 → links to ProductAsset/GarmentProfile
  colorName           String? // 色号名称
  bomItems            Json? // [ { type: "fabric", name: "...", qty: 1.5, unit: "meter" }, ... ]
  garmentSampleStages Json? // [ { stage: "proto", status: "confirmed", sentDate: "...", confirmedDate: "...", comments: "..." }, ... ]
  fulfillmentMode String? // cmt | trims_cmt | full_package; legacy NULL = unknown
  cmtIncludedItems Json? // Explicit included items; [] explicitly means none.
  /// Fabric-only commercial responsibility. Legacy NULL remains unknown.
  fabricSupplyMode String? // finished_purchase | raw_material_processing | commission
  fabricCommissionRate Decimal? @db.Decimal(8,4) // Explicit percentage, not a fractional factor.
  fabricCommissionSupplierId String? // Actual supplier owing us commission; snapshot FK.
  /// Contract/LC split-shipment rule entered by the business; null preserves unknown legacy terms.
  partialShipmentAllowed Boolean?

  // ============ DR-053 阶段 1：订单行版本引用（确认成果 → 订单）============
  // 版本载体 = 确认记录本身（SealSample.sealCode / Sample.code 即版本标识）。
  // 单一来源语义（三选一互斥）：SealSample(封样) | Sample(统一样品) | Asset(直接返单·无确认记录)。
  // specSnapshot 为不可变规格快照——档案后续修改不影响历史订单依据。
  confirmedSourceType String? // 'SealSample' | 'Sample' | 'Asset'
  confirmedSourceId   String? // 对应类型 ID
  confirmedAt         BigInt? // 选择该确认版本的时间
  confirmedBy         String? // 确认人
  specSnapshot        Json? // 不可变规格快照（面料/成衣同构：composition/weight/width/styleNo/...）

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fabricAllocationsOut FabricLineAllocation[] @relation("FabricSupplyAllocation")
  fabricAllocationIn FabricLineAllocation? @relation("GarmentFabricAllocation")

  @@unique([orderId, itemNo])
  @@index([orderId])
  @@index([status])
  @@index([confirmedSourceType, confirmedSourceId])
}

/// Planned internal metres only: no stock, delivery or monetary fact is created.
model FabricLineAllocation {
  id String @id
  fabricOrderId String
  fabricOrderLineId String
  garmentOrderId String
  garmentOrderLineId String @unique
  metres Decimal @db.Decimal(18,4)
  status String // active | cancelled
  revision Int @default(1)
  lastRequestKey String
  lastRequestFingerprint String
  auditId String
  createdBy String
  updatedBy String
  createdAt BigInt
  updatedAt BigInt
  fabricLine OrderLine @relation("FabricSupplyAllocation",fields:[fabricOrderLineId],references:[id],onDelete:Restrict)
  garmentLine OrderLine @relation("GarmentFabricAllocation",fields:[garmentOrderLineId],references:[id],onDelete:Restrict)
  @@index([fabricOrderLineId,status])
  @@index([fabricOrderId,status])
  @@index([garmentOrderId,status])
}

model OrderStatusTransition {
  id         String  @id
  orderId    String
  fromStatus String
  toStatus   String
  note       String?
  operator   String?
  lineId     String?
  createdAt  BigInt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([toStatus])
  @@index([createdAt])
}

model Relation {
  orderSampleSources OrderSampleSource[] @relation("OrderSampleFactory")
  id              String   @id
  /// 创建时间（A1 补列，2026-09-25）：理由与哨兵说明同 OrderLine.createdAt。
  createdAt       DateTime @default(now())
  code            String?  @unique // 业务编码：客户编码 CUS-0001 / 供应商编码 SUP-0001 等（由 SequenceRegister 分配）
  name            String
  category        String
  type            String
  isOrganization  Boolean
  parentId        String?
  reportsToId     String?
  role            String?
  department      String?
  tags            String[]
  contactInfo     String
  rating          Float    @default(0)
  lastInteraction BigInt
  preferences     String?
  deletedAt       BigInt?

  // Organization fields mirrored by the Relations UI.
  chineseName         String?
  englishName         String?
  creditLevel         String?
  summary             String?
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  backupContacts      Json?
  shipToAddresses     Json?
  financialNotes      String?
  website             String?
  paymentTerms        String?
  paymentPreference   String?
  currency            String?
  taxId               String?
  creditLimit         Decimal? @db.Decimal(18, 4)
  officialAddress     String?
  factoryAddresses    String[]
  warehouseAddress    String?
  billingAddress      String?
  shippingAddress     String?
  coordinatesLat      Float?
  coordinatesLng      Float?

  // Contact fields mirrored by the Relations UI.
  email         String?
  phone         String?
  mobile        String?
  wechat        String?
  whatsapp      String?
  otherContacts Json?
  birthday      String?
  language      String?
  timezone      String?
  personalNote  String?

  // ─── 联系人统一（Relation 人物轨为唯一真源）：自 Contact 实体并入的 CRM 语义 ───
  // 仅 isOrganization=false 的人物记录消费；组织记录恒为 false/null
  /// 主联系人标记（同组织下唯一，独占切换）
  isPrimary       Boolean @default(false)
  /// 决策人标记（采购决策链）
  isDecisionMaker Boolean @default(false)
  /// 联系人状态：Active | Inactive | Left（null=未设置）
  contactStatus   String?

  // ─── Phase 1-01 客户/市场域升级：接入平台域（权限/编号/字典） ───
  /// 客户阶段（Lead/Opportunity/Quotation/TrialOrder/Customer/Key/Churned）—— 对应 DataDictionary.relation_stage
  stage        String?  @default("Customer")
  /// 客户等级（S/A/B/C/D/Z）—— 对应 DataDictionary.relation_tier
  tier         String?
  /// 归属人 userId（行级权限 dataScope 用：Sales 仅看自己的客户）
  ownerId      String?
  /// 归属部门 departmentId（行级权限 dataScope 用：同部门互相可见，跨部门隔离）
  departmentId String?
  /// 关联销售用户 IDs（多人对同一客户负责时用）
  salesRepIds  String[] @default([])
  /// v2.2（DR-042 §4.4 L1 档案层敏感标记）：normal=图书馆全公司可查；confidential=仅本人维+管理角色可见，禁止组共享
  sensitivity  String   @default("normal")

  // ─── C1 CRM 深化：反向关联 ───
  fabricUseAuthorizationRequestsAsOwner FabricUseAuthorizationRequest[] @relation("FabricUseAuthorizationRequestOwner")
  fabricUseAuthorizationRequestsAsGrantee FabricUseAuthorizationRequest[] @relation("FabricUseAuthorizationRequestGrantee")
  fabricUseAuthorizationVersionsAsOwner FabricUseAuthorizationVersion[] @relation("FabricUseAuthorizationVersionOwner")
  fabricUseAuthorizationVersionsAsGrantee FabricUseAuthorizationVersion[] @relation("FabricUseAuthorizationVersionGrantee")
  fabricUseAuthorizationUsesAsOwner FabricUseAuthorizationUse[] @relation("FabricUseAuthorizationUseOwner")
  fabricUseAuthorizationUsesAsGrantee FabricUseAuthorizationUse[] @relation("FabricUseAuthorizationUseGrantee")
  contacts        Contact[]
  creditLimits    CreditLimit[]
  followUpRecords FollowUpRecord[]
  opportunities   Opportunity[]
  customerTiers   CustomerTier[]
  factoryProfile  FactoryProfile?
  cashRefundPayees CreditNoteRefund[]
  cashRefundReturns CreditNoteRefundReturn[]

  // ============ P1-14：客户协议 MOQ（MOQ取数优先级第 3 级）============
  /// 高于系统配置 & Tier 折扣，低于工厂合同 & 产品档案 & 行级 override
  /// JSONB：{ fabricDefaultMoq?: number, garmentDefaultMoq?: number, capsuleMoq?: number, agreementDate?: string, agreementRef?: string }
  /// 设计真源：MOQ最小起订量.md §2.2 取数优先级 §3 协议级
  customerAgreementMoq Json?

  // ============ 2026-09-29：客户协议公差标准（公差取数第 ② 层，★ P0）============
  /// ★ 客户标准 = **P0 硬约束**（使用方 R6.1）；我方标准 = 辅助（R6.2）。
  /// JSONB 形状（分档表）：
  ///   {
  ///     qtyTolerance?:   [{ minQty: number, maxQty: number|null, pct: number }],  // 数量公差，按数量分档
  ///     widthDeduction?: [{ minWidth: number, maxWidth: number|null, pct: number }], // 幅宽扣款比例，按幅宽分档
  ///     agreementDate?:  string,   // 约定日期
  ///     agreementRef?:   string    // 依据（哪份 PO / 合同）
  ///   }
  /// ★ 与 customerAgreementMoq **同形状**（照抄 MOQ 先例，★ 不新增表 —— 使用方 2026-09-29 拍板选 A）。
  /// ★ 取不到分档 ⇒ 报「未判定」，**不静默回退 5%**（理由见设计稿 §五 D2/D4）。
  /// 设计真源：docs/inventory/公差标准机制-设计-2026-09-29.md
  customerAgreementTolerance Json?

  @@index([category])
  @@index([isOrganization])
  @@index([parentId])
  @@index([stage])
  @@index([tier])
  @@index([ownerId])
  @@index([departmentId])
  @@index([lastInteraction])
}

// ════════════════════════════════════════════════════════════════
// C1 CRM 深化模型（Phase 3）
// 设计目标：将扁平的 Relation 档案升级为结构化 CRM 能力
//   - Contact：多联系人管理（替代 backupContacts JSON blob）
//   - CreditLimit：信用额度与用量跟踪（替代 creditLevel 扁平字段）
//   - FollowUpRecord：销售跟进记录与下次跟进提醒
//   - Opportunity：销售商机管线（Prospecting→ClosedWon/Lost）
//   - CustomerTier：客户分层与权益（Bronze/Silver/Gold/Platinum）
// ════════════════════════════════════════════════════════════════

model Contact {
  id         String @id // 格式：CTC_${shortId}
  relationId String // 关联 Relation

  // ─── 联系人基本信息 ───
  name       String // 姓名
  title      String? // 职位（如：采购经理 / 业务总监）
  department String? // 部门

  // ─── 联系方式 ───
  email    String?
  phone    String?
  mobile   String?
  wechat   String?
  whatsapp String?

  // ─── 角色标记 ───
  isPrimary       Boolean @default(false) // 是否主联系人
  isDecisionMaker Boolean @default(false) // 是否决策人

  // ─── 客情维护 ───
  birthday     String? // 生日（用于客情维护）
  personalNote String? // 个人备注（兴趣爱好等）
  tags         String[] // 标签

  status String @default("Active") // Active | Inactive | Left（离职）

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  relation Relation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  // 联系人统一：FollowUpRecord.contactId 不再关联本表（已改裸引用指向 Relation 人物）

  @@index([relationId])
  @@index([isPrimary])
  @@index([status])
}

model CreditLimit {
  id         String @id // 格式：CL_${shortId}
  relationId String // 关联 Relation

  // ─── 信用额度 ───
  totalLimit Decimal @db.Decimal(18, 4) // 总信用额度
  usedAmount Decimal @default(0) @db.Decimal(18, 4) // 已用额度（由订单/发票未收款累计）
  currency   String  @default("CNY")

  // ─── 有效期 ───
  validFrom String // 生效日期 YYYY-MM-DD
  validTo   String? // 失效日期（null = 长期有效）

  // ─── 状态 ───
  status String @default("Active") // Active | Frozen | Expired | Revoked

  // ============ P1-2：60天逾期冻结/解冻审计（15缺口 #8）============
  /// 设计真源：信用控制规则.md §4.1 / §4.2
  frozenAt         DateTime? // 冻结时间（crmService.runCreditRiskScan 60天逾期自动写入；或手动审批冻结）
  frozenBy         String? // 冻结触发者（'system_credit_scan' 或手动操作人 userId）
  thawedReason     String? // 解冻理由（审批通过手动解冻 或 逾期款全额核销后自动解冻）
  lastAutoScanDate DateTime? // 最近一次信用巡检时间（每日 10:00 更新）

  // ─── 审批 ───
  approvedBy String? // 审批人
  approvedAt BigInt? // 审批时间

  notes String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  relation Relation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@index([relationId])
  @@index([status])
}

model FollowUpRecord {
  id         String  @id // 格式：FU_${shortId}
  relationId String // 关联 Relation
  contactId  String? // 关联 Contact（可选）

  // ─── 跟进信息 ───
  type       String // Visit | Call | Email | WeChat | Meeting | Other
  content    String // 跟进内容
  followUpAt String // 跟进日期 YYYY-MM-DD

  // ─── 下次跟进 ───
  nextFollowUpAt    String? // 下次跟进日期
  nextFollowUpTopic String? // 下次跟进主题

  // ─── 关联业务 ───
  opportunityId String? // 关联商机
  orderId       String? // 关联订单

  // ─── 销售代表 ───
  salesRepId   String? // 销售代表
  salesRepName String? // 销售代表姓名（冗余）

  // ─── 附件/备注 ───
  attachments Json?
  notes       String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  relation Relation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  // 联系人统一：contactId 指向 Relation 人物记录（裸引用，不加 DB 外键——
  // 与 CommunicationLog/CommissionRule 的 snapshot FK 同口径；历史数据可能是旧 Contact id）
  // contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([relationId])
  @@index([contactId])
  @@index([followUpAt])
  @@index([nextFollowUpAt])
}

model Opportunity {
  id         String @id // 格式：OPP_${shortId}
  relationId String // 关联 Relation

  // ─── 商机信息 ───
  title       String // 商机标题
  description String? // 商机描述

  // ─── 金额 ───
  amount   Decimal @db.Decimal(18, 4) // 预计金额
  currency String  @default("CNY")

  // ─── 阶段（销售管线）───
  stage       String @default("Prospecting") // Prospecting | Qualification | Proposal | Negotiation | ClosedWon | ClosedLost
  probability Int    @default(10) // 成交概率 0-100

  // ─── 日期 ───
  expectedCloseDate String? // 预计成交日期 YYYY-MM-DD

  // ─── 关联 ───
  source  String? // 商机来源（展会 / 转介绍 / 主动开发 / 复购）
  orderId String? // 关联订单（成交后）

  // ─── 归属 ───
  salesRepId   String? // 销售代表
  salesRepName String? // 销售代表姓名（冗余）

  // ─── 备注 ───
  tags  String[]
  notes String?

  // ─── 时间 ───
  closedAt BigInt? // 成交/流失时间

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  relation Relation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@index([relationId])
  @@index([stage])
  @@index([expectedCloseDate])
  @@index([salesRepId])
}

model CustomerTier {
  id         String @id // 格式：TIER_${shortId}
  relationId String // 关联 Relation

  // ─── 分层 ───
  level    String // Bronze | Silver | Gold | Platinum | VIP
  criteria String? // 评定依据（如：年采购额 > 100万）

  // ─── 权益 ───
  discountRate     Decimal? @db.Decimal(5, 2) // 折扣率（5.00 = 5%）
  paymentTermsDays Int? // 账期天数
  creditPriority   String   @default("Normal") // 信用优先级：High | Normal | Low

  // ============ P1-6：MOQ 折扣权益（MOQ取数优先级第 2 级）============
  /// 设计真源：MOQ最小起订量.md §2.2 优先级#2 / §15 CAP-3 场景
  /// 例：0.70 = 7折（Platinum Tier 面料 800m → 560m）；null = 不享受 MOQ 折扣，按标准阈值执行
  moqOverrideRatio Decimal? @db.Decimal(5, 2)

  // ─── 评定 ───
  evaluatedAt String // 评定日期 YYYY-MM-DD
  validUntil  String? // 有效期至（null = 长期有效）
  evaluatedBy String? // 评定人

  notes String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  relation Relation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@index([relationId])
  @@index([level])
}

model ProductAsset {
  fabricSearchResults FabricSearchResult[]
  id            String  @id
  sku           String  @unique
  name          String
  mainCategory  String
  subCategoryId String
  season        String
  techPackUrl   String?
  imageUrl      String?
  cost          Decimal? @db.Decimal(18, 4) // Unknown cost stays null; development target prices are not actual costs.
  status        String
  updatedAt     BigInt
  deletedAt     BigInt?

  // DR-054 阶段 D：产品来源（重要溯源信息）
  // 开发转档自动带入开发案来源；手动建档自选（sourcing 季/客户来样/指定采购订单/自主开发/其他）。
  source       String  @default("manual") // manual | development | supplier_recommend | customer_sample | sourcing | specified_purchase | other
  sourceDetail String? // 详情：开发案号/名称、sourcing 季/时间、来样客户、指定采购订单号…

  // ── ★ 结构化来源（2026-10-05）──────────────────────────────────────────
  // 起因： Kevin 指出「不是只有确认的那个版本有用，之前那个版本我觉得也挺好，
  //   也能转成产品档案推给别的客户」⇒ **一个案子可产出 N 个档案**。
  //   而此前 sourceDetail 只是自由文本 ⇒ 同案转两版时档案分不出谁是谁。
  // 处置：补外键，sourceDetail 降级为补充说明，不再承担溯源职责。
  sourceDevelopmentCaseId String? // 来源开发案
  sourceSampleBatchId     String? // 来源版本（SampleBatch.id）——精确到 R1-A 还是 R4-A-1
  sourceSampleVersionId   String? // 来源设计版本节点；同一面料版本可关联多个形态批次
  // 冗余可读标签，便于列表直接展示而不必回查（例：R4-A-1）
  sourceVersionLabel      String?
  // 转档当时的规格快照哈希/内容，防止档案与来源版本被后续改动脱钩
  sourceSpecSnapshot      Json?

  fabricProfile        FabricProfile?
  garmentProfile       GarmentProfile?
  trimmingProfile      TrimmingProfile?
  classificationLinks  ProductClassificationLink[]
  fabricCustomerCodes  FabricCustomerCode[]
  fabricPrices         FabricPriceHistory[]
  fabricCertifications FabricCertification[]
  compositionLines     FabricCompositionLine[]
  images               ProductImage[]
  fabricUseAuthorizationRequests FabricUseAuthorizationRequest[]
  fabricUseAuthorizationVersions FabricUseAuthorizationVersion[]
  fabricUseAuthorizationUses FabricUseAuthorizationUse[]

  @@index([season])
  @@index([updatedAt])
  @@index([sourceSampleBatchId])
  @@index([sourceSampleVersionId])
  @@index([sourceDevelopmentCaseId])
}

