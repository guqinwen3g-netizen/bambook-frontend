// HR Management Models
// ─────────────────────────────────────────────

/// 岗位/职位（如：跟单员、面料采购员、生产主管）
model JobPosition {
  id           String   @id
  title        String
  departmentId String?
  description  String?
  headcount    Int      @default(1)
  status       String   @default("active")
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    BigInt?

  department Department?       @relation(fields: [departmentId], references: [id])
  employees  EmployeeProfile[]

  @@index([departmentId])
  @@index([status])
}

/// 团队（可跨部门，按项目/职能临时组建）
model Team {
  fabricSearchRequests FabricSearchTask[] @relation("FabricSearchRequestTeam")
  fabricSearchRouting FabricSearchTask[] @relation("FabricSearchRoutingTeam")
  id           String   @id
  name         String
  description  String?
  leaderId     String?
  departmentId String?
  status       String   @default("active")
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    BigInt?

  department Department?     @relation(fields: [departmentId], references: [id])
  members    TeamMember[]
  projects   Project[]
  grants     TeamDataGrant[]

  @@index([departmentId])
  @@index([status])
}

/// 团队成员关联表
model TeamMember {
  id       String    @id
  teamId   String
  userId   String
  role     String    @default("member")
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

/// DR-042 小组数据共享授权：业务实体 × 小组 多对多受控共享。
/// 设计真源：docs/design/03-业务规则/小组与业务数据共享.md
/// 铁律：数据本体组织归属不变（部门链路），本表仅表达「共享视图」；
///       起步仅消费 entityType='relation'（订单/报价/跟进为子实体派生可见，§5.3）。
model TeamDataGrant {
  id           String    @id @default(cuid())
  teamId       String
  entityType   String // 起步仅 'relation'；字段为未来独立共享单据场景保留扩展位
  entityId     String // 被共享实体 id（快照引用，不强 FK——与 Order.customerRelationId 同范式）
  permission   String    @default("read+followup") // 'read'（纯只读）| 'read+followup'（可加跟进记录）
  grantedBy    String // 授权人 UserAccount.id
  grantedAt    DateTime  @default(now())
  revokedAt    DateTime? // 软撤销（null=生效中）；再授权=复活原行，历史保留
  revokedBy    String?
  revokeReason String?

  // 无 onDelete: Cascade（DR-042 §0 修订2）：物理删组被服务层禁止，
  // 解散走事务化软删（先批量 revoke 再软删组），授权历史不丢失
  team Team @relation(fields: [teamId], references: [id])

  @@unique([teamId, entityType, entityId]) // 幂等锚点：同实体对同组仅一行
  @@index([entityType, entityId]) // 反查：这条数据共享给了哪些组
  @@index([teamId, revokedAt]) // 正查：这个组生效中的授权
}

/// 项目（可关联订单/开发案，也可独立）
model Project {
  id          String   @id
  name        String
  code        String?
  description String?
  teamId      String?
  status      String   @default("planning")
  priority    String   @default("normal")
  startDate   String?
  endDate     String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   BigInt?

  team        Team?            @relation(fields: [teamId], references: [id])
  members     ProjectMember[]
  assignments WorkAssignment[]

  @@index([teamId])
  @@index([status])
}

/// 项目成员关联表
model ProjectMember {
  id        String   @id
  projectId String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// 工作分配/任务（将人分配到具体工作项）
model WorkAssignment {
  id          String    @id
  title       String
  description String?
  projectId   String?
  userId      String
  assignerId  String?
  status      String    @default("assigned")
  priority    String    @default("normal")
  dueDate     String?
  completedAt DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   BigInt?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

// ─────────────────────────────────────────────
// C3 HR 深化 Models（员工档案/生命周期/考勤/薪资/绩效/培训）
// ─────────────────────────────────────────────

/// C3a 员工档案扩展（与 UserAccount 1:1，承载 HR 业务字段，UserAccount 保持认证纯净）
model EmployeeProfile {
  id               String   @id
  userId           String   @unique
  employeeNo       String   @unique
  positionId       String?
  hireDate         String // YYYY-MM-DD
  regularDate      String? // 转正日期（试用期待转正提醒依据）
  contractType     String? // FixedTerm / OpenEnded / PartTime / Intern
  contractEnd      String? // 合同到期日（到期提醒依据）
  employmentStatus String   @default("Probation") // Probation/Regular/Suspended/Resigned/Terminated
  phone            String?
  emergencyContact String?
  workLocation     String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        BigInt?

  user     UserAccount  @relation(fields: [userId], references: [id])
  position JobPosition? @relation(fields: [positionId], references: [id])

  @@index([employmentStatus])
  @@index([positionId])
}

/// C3a 员工生命周期事件（入/转/调/升/停/复/离，历史流水 — 故意用松散 id 引用，部门/岗位改名删除不影响历史）
model EmploymentEvent {
  id             String   @id
  userId         String
  type           String // Onboard/Regularize/Transfer/Promote/Suspend/Resume/Resign/Terminate
  effectiveDate  String // YYYY-MM-DD
  fromDeptId     String?
  toDeptId       String?
  fromPositionId String?
  toPositionId   String?
  reason         String?
  operatorId     String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([effectiveDate])
}

/// C3b 考勤打卡记录（每人每日一条）
model AttendanceRecord {
  id        String   @id
  userId    String
  date      String // YYYY-MM-DD
  checkIn   String? // HH:MM
  checkOut  String? // HH:MM
  status    String   @default("Normal") // Normal/Late/EarlyLeave/LateAndEarly/Absent/Leave/Holiday/Overtime
  workHours Float?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([status])
}

/// C3b 请假申请（状态机与退税审核同口径：Pending→Approved/Rejected，可 Cancelled）
model LeaveRequest {
  id           String    @id
  userId       String
  type         String // Annual/Sick/Personal/CompTime/Maternity/Other
  startDate    String
  endDate      String
  days         Float
  reason       String?
  status       String    @default("Pending") // Pending/Approved/Rejected/Cancelled
  approverId   String?
  approvedAt   DateTime?
  rejectReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    BigInt?

  @@index([userId])
  @@index([status])
}

/// C3c 薪资结构（变更留痕：effectiveFrom/To 形成生效区间，当前生效 effectiveTo=null）
model SalaryStructure {
  id                String   @id
  userId            String
  baseSalary        Float
  positionAllowance Float    @default(0)
  currency          String   @default("CNY")
  effectiveFrom     String // YYYY-MM-DD
  effectiveTo       String?
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

/// C3c 月度工资单批次（Draft→Confirmed→Paid）
model PayrollRun {
  id          String    @id
  period      String // YYYY-MM
  status      String    @default("Draft") // Draft/Confirmed/Paid
  totalNet    Float     @default(0)
  headcount   Int       @default(0)
  note        String?
  confirmedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items PayrollItem[]

  @@unique([period])
}

/// C3c 工资单明细行（commission 可引用 P2 佣金结算额，手工录入）
model PayrollItem {
  id          String   @id
  runId       String
  userId      String
  base        Float    @default(0)
  allowance   Float    @default(0)
  overtimePay Float    @default(0)
  commission  Float    @default(0)
  bonus       Float    @default(0)
  deduction   Float    @default(0)
  net         Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  run PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@index([userId])
}

/// C3d 绩效考核周期
model PerformanceCycle {
  id        String   @id
  name      String
  period    String // 如 2026-H1 / 2026-Q3
  status    String   @default("Open") // Open/Closed
  startDate String?
  endDate   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews PerformanceReview[]

  @@unique([period])
}

/// C3d 绩效评定（自评→主管评→终评确认；kpi Json 保持指标弹性）
model PerformanceReview {
  id           String   @id
  cycleId      String
  userId       String
  selfScore    Float?
  managerScore Float?
  finalScore   Float?
  grade        String? // A/B/C/D
  kpi          Json?
  comment      String?
  status       String   @default("Draft") // Draft/Submitted/Confirmed
  reviewerId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cycle PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, userId])
  @@index([userId])
}

/// C3e 培训课程
model TrainingCourse {
  id          String   @id
  title       String
  type        String   @default("Internal") // Internal/External
  instructor  String?
  startDate   String?
  endDate     String?
  capacity    Int?
  status      String   @default("Planned") // Planned/Ongoing/Completed/Cancelled
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   BigInt?

  enrollments TrainingEnrollment[]

  @@index([status])
}

/// C3e 培训报名/成绩记录
model TrainingEnrollment {
  id          String   @id
  courseId    String
  userId      String
  status      String   @default("Enrolled") // Enrolled/Completed/Absent/Cancelled
  score       Float?
  certificate String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

model AgentSession {
  id           String   @id
  userId       String
  departmentId String?
  title        String?
  status       String   @default("active")
  memoryScopes String[]
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    BigInt?

  user       UserAccount    @relation(fields: [userId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  messages   AgentMessage[]

  @@index([userId])
  @@index([departmentId])
  @@index([status])
}

model AgentMessage {
  id        String   @id
  sessionId String
  userId    String
  role      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  deletedAt BigInt?

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    UserAccount  @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
}

model AgentMemory {
  id              String   @id
  userId          String?
  departmentId    String?
  scope           String
  memoryType      String
  content         String
  summary         String?
  confidence      Float    @default(0.7)
  sourceType      String?
  sourceId        String?
  relatedEntity   String?
  relatedEntityId String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       BigInt?

  user       UserAccount? @relation(fields: [userId], references: [id])
  department Department?  @relation(fields: [departmentId], references: [id])

  @@index([scope])
  @@index([memoryType])
  @@index([userId])
  @@index([departmentId])
  @@index([relatedEntity, relatedEntityId])
}

model KnowledgeDocument {
  id         String   @id
  title      String
  sourceType String
  sourceUri  String?
  mimeType   String?
  checksum   String?
  version    Int      @default(1)
  status     String   @default("active")
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  BigInt?

  chunks    KnowledgeChunk[]
  relations KnowledgeRelation[]
  acls      KnowledgeAcl[]

  @@index([sourceType])
  @@index([status])
  @@index([checksum])
}

model KnowledgeChunk {
  id          String   @id
  documentId  String
  chunkIndex  Int
  content     String
  summary     String?
  tags        String[]
  sourceRange Json?
  embedding   Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   BigInt?

  document  KnowledgeDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  relations KnowledgeRelation[]

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model KnowledgeRelation {
  id           String   @id
  documentId   String?
  chunkId      String?
  relationType String
  targetType   String
  targetId     String
  confidence   Float    @default(0.7)
  createdAt    DateTime @default(now())

  document KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk    KnowledgeChunk?    @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chunkId])
  @@index([targetType, targetId])
  @@index([relationType])
}

model EntityReference {
  id         String  @id
  ownerType  String
  ownerId    String
  fieldKey   String
  targetType String
  targetId   String
  targetPath String?
  snapshot   Json?
  confidence Float?
  source     String?
  status     String  @default("active")
  createdAt  BigInt
  updatedAt  BigInt
  deletedAt  BigInt?

  @@unique([ownerType, ownerId, fieldKey, targetType, targetId, targetPath])
  @@index([ownerType, ownerId])
  @@index([fieldKey])
  @@index([targetType, targetId])
  @@index([status])
  @@index([source])
}

model EntityAlias {
  id         String  @id
  targetType String
  targetId   String
  targetPath String?
  alias      String
  normalized String
  source     String?
  confidence Float?
  createdAt  BigInt
  updatedAt  BigInt
  deletedAt  BigInt?

  @@index([targetType, targetId])
  @@index([targetPath])
  @@index([normalized])
  @@index([source])
}

model EntityLink {
  id         String  @id
  fromType   String
  fromId     String
  fromPath   String?
  toType     String
  toId       String
  toPath     String?
  linkKind   String
  confidence Float?
  metadata   Json?
  source     String?
  status     String  @default("active")
  createdAt  BigInt
  updatedAt  BigInt
  deletedAt  BigInt?

  @@index([fromType, fromId])
  @@index([toType, toId])
  @@index([linkKind])
  @@index([status])
  @@index([source])
}

model KnowledgeAcl {
  id           String  @id
  documentId   String
  roleId       String?
  departmentId String?
  scope        String
  access       String  @default("read")

  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role       Role?             @relation(fields: [roleId], references: [id])
  department Department?       @relation(fields: [departmentId], references: [id])

  @@index([documentId])
  @@index([roleId])
  @@index([departmentId])
  @@index([scope])
}

// C7 知识库深化：SOP 标准作业程序模板（可实例化为知识文档入库检索）
model SopTemplate {
  id        String  @id
  title     String
  category  String
  summary   String?
  content   String
  steps     Json?
  version   Int     @default(1)
  status    String  @default("active") // active | archived
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([category])
