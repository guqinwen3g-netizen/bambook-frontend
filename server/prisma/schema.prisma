model ApprovalRequest {
  id          String @id
  requesterId String

  // P0-8：NOTICE — 当前 reviewerId 保持 String?（三步法 Step1 阶段）；待 SQL 回填旧行 + 服务端兜底部署稳定后，执行 Step3 改为 String（NOT NULL）
  /// DR-007：服务端 resolveReviewerByDepartment(requesterId) 解析，前端不得传入
  reviewerId   String?
  actionType   String
  targetType   String
  targetId     String?
  status       String    @default("pending")
  risk         String    @default("high")
  payload      Json
  /// 仅 order:main_approval 使用：提交时冻结的并行审批候选人账号快照。
  eligibleReviewerIds Json @default("[]")
  decisionNote String?
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?

  // ============ P0-11：reviewerResolverRoute（DR-007 解析路径真源，createOnce 写入）============
  /// DEPT_HEAD | FALLBACK_DEPT_HEAD_VACANT | FALLBACK_SELF_APPLY_SUPERVISOR | BOSS_FINAL_BYPASS | DEPT_HEAD_LEGACY_FALLBACK
  /// 三步法 Step1 暂用 String?；回填完成后 Step3 改 NOT NULL（见迁移 SQL）
  /// 设计真源：底座域模型组.md §39 / 审批与human-in-the-loop.md §14
  reviewerResolverRoute String?

  // ============ P0-12：审批人主动转派（BASE-39-B2）3 字段 ============
  delegatedBy    String? // 原审批人 userId（只有 reviewerId=本人可写）
  delegatedAt    DateTime? // 委托时间
  delegateReason String? // 委托理由（建议≥10字）

  // ============ P0-13：前端越权传入守卫审计（DEV-11-B4/DR7-A2）============
  /// true=前端 body 中带 reviewerId（被忽略或拒绝）；用于发现前端注入越权企图
  clientReviewerIdSupplied Boolean @default(false)

  // ============ P0-14：BOSS 最终兜底特批（BASE-39-B3）============
  /// 绝密级仅 BOSS 容器可写；bossFinalBypassReason 服务端 Zod 校验 ≥30字（fail-closed）
  /// 设计真源：底座域模型组.md BASE-39-B3
  bossFinalBypassBy     String? // BOSS userId
  bossFinalBypassAt     DateTime? // 兜底时间
  bossFinalBypassReason String?   @db.Text // 兜底理由（≥30字强制）

  // ============ P0-15：DR-013 例外绑定被拒审批（BASE-39-C2）============
  /// 关联 ApprovalRequest.id（被 DR-013 例外绕过的原 Rejected 审批单；正反链闭环审计）
  /// 设计真源：底座域模型组.md §39.3 / DR-013 受控例外链
  bypassedApprovalId String?

  // ============ P0-16：部门归属快照（BASE-39-A2）============
  /// 申请人 requesterId→UserAccount.departmentId 在创建审批时的快照；调动部门不追溯未决审批 reviewerId
  /// 三步法 Step1 暂用 String?；回填完成 Step3 改 NOT NULL；兜底值 DEPT_UNKNOWN_LEGACY
  departmentSnapshotId String?

  requester UserAccount  @relation("ApprovalRequester", fields: [requesterId], references: [id])
  reviewer  UserAccount? @relation("ApprovalReviewer", fields: [reviewerId], references: [id])
  claimCreditNoteLines ClaimCreditNoteLine[]

  @@index([requesterId])
  @@index([reviewerId])
  @@index([status])
  @@index([actionType])
  @@index([reviewerResolverRoute])
  @@index([departmentSnapshotId])
  @@index([bypassedApprovalId])
}

