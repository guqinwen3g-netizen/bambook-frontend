  receiptVoucherId String @unique
  returnedPrincipal Decimal @db.Decimal(18,4)
  receivedNet Decimal @db.Decimal(18,4)
  bankFee Decimal @db.Decimal(18,4)
  feeBearer String?
  currency String
  actualDate String
  actualMethod String
  bankReference String
  actorId String
  requestId String
  parameters Json
  parametersHash String
  auditId String @unique
  createdAt BigInt

  creditNote CreditNote @relation(fields:[creditNoteId], references:[id], onDelete:Restrict)
  refund CreditNoteRefund @relation(fields:[refundId], references:[id], onDelete:Restrict)
  customer Relation @relation(fields:[customerRelationId], references:[id], onDelete:Restrict)
  sourceSettlementEvent CreditNoteSettlementEvent @relation("CashRefundReturnSource",fields:[sourceSettlementEventId],references:[id],onDelete:Restrict)
  sourcePaymentVoucher PaymentVoucher @relation("CashRefundReturnSourceVoucher",fields:[sourcePaymentVoucherId],references:[id],onDelete:Restrict)
  currentVersion CreditNoteDocumentVersion @relation(fields:[currentVersionId],references:[id],onDelete:Restrict)
  receiptVoucher PaymentVoucher @relation("CashRefundReturnReceiptVoucher",fields:[receiptVoucherId],references:[id],onDelete:Restrict)
  actor UserAccount @relation("CashRefundReturnActor",fields:[actorId],references:[id],onDelete:Restrict)
  audit AuditLog @relation("CashRefundReturnAudit",fields:[auditId],references:[id],onDelete:Restrict)
  settlement CreditNoteSettlementEvent? @relation("CashRefundReturnSettlement")
  evidence CreditNoteRefundReturnEvidence[]
  @@unique([creditNoteId,requestId])
  @@unique([refundId,actualDate,bankReference])
  @@unique([customerRelationId,currency,actualDate,actualMethod,bankReference])
  @@index([creditNoteId,createdAt])
  @@index([refundId])
}

model CreditNoteRefundReturnEvidence {
  id String @id
  returnId String
  evidenceId String
  cashReturn CreditNoteRefundReturn @relation(fields:[returnId],references:[id],onDelete:Restrict)
  evidence CreditNoteRefundEvidence @relation(fields:[evidenceId],references:[id],onDelete:Restrict)
  @@unique([returnId,evidenceId])
  @@index([evidenceId])
}

/// Explicit immutable command tombstone. It prevents a late command from committing.
/// It is not a business cancellation or inventory fact.
model OrderSampleCommandCancellation {
  id String @id
  protocolVersion Int
  actorId String
  requestKey String
  operation String
  orderId String
  sourceId String?
  commandHash String
  requestInput Json
  receipt Json
  receiptHash String
  auditId String @unique
  createdAt BigInt
  actor UserAccount @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  source OrderSampleSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  audit AuditLog @relation(fields: [auditId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([actorId, requestKey])
  @@index([orderId, createdAt])
}


/// Isolated Mist product workspace. State changes only through typed commands.
model MistWorkspace {
  id String @id @default(uuid()) @db.Uuid
  ownerId String
  slug String
  name String
  revision Int @default(0)
  state Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receipts MistCommandReceipt[]
  @@unique([ownerId, slug])
  @@index([ownerId, updatedAt])
}

/// Durable idempotency result, committed with the corresponding workspace state.
model MistCommandReceipt {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  requestId String
  actorId String
  inputHash String
  expectedRevision Int
  result Json
  createdAt DateTime @default(now())
  workspace MistWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  @@unique([workspaceId, requestId])
  @@index([actorId, createdAt])
}
