/// 退货入库单（货这条腿）—— 退回来的货入哪个仓、**去向必记**
model ReturnReceipt {
  id            String @id // 格式：RETREC_${shortId}
  receiptNumber String @unique // 业务单号（RT-YYYY-NNNN，nextBusinessNumber 生成）
  claimCaseId   String // snapshot FK → ClaimCase.id
  warehouseId   String // 入哪个仓（snapshot FK → Warehouse.id）

  /// ★ **去向必填**：Scrap(报废) | Replace(换货补发) | Repair(返修)
  /// 不记清 ⇒ 货在账上凭空消失（口径 A1-附 ③）
  disposition String
  status      String @default("Draft") // Draft | Received | Dispositioned | Cancelled

  /// 入库流水锚点（走 inventoryService 的 Inbound 流水，**不自己写库存**）
  stockMovementId String?
  receivedAt      String? // 实际收货日 YYYY-MM-DD
  notes           String?
  createdAt       BigInt
  updatedAt       BigInt
  deletedAt       BigInt?

  lines ReturnReceiptLine[]

  @@index([claimCaseId])
  @@index([disposition])
  @@index([status])
}

/// 返修工单（A-3 二期 · 口径 A1）
///
/// ── 为什么**独立成表**而不复用 `ProductionPlan`（按行业标准）──────
/// 行业做法一致：**Odoo 有独立的 `repair.order`**（不是生产订单）· **SAP 用独立的 Rework Order
/// 订单类型**。三条理由：
///   ① 返修**没有 BOM 展开** —— 不是"做新货"，套生产订单会带出错误的物料需求
///   ② 返修成本必须**单独归集**（**质量成本 ≠ 生产成本**）——
///      混进 `ProductionPlan` 会污染产能/成本统计，而这正是服装厂的核心 KPI
///   ③ 生命周期不同：**收件 → 修 → 发回**，与"排产 → 开工 → 完工"不同构
/// ⇒ 独立表，但**复用 `WorkStation`（工位）** —— 与 Odoo「独立 repair.order + 共用 workcenter」同构。
model RepairWorkOrder {
  id              String @id // 格式：RW_${shortId}
  workOrderNumber String @unique // 工单号（RW-YYYY-NNNN，nextBusinessNumber 生成）

  /// 来源客诉案件（snapshot FK → ClaimCase.id）
  claimCaseId   String
  /// 来源处置（snapshot FK → ClaimDisposition.id）
  dispositionId String?

  // ─── 关联（可空：返修品可能已无原始单据）───
  sourceShipmentId       String? // 原出运单（snapshot FK → Shipment.id）
  sourceProductionPlanId String? // 原排产单（snapshot FK → ProductionPlan.id）—— 追溯"哪批做的"

  // ─── 实物 ───
  materialCode String? // 返修品物料编码
  quantity     Decimal @db.Decimal(18, 4)
  unit         String?

  // ─── 工位（★ 复用 WorkStation，不另造）───
  workStationId String // snapshot FK → WorkStation.id

  /// Draft(已开单) | InRepair(返修中) | Completed(已修完) | Shipped(已发回) | Cancelled
  status String @default("Draft")

  /// 返修原因/要求（从客诉处置带入，车间照着做）
  repairReason      String?
  /// 修完是否需重新质检
  needsReinspection Boolean @default(false)

  startedAt    String? // 开工日 YYYY-MM-DD
  completedAt  String? // 完工日 YYYY-MM-DD
  /// 修好后发回的出运单（回填）
  reshipmentId String?

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  inspections RepairInspection[]

  @@index([claimCaseId])
  @@index([workStationId])
  @@index([status])
}

/// Each approved goods disposition remains individually traceable within its return document.
model ReturnReceiptLine {
