<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bambook.ops-panel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>CHANGE_ME_HOME/bambook-main-api/scripts/run-ops-panel.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/bambook-ops-panel.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/bambook-ops-panel.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>BAMBOOK_OPS_PORT</key>
    <string>8088</string>
  </dict>
</dict>
</plist>
