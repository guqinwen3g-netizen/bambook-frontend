<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bambook.ops-panel-auto</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>CHANGE_ME_HOME/bambook-main-api/scripts/ops/ops-auto-deploy-panel.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/tmp/bambook-ops-panel-auto.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/bambook-ops-panel-auto.launchd.log</string>
</dict>
</plist>
