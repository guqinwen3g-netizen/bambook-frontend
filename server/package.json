{
  "name": "panda-sovereign-server",
  "version": "1.0.0",
  "description": "The Neuro-Core Backend for PandaAI",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:mist": "MIST_LOCAL_WORKSPACE=1 node scripts/mist-dev.mjs",
    "build": "tsc",
    "migrate:local-to-postgres": "tsx scripts/migrate-local-sqlite-to-postgres.ts",
    "migrate:local-to-postgres:dry": "tsx scripts/migrate-local-sqlite-to-postgres.ts --dry-run",
    "migrate:local-to-postgres:verify": "tsx scripts/migrate-local-sqlite-to-postgres.ts --verify-only",
    "migrate:wallpapers:system-assets": "tsx scripts/migrate-wallpapers-to-system-assets.ts",
    "migrate:wallpapers:system-assets:dry": "tsx scripts/migrate-wallpapers-to-system-assets.ts --dry-run",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "db:use": "bash scripts/db-use.sh",
    "db:status": "bash scripts/db-use.sh",
    "db:empty": "bash scripts/db-use.sh empty",
    "db:mature": "bash scripts/db-use.sh mature",
    "db:local": "bash scripts/db-use.sh local",
    "dev:empty": "bash scripts/db-use.sh empty && lsof -tiTCP:8081 -sTCP:LISTEN -nP | xargs kill -9 2>/dev/null; sleep 1; npm run dev",
    "dev:mature": "bash scripts/db-use.sh mature && lsof -tiTCP:8081 -sTCP:LISTEN -nP | xargs kill -9 2>/dev/null; sleep 1; npm run dev",
    "dev:local": "bash scripts/db-use.sh local && lsof -tiTCP:8081 -sTCP:LISTEN -nP | xargs kill -9 2>/dev/null; sleep 1; npm run dev",
    "seed:base": "tsx scripts/seed-rbac.ts && tsx scripts/seed-datadict.ts && tsx scripts/seed-systemconfig.ts && tsx scripts/seed-sequence.ts && tsx scripts/seed-permission-scopes.ts && tsx scripts/seed-moq-thresholds.ts",
    "seed:dev-roles": "tsx scripts/seed-dev-role-play.ts",
    "seed:company": "tsx scripts/seed-company-sim.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mist": "vitest run src/mist src/shared/mist*.test.ts",
    "test:access": "vitest run src/auth src/admin src/hr",
    "typecheck:mist": "tsc -p tsconfig.mist.json"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^9.4.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "imap-simple": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.1",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.12",
    "pdf-parse": "^2.4.5",
    "pinyin-pro": "^3.29.5",
    "resend": "^6.12.3",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/imap-simple": "^4.2.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^7.0.5",
    "@types/supertest": "^6.0.2",
    "playwright": "^1.60.0",
    "prisma": "^5.10.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.0"
  }
}
